from nwn1.rules import { AppearanceDefinition, AppearanceRules };
from core.creature import { AppearanceInfo, publish_appearance_info };

import core.array as Array;
import core.creature as NativeCreature;

var _loaded = false;
var _rules: array!(AppearanceRules);
var _valid: array!(bool);

fn init(): bool {
    if (_loaded) { return true; }

    var definitions = load_config!(AppearanceDefinition)("nwn1.data.appearance");
    var infos: array!(AppearanceInfo) = {};
    var rules: array!(AppearanceRules) = {};
    var valid: array!(bool) = {};
    for (var index = 0; index < Array.len(definitions); index += 1) {
        var definition = Array.get(definitions, index);
        if (definition.id == index && definition.info.id == index) {
            Array.push(infos, definition.info);
            Array.push(rules, definition.rules);
            Array.push(valid, true);
        } else {
            var invalid_info: AppearanceInfo;
            invalid_info.id = -1;
            var invalid_rules: AppearanceRules;
            Array.push(infos, invalid_info);
            Array.push(rules, invalid_rules);
            Array.push(valid, false);
        }
    }
    if (!publish_appearance_info(infos)) { return false; }

    _rules = rules;
    _valid = valid;
    _loaded = true;
    return true;
}

fn count(): int {
    init();
    return Array.len(_valid);
}

fn get_rules(appearance: int): AppearanceRules {
    if (exists(appearance)) {
        return Array.get(_rules, appearance);
    }
    var invalid: AppearanceRules;
    return invalid;
}

fn get_info(appearance: int): NativeCreature.AppearanceInfo {
    return NativeCreature.appearance_info(appearance);
}

fn exists(appearance: int): bool {
    init();
    return appearance >= 0
        && appearance < Array.len(_valid)
        && Array.get(_valid, appearance);
}
