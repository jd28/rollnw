fn get_base_moverate(row: int): float {
    if (row == 0) { return 2.0; }
    if (row == 1) { return 0.0; }
    if (row == 2) { return 0.75; }
    if (row == 3) { return 1.25; }
    if (row == 4) { return 1.75; }
    if (row == 5) { return 2.25; }
    if (row == 6) { return 2.75; }
    if (row == 7) { return 0.0; }
    if (row == 8) { return 5.5; }
    return 0.0;
}
