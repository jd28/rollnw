import core.array as arr;
from core.types import { Class };
from nwn1.propsets import { PlayerHistory };

fn history_level_count(obj: Player): int {
    return arr.len(get_propset!(PlayerHistory)(obj).entries);
}

fn history_known_spell_count(obj: Player, level_index: int): int {
    var history = get_propset!(PlayerHistory)(obj);
    if (level_index < 0 || level_index >= arr.len(history.entries)) {
        return 0;
    }
    return arr.len(history.entries[level_index].known_spells);
}

fn count_class_levels(obj: Player, class_id: Class, maximum_levels: int): int {
    if (class_id < 0 || maximum_levels <= 0) {
        return 0;
    }

    var history = get_propset!(PlayerHistory)(obj);
    var stop = arr.len(history.entries);
    if (stop > maximum_levels) {
        stop = maximum_levels;
    }

    var result = 0;
    for (var i = 0; i < stop; i += 1) {
        if (history.entries[i].class_id == class_id) {
            result += 1;
        }
    }
    return result;
}
