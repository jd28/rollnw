import nwn1.creature_state as Cre;
import core.creature as NativeCreature;
import core.math as Math;
import core.object as O;
from nwn1.propsets import { CreatureHealth };
from nwn1.propsets import { DoorState };
from nwn1.propsets import { PlaceableState };

import nwn1.constants as Const;
import nwn1.creature as NCre;
import nwn1.modifier as Mod;

fn get_current_hitpoints(obj: object): int {
    switch (obj) {
        // Preserve legacy behavior: ObjectType::player path was not handled here.
        case Player(_): {
            return 0;
        }
        case Creature(cre): {
            var hp = get_propset!(CreatureHealth)(cre).hp_current;
            var hp_max = get_max_hitpoints(cre);
            if (hp > hp_max) { return hp_max; }
            return hp;
        }
        case Door(door): {
            return get_propset!(DoorState)(door).hp_current;
        }
        case Placeable(placeable): {
            return get_propset!(PlaceableState)(placeable).hp_current;
        }
        default: {
            return 0;
        }
    }
}

fn get_max_hitpoints(obj: object): int {
    switch (obj) {
        case Creature(cre): {
            var health = get_propset!(CreatureHealth)(cre);
            var base = health.hp_base_for_max;
            var con = NCre.get_ability_modifier(cre, Const.ability_constitution);
            var modifiers = Mod.sum_modifiers(cre, Const.mod_type_hitpoints, -1, O.invalid);
            var temp = health.hp_temp;
            var levels = Cre.get_total_levels(cre);
            return Math.max(1, base + con * levels + modifiers + temp);
        }
        case Door(door): {
            return Math.max(1, get_propset!(DoorState)(door).hp);
        }
        case Placeable(placeable): {
            return Math.max(1, get_propset!(PlaceableState)(placeable).hp);
        }
        default: {
            return 1;
        }
    }
}

fn sync_creature_vitals(cre: Creature): bool {
    var health = get_propset!(CreatureHealth)(cre);
    health.hp_max = get_max_hitpoints(cre);
    return NativeCreature.set_vitals(cre, health.hp_current, health.hp_max);
}

fn initialize_creature_health(cre: Creature): bool {
    var health = get_propset!(CreatureHealth)(cre);
    health.hp_max = get_max_hitpoints(cre);
    health.hp_current = health.hp_max;
    return NativeCreature.set_vitals(cre, health.hp_current, health.hp_max);
}

// Applies `amount` points of damage to `obj`, clamping at 0, and returns the
// hit points actually removed. Creature damage goes through the health propset
// and then syncs native vitals, which is what combat_scheduler's is-dead check
// (hp_current <= 0) reads.
//
// Nothing in the attack pipeline wrote hit points before this: resolve_attack()
// produced a damage_total that every caller discarded, so attacks resolved
// without consequence.
fn apply_damage(obj: object, amount: int): int {
    if (amount <= 0) { return 0; }

    switch (obj) {
        case Creature(cre): {
            var health = get_propset!(CreatureHealth)(cre);
            var before = health.hp_current;
            var after = before - amount;
            if (after < 0) { after = 0; }
            health.hp_current = after;
            NativeCreature.set_vitals(cre, health.hp_current, health.hp_max);
            return before - after;
        }
        case Door(door): {
            var state = get_propset!(DoorState)(door);
            var before = state.hp_current;
            var after = before - amount;
            if (after < 0) { after = 0; }
            state.hp_current = after;
            return before - after;
        }
        case Placeable(placeable): {
            var state = get_propset!(PlaceableState)(placeable);
            var before = state.hp_current;
            var after = before - amount;
            if (after < 0) { after = 0; }
            state.hp_current = after;
            return before - after;
        }
        default: {
            return 0;
        }
    }
}

fn heal_damage(cre: Creature, amount: int): int {
    if (amount <= 0) { return 0; }
    var health = get_propset!(CreatureHealth)(cre);
    var before = health.hp_current;
    var hp_max = get_max_hitpoints(cre);
    var after = before + amount;
    if (after > hp_max) { after = hp_max; }
    health.hp_current = after;
    NativeCreature.set_vitals(cre, health.hp_current, health.hp_max);
    return after - before;
}
