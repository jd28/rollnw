from core.types import { Feat, AttackType };
import nwn1.creature_state as Cre;
import core.item as CoreItem;
import core.object as Obj;
import core.array as arr;
import core.map as map;
from nwn1.propsets import { CreatureStats };

import nwn1.baseitems as baseitems;
import nwn1.constants as Const;
import nwn1.item as item;
from nwn1.constants import { MasterFeat };

const _mfeat_count = 18;

var _mfeat_bonuses: array!(int);
var _mfeat_values: array!(map!(int, Feat));

fn _ensure_init() {
    if (arr.len(_mfeat_bonuses) >= _mfeat_count) { return; }
    for (var i = 0; i < _mfeat_count; i += 1) {
        arr.push(_mfeat_bonuses, 0);
        var m: map!(int, Feat);
        arr.push(_mfeat_values, m);
    }
}

fn add(mfeat: MasterFeat, rule_type: $T, feat: Feat) {
    _ensure_init();
    const mf = mfeat as int;
    if(mf < 0 || mf >= _mfeat_count) { return; } // [TODO] should be script failure
    map.set(_mfeat_values[mf], rule_type as int, feat);
}

fn get(mfeat: MasterFeat, rule_type: $T): Feat {
    _ensure_init();
    const mf = mfeat as int;

    if(mf < 0 || mf >= _mfeat_count) { return Const.feat_type_invalid; } // [TODO] should be script failure
    if (!map.has(_mfeat_values[mf], rule_type as int)) {
        return Const.feat_type_invalid;
    }
    return map.get(_mfeat_values[mf], rule_type as int);
}

fn has_feat_check(obj: Creature, mfeat: MasterFeat, rule_type: $T): bool {
    _ensure_weapon_category_feats();
    return Cre.has_feat(obj, get(mfeat, rule_type));
}

fn weapon_for_attack(obj: Creature, attack_type: AttackType): Item {
    if (attack_type == Const.attack_type_onhand) { return CoreItem.get_equipped_item(obj, Const.equip_index_righthand); }
    if (attack_type == Const.attack_type_offhand) { return CoreItem.get_equipped_item(obj, Const.equip_index_lefthand); }
    if (attack_type == Const.attack_type_unarmed) { return CoreItem.get_equipped_item(obj, Const.equip_index_arms); }
    if (attack_type == Const.attack_type_cweapon1) { return CoreItem.get_equipped_item(obj, Const.equip_index_creature_bite); }
    if (attack_type == Const.attack_type_cweapon2) { return CoreItem.get_equipped_item(obj, Const.equip_index_creature_left); }
    if (attack_type == Const.attack_type_cweapon3) { return CoreItem.get_equipped_item(obj, Const.equip_index_creature_right); }
    return Obj.invalid as Item;
}

fn has_improved_critical(obj: Creature, attack_type: AttackType): bool {
    var weapon = weapon_for_attack(obj, attack_type);
    var base_item = item.get_baseitem_type(weapon);
    return has_feat_check(obj, Const.mfeat_improved_crit, base_item);
}

fn weapon_damage_specialization_bonus(obj: Creature, base_item: $T): int {
    return resolve(obj, Const.mfeat_weapon_spec, base_item) + resolve(obj, Const.mfeat_weapon_spec_epic, base_item);
}

fn has_overwhelming_critical(obj: Creature, attack_type: AttackType): bool {
    var weapon = weapon_for_attack(obj, attack_type);
    var base_item = item.get_baseitem_type(weapon);
    return has_feat_check(obj, Const.mfeat_overwhelming_crit, base_item);
}

fn has_favored_enemy(obj: Creature, target: object): bool {
    if (!(target is Creature)) { return false; }
    const ps = get_propset!(CreatureStats)(target as Creature);
    return has_feat_check(obj, Const.mfeat_favored_enemy, Const.RacialType(ps.race));
}

fn resolve(obj: Creature, mfeat: MasterFeat, rule_type: $T): int {
    _ensure_init();
    _ensure_weapon_category_feats();
    const mf = mfeat as int;

    if(mf < 0 || mf >= _mfeat_count) { return 0; } // [TODO] should be script failure
    if (!map.has(_mfeat_values[mf], rule_type as int)) {
        return 0;
    }
    const feat = map.get(_mfeat_values[mf], rule_type as int);
    if(Cre.has_feat(obj, feat)) {
        return _mfeat_bonuses[mf];
    }
    return 0;
}

fn set_bonus(mfeat: MasterFeat, bonus: int) {
    _ensure_init();
    const mf = mfeat as int;
    if(mf < 0 || mf >= _mfeat_count) { return; } // [TODO] should be script failure
    _mfeat_bonuses[mf] = bonus;
}

var _weapon_category_feats_registered = false;

// Weapon Focus/Specialization/Improved Critical/Overwhelming Critical/
// Devastating Critical/Weapon of Choice are keyed by real base item in
// baseitems.2da; init.smalls only seeds the BaseItemType(-1) (unarmed) entry
// for each. Registered here lazily, on first real resolve()/has_feat_check()
// call, rather than eagerly during Init.init(): loading baseitems that early
// was found to disturb unrelated equipment/visual state several tests depend
// on, even though baseitems' own data is unaffected (regression-tested
// separately). This keeps baseitems' first-load point exactly where it
// already was — the first time something actually needs it.
fn _ensure_weapon_category_feats() {
    if (_weapon_category_feats_registered) { return; }
    _weapon_category_feats_registered = true;

    for (var wi = 0; wi < baseitems.count(); wi += 1) {
        var bi = CoreItem.BaseItemType(wi);
        if (!baseitems.is_weapon(bi)) { continue; }

        var wf = baseitems.weapon_focus_feat(bi);
        if (wf >= 0) { add(Const.mfeat_weapon_focus, bi, Feat(wf)); }

        var wfe = baseitems.epic_weapon_focus_feat(bi);
        if (wfe >= 0) { add(Const.mfeat_weapon_focus_epic, bi, Feat(wfe)); }

        var ws = baseitems.weapon_specialization_feat(bi);
        if (ws >= 0) { add(Const.mfeat_weapon_spec, bi, Feat(ws)); }

        var wse = baseitems.epic_weapon_specialization_feat(bi);
        if (wse >= 0) { add(Const.mfeat_weapon_spec_epic, bi, Feat(wse)); }

        var ic = baseitems.weapon_improved_critical_feat(bi);
        if (ic >= 0) { add(Const.mfeat_improved_crit, bi, Feat(ic)); }

        var oc = baseitems.epic_weapon_overwhelming_critical_feat(bi);
        if (oc >= 0) { add(Const.mfeat_overwhelming_crit, bi, Feat(oc)); }

        var dc = baseitems.epic_weapon_devastating_critical_feat(bi);
        if (dc >= 0) { add(Const.mfeat_devastating_crit, bi, Feat(dc)); }

        var woc = baseitems.weapon_of_choice_feat(bi);
        if (woc >= 0) { add(Const.mfeat_weapon_of_choice, bi, Feat(woc)); }
    }
}
