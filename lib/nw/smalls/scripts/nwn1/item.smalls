fn has_property(item_obj: Item, prop_type: int, subtype: int): bool {
    if ((item_obj as object) == O.invalid) {
        return false;
    }

    var properties = base.item_properties(item_obj);
    for (var ip in properties) {
        if (ip.prop_type == prop_type && (subtype == -1 || ip.subtype == subtype)) {
            return true;
        }
    }
    return false;
}

fn can_equip_item(creature: Creature, item_obj: Item, slot: base.EquipIndex): bool {
    if ((creature as object) == O.invalid || (item_obj as object) == O.invalid) {
        return false;
    }

    for (var i = 0; i < Array.len(can_equip_callbacks); i += 1) {
        var callback = can_equip_callbacks[i];
        if (!callback(creature, item_obj, slot)) {
            return false;
        }
    }
    return true;
}

fn add_can_equip_callback(callback: fn(Creature, Item, base.EquipIndex): bool) {
    Array.push(can_equip_callbacks, callback);
}

fn ability_modifier(ability: Const.Ability, amount: int): base.ItemEffectRow {
    return {
        op = base.item_effect_op_ability_modifier,
        timing = base.item_effect_timing_equipped,
        subject = ability as int,
        value0 = amount,
        value1 = 0,
        value2 = 0,
        condition = base.item_effect_condition_none,
        flags = base.item_effect_flag_none,
    };
}

fn attack_modifier(attack: Const.AttackType, amount: int): base.ItemEffectRow {
    return {
        op = base.item_effect_op_attack_modifier,
        timing = base.item_effect_timing_equipped,
        subject = attack as int,
        value0 = amount,
        value1 = 0,
        value2 = 0,
        condition = base.item_effect_condition_none,
        flags = base.item_effect_flag_none,
    };
}

