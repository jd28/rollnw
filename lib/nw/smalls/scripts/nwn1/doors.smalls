import core.door as NativeDoor;
import core.string as String;
import core.types as T;
import core.visual as Visual;
from nwn1.propsets import { DoorState };

type DoorResolvedModel {
    model:    T.ResRef;
    label:    string;
    error:    string;
    table:    string;
    column:   string;
    selector: string;
    row:      int;
    generic:  bool;
    valid:    bool;
};

fn _invalid_model(
    error: string,
    table: string,
    column: string,
    selector: string,
    row: int,
    generic: bool): DoorResolvedModel {
    return DoorResolvedModel {
        model = T.resref(""),
        label = "",
        error = error,
        table = table,
        column = column,
        selector = selector,
        row = row,
        generic = generic,
        valid = false,
    };
}

fn _model_name_is_null(model: string): bool {
    return model == "" || model == "****" || model == "null" || model == "none";
}

fn _localized_appearance_name(strref: int, fallback: string): string {
    if (strref < 0) {
        return fallback;
    }
    var result = T.resolve_strref(strref);
    if (result == "" || String.starts_with(result, "Bad Strref")) {
        return fallback;
    }
    return result;
}

fn _resolved_model(
    model: T.ResRef,
    label: string,
    table: string,
    column: string,
    selector: string,
    row: int,
    generic: bool): DoorResolvedModel {
    var available = T.resource_exists(model, T.resource_type_mdl);
    return DoorResolvedModel {
        model = model,
        label = label,
        error = available
            ? ""
            : f"model '{T.resref_to_string(model)}' is not available",
        table = table,
        column = column,
        selector = selector,
        row = row,
        generic = generic,
        valid = available,
    };
}

fn count_doortypes(): int {
    return NativeDoor.door_type_count();
}

fn count_genericdoors(): int {
    return NativeDoor.generic_door_count();
}

fn resolve_door_model_by_state(appearance: int, generic_type: int): DoorResolvedModel {
    // Door appearance is a two-source protocol, not one global catalog.
    // appearance == 0 selects a portable GenericType from genericdoors.2da.
    // A nonzero appearance selects a tileset-specific doortypes.2da row that
    // originates in a tile/SET door slot.  Existing objects must still resolve
    // those rows, but editors must not offer doortypes.2da as a generic picker.
    // Either table may also name optional content absent from the active
    // resource set; _resolved_model reports that explicitly instead of guessing.

    if (appearance == 0) {
        var row = generic_type;
        var table = "genericdoors";
        var column = "ModelName";
        var selector = "generic type";
        if (row < 0) {
            return _invalid_model(f"{selector} {row} is invalid", table, column, selector, row, true);
        }
        var count = NativeDoor.generic_door_count();
        if (row >= count) {
            return _invalid_model(
                f"{selector} {row} is outside {table}.2da ({count} rows)",
                table,
                column,
                selector,
                row,
                true);
        }

        var entry = NativeDoor.generic_door_info(row);
        var model = T.resref_to_string(entry.model);
        if (entry.id != row || _model_name_is_null(model)) {
            return _invalid_model(f"{selector} {row} has no {column} in {table}.2da", table, column, selector, row, true);
        }

        return _resolved_model(
            entry.model,
            _localized_appearance_name(entry.string_ref, model),
            table,
            column,
            selector,
            row,
            true);
    }

    var row = appearance;
    var table = "doortypes";
    var column = "Model";
    var selector = "appearance";
    if (row < 0) {
        return _invalid_model(f"{selector} {row} is invalid", table, column, selector, row, false);
    }
    var count = NativeDoor.door_type_count();
    if (row >= count) {
        return _invalid_model(
            f"{selector} {row} is outside {table}.2da ({count} rows)",
            table,
            column,
            selector,
            row,
            false);
    }

    var entry = NativeDoor.door_type_info(row);
    var model = T.resref_to_string(entry.model);
    if (entry.id != row || _model_name_is_null(model)) {
        return _invalid_model(f"{selector} {row} has no {column} in {table}.2da", table, column, selector, row, false);
    }

    return _resolved_model(
        entry.model,
        _localized_appearance_name(entry.string_ref, model),
        table,
        column,
        selector,
        row,
        false);
}

fn resolve_door_model(door: Door): DoorResolvedModel {
    var state = get_propset!(DoorState)(door);
    return resolve_door_model_by_state(state.appearance, state.generic_type);
}

fn appearance_exists(appearance: int, generic_type: int): bool {
    return resolve_door_model_by_state(appearance, generic_type).valid;
}

fn update_visual(door: Door): bool {
    var state = get_propset!(DoorState)(door);
    var model = resolve_door_model_by_state(state.appearance, state.generic_type);
    if (!Visual.clear_visual(door, state.appearance)) {
        return false;
    }
    if (!model.valid) {
        return true;
    }
    return Visual.add_visual_model(
        door,
        model.model,
        T.resref(""),
        T.resref(""),
        Visual.visual_model_kind_root,
        Visual.visual_model_slot_none,
        0,
        Visual.visual_model_flag_none
    );
}

fn set_appearance(door: Door, appearance: int, generic_type: int): bool {
    if (!appearance_exists(appearance, generic_type)) {
        return false;
    }

    var state = get_propset!(DoorState)(door);
    var previous_appearance = state.appearance;
    var previous_generic_type = state.generic_type;
    if (previous_appearance == appearance
        && previous_generic_type == generic_type) {
        return true;
    }

    state.appearance = appearance;
    state.generic_type = generic_type;
    if (update_visual(door)) {
        return true;
    }

    state.appearance = previous_appearance;
    state.generic_type = previous_generic_type;
    update_visual(door);
    return false;
}
