[[value_type]]
type EncounterSpawn {
    appearance: int;
    cr: float;
    resref: ResRef;
    single_spawn: int;
};

[[propset(Encounter)]]
type EncounterState {
    on_entered: ResRef;
    on_exhausted: ResRef;
