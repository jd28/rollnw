type CreatureResolvedModel {
    model:             T.ResRef;
    race:              T.ResRef;
    appearance:        int;
    model_type:        int;
    model_flags:       int;
    wing_tail_scale:   float;
    helmet_scale_m:    float;
    helmet_scale_f:    float;
    hand_item_visible: bool;
    hand_item_scale:   float;
    hand_item_reason:  int;
    humanoid:          bool;
    valid:             bool;
    error:             string;
};

type CreatureBodyPartEditorSnapshot {
    assembly: int;
    values: array!(int);
};

