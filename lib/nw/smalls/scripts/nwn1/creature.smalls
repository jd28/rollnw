    field: string;
    element: int;
    edit_value: int;
    edit_min: int;
    edit_max: int;
    class_slot: int;
    class_level: int;
    class_level_min: int;
    class_level_max: int;
};

const property_editor_surface_properties = 0;
const property_editor_surface_classes = 1;
const property_editor_kind_read_only = 0;
const property_editor_kind_boolean = 1;
const property_editor_kind_integer = 2;
const property_editor_class_level_min = 1;
const property_editor_class_level_max = 60;
const property_editor_int16_min = -32768;
const property_editor_int16_max = 32767;
const property_editor_uint8_min = 0;
const property_editor_uint8_max = 255;

const creature_color_palette_skin = 0;
const creature_color_palette_hair = 1;
const creature_color_value_count = 176;

var _phenotype_loaded = false;
var _phenotypes: array!(PhenotypeEntry);
var _parts_robe_loaded = false;
var _parts_robe: array!(RobePartsEntry);
var _feat_loaded = false;
var _feats: array!(FeatEntry);
var did_install_creature_visual_callbacks = false;

fn get_property_editor_groups(): array!(CreaturePropertyEditorGroup) {
    var rows: array!(CreaturePropertyEditorGroup) = {};
    var scripts: CreaturePropertyEditorGroup = {
        propset = "nwn1.propsets.CreatureDescriptor",
        label = "Scripts",
        first_field = 0,
        field_count = 13,
    };
    arr.push(rows, scripts);
    return rows;
}

fn _property_editor_row(surface: int, group: string, label: string, value: string,
    class_slot: int = -1, class_level: int = 0,
    class_level_min: int = 0, class_level_max: int = 0): CreaturePropertyEditorRow {
    return CreaturePropertyEditorRow {
        surface = surface,
        group = group,
        label = label,
        value = value,
        editor = property_editor_kind_read_only,
        propset = "",
        field = "",
        element = -1,
        edit_value = 0,
        edit_min = 0,
        edit_max = 0,
        class_slot = class_slot,
        class_level = class_level,
        class_level_min = class_level_min,
        class_level_max = class_level_max,
    };
}

fn _boolean_property_editor_row(group: string, label: string,
    field: string, value: int): CreaturePropertyEditorRow {
    return CreaturePropertyEditorRow {
        surface = property_editor_surface_properties,
        group = group,
        label = label,
        value = _bool_editor_value(value),
        editor = property_editor_kind_boolean,
        propset = "nwn1.propsets.CreatureStats",
        field = field,
        element = -1,
        edit_value = value,
        edit_min = 0,
        edit_max = 1,
        class_slot = -1,
        class_level = 0,
        class_level_min = 0,
        class_level_max = 0,
    };
}

fn _integer_property_editor_row(group: string, label: string,
    field: string, element: int, value: int,
    minimum: int, maximum: int): CreaturePropertyEditorRow {
    return CreaturePropertyEditorRow {
        surface = property_editor_surface_properties,
        group = group,
        label = label,
        value = f"{value}",
        editor = property_editor_kind_integer,
        propset = "nwn1.propsets.CreatureStats",
        field = field,
        element = element,
        edit_value = value,
        edit_min = minimum,
        edit_max = maximum,
        class_slot = -1,
        class_level = 0,
        class_level_min = 0,
        class_level_max = 0,
    };
}

fn _localized_editor_name(strref: int, fallback: string): string {
    if (strref < 0) {
        return fallback;
    }
    var result = T.resolve_strref(strref);
    if (result == "" || String.starts_with(result, "Bad Strref")) {
        return fallback;
    }
    return result;
}

fn _gender_editor_name(gender: int): string {
    if (gender == 0) { return "Male"; }
    if (gender == 1) { return "Female"; }
    return f"Gender {gender}";
}

fn _bool_editor_value(value: int): string {
    if (value != 0) { return "True"; }
    return "False";
}

fn get_property_editor_rows(obj: Creature): array!(CreaturePropertyEditorRow) {
    var descriptor = get_propset!(CreatureDescriptor)(obj);
    var appearance = get_propset!(CreatureAppearance)(obj);
    var stats = get_propset!(CreatureStats)(obj);
    var health = get_propset!(CreatureHealth)(obj);
    var levels = get_propset!(CreatureLevels)(obj);
    var rows: array!(CreaturePropertyEditorRow) = {};

    arr.push(rows, _property_editor_row(property_editor_surface_properties, "Identity", "First Name", T.resolve_text(descriptor.name_first, 0)));
    arr.push(rows, _property_editor_row(property_editor_surface_properties, "Identity", "Last Name", T.resolve_text(descriptor.name_last, 0)));
    arr.push(rows, _property_editor_row(property_editor_surface_properties, "Identity", "Gender", _gender_editor_name(stats.gender)));
    arr.push(rows, _property_editor_row(property_editor_surface_properties, "Identity", "Race",
        _localized_editor_name(races.name_strref(stats.race) as int, f"Race {stats.race}")));
    arr.push(rows, _property_editor_row(property_editor_surface_properties, "Identity", "Subrace", descriptor.subrace));
    arr.push(rows, _property_editor_row(property_editor_surface_properties, "Identity", "Faction", f"{health.faction_id}"));
    arr.push(rows, _property_editor_row(property_editor_surface_properties, "Identity", "Deity", descriptor.deity));
    arr.push(rows, _property_editor_row(property_editor_surface_properties, "Identity", "Portrait", T.resref_to_string(appearance.portrait)));
    arr.push(rows, _property_editor_row(property_editor_surface_properties, "Identity", "Conversation", T.resref_to_string(descriptor.conversation)));
    arr.push(rows, _property_editor_row(property_editor_surface_properties, "Identity", "Default Package", f"{health.starting_package}"));

    arr.push(rows, _integer_property_editor_row("Abilities", "Strength", "abilities", 0,
        stats.abilities[0], property_editor_uint8_min, property_editor_uint8_max));
    arr.push(rows, _integer_property_editor_row("Abilities", "Dexterity", "abilities", 1,
        stats.abilities[1], property_editor_uint8_min, property_editor_uint8_max));
    arr.push(rows, _integer_property_editor_row("Abilities", "Constitution", "abilities", 2,
        stats.abilities[2], property_editor_uint8_min, property_editor_uint8_max));
    arr.push(rows, _integer_property_editor_row("Abilities", "Intelligence", "abilities", 3,
        stats.abilities[3], property_editor_uint8_min, property_editor_uint8_max));
    arr.push(rows, _integer_property_editor_row("Abilities", "Wisdom", "abilities", 4,
        stats.abilities[4], property_editor_uint8_min, property_editor_uint8_max));
    arr.push(rows, _integer_property_editor_row("Abilities", "Charisma", "abilities", 5,
        stats.abilities[5], property_editor_uint8_min, property_editor_uint8_max));

    arr.push(rows, _integer_property_editor_row("Save Bonus", "Fortitude", "save_fort", -1,
        stats.save_fort, property_editor_int16_min, property_editor_int16_max));
    arr.push(rows, _integer_property_editor_row("Save Bonus", "Reflex", "save_reflex", -1,
        stats.save_reflex, property_editor_int16_min, property_editor_int16_max));
    arr.push(rows, _integer_property_editor_row("Save Bonus", "Will", "save_will", -1,
        stats.save_will, property_editor_int16_min, property_editor_int16_max));

    arr.push(rows, _property_editor_row(property_editor_surface_properties, "Scripts", "On Blocked", T.resref_to_string(descriptor.on_blocked)));
    arr.push(rows, _property_editor_row(property_editor_surface_properties, "Scripts", "On Combat End Round", T.resref_to_string(descriptor.on_endround)));
    arr.push(rows, _property_editor_row(property_editor_surface_properties, "Scripts", "On Conversation", T.resref_to_string(descriptor.on_conversation)));
    arr.push(rows, _property_editor_row(property_editor_surface_properties, "Scripts", "On Damaged", T.resref_to_string(descriptor.on_damaged)));
    arr.push(rows, _property_editor_row(property_editor_surface_properties, "Scripts", "On Death", T.resref_to_string(descriptor.on_death)));
    arr.push(rows, _property_editor_row(property_editor_surface_properties, "Scripts", "On Disturbed", T.resref_to_string(descriptor.on_disturbed)));
    arr.push(rows, _property_editor_row(property_editor_surface_properties, "Scripts", "On Heartbeat", T.resref_to_string(descriptor.on_heartbeat)));
    arr.push(rows, _property_editor_row(property_editor_surface_properties, "Scripts", "On Perception", T.resref_to_string(descriptor.on_perceived)));
    arr.push(rows, _property_editor_row(property_editor_surface_properties, "Scripts", "On Physically Attacked", T.resref_to_string(descriptor.on_attacked)));
    arr.push(rows, _property_editor_row(property_editor_surface_properties, "Scripts", "On Rested", T.resref_to_string(descriptor.on_rested)));
    arr.push(rows, _property_editor_row(property_editor_surface_properties, "Scripts", "On Spawn", T.resref_to_string(descriptor.on_spawn)));
    arr.push(rows, _property_editor_row(property_editor_surface_properties, "Scripts", "On Spell Cast At", T.resref_to_string(descriptor.on_spell_cast_at)));
    arr.push(rows, _property_editor_row(property_editor_surface_properties, "Scripts", "On User Defined", T.resref_to_string(descriptor.on_user_defined)));

    var skill_rows: array!(CreaturePropertyEditorRow) = {};
    for (var skill_id = 0; skill_id < Skills.count(); skill_id += 1) {
        var skill = Skill(skill_id);
        if (Skills.exists(skill)) {
            var skill_value = 0;
            if (skill_id < arr.len(stats.skills)) {
                skill_value = stats.skills[skill_id];
            }
            var skill_label = _localized_editor_name(
                Skills.name_strref(skill) as int, f"Skill {skill_id}");
            if (skill_id < arr.len(stats.skills)) {
                arr.push(skill_rows, _integer_property_editor_row("Skills", skill_label,
                    "skills", skill_id, skill_value,
                    property_editor_uint8_min, property_editor_uint8_max));
            } else {
                arr.push(skill_rows, _property_editor_row(
                    property_editor_surface_properties, "Skills", skill_label, f"{skill_value}"));
            }
        }
    }
    arr.sort(skill_rows, fn(a: CreaturePropertyEditorRow, b: CreaturePropertyEditorRow): bool {
        return a.label < b.label;
    });
    for (var skill_row = 0; skill_row < arr.len(skill_rows); skill_row += 1) {
        arr.push(rows, arr.get(skill_rows, skill_row));
    }

    arr.push(rows, _property_editor_row(property_editor_surface_properties, "Interface", "Corpse Decay Time", f"{descriptor.decay_time / 1000}"));
    arr.push(rows, _boolean_property_editor_row("Interface", "Disarmable", "disarmable", stats.disarmable));
    arr.push(rows, _boolean_property_editor_row("Interface", "Immortal", "immortal", stats.immortal));
    arr.push(rows, _boolean_property_editor_row("Interface", "Lootable Corpse", "lootable", stats.lootable));
    arr.push(rows, _boolean_property_editor_row("Interface", "No Permanent Death", "chunk_death", stats.chunk_death));
    arr.push(rows, _boolean_property_editor_row("Interface", "Plot", "plot", stats.plot));

    arr.push(rows, _property_editor_row(property_editor_surface_properties, "Advanced", "Movement Rate", f"{levels.walkrate}"));
    arr.push(rows, _property_editor_row(property_editor_surface_properties, "Advanced", "Perception Range", f"{stats.perception_range}"));

    arr.push(rows, _property_editor_row(property_editor_surface_properties, "Description", "Description",
        T.resolve_text(descriptor.description, 0)));

    for (var slot = 0; slot < 8; slot += 1) {
        var class_id = levels.classes[slot];
        var level = levels.class_levels[slot];
        if (class_id >= 0 && level > 0) {
            var class_name = _localized_editor_name(
                Classes.name_strref(Class(class_id)) as int, f"Class {class_id}");
            arr.push(rows, _property_editor_row(property_editor_surface_classes, "", class_name, f"{level}",
                slot, level, property_editor_class_level_min, property_editor_class_level_max));
        }
    }
    return rows;
}

fn get_class_slot_levels(creature: Creature): array!(int) {
    var levels = get_propset!(CreatureLevels)(creature);
    var result: array!(int) = {};
    arr.reserve(result, 8);
    for (var slot = 0; slot < 8; slot += 1) {
        arr.push(result, levels.class_levels[slot]);
    }
    return result;
}

fn can_set_class_levels(creature: Creature, slots: array!(int), values: array!(int)): bool {
    var count = arr.len(slots);
    if (count <= 0 || count != arr.len(values) || count > 8) {
        return false;
    }

    var levels = get_propset!(CreatureLevels)(creature);
    for (var i = 0; i < count; i += 1) {
        var slot = slots[i];
        var value = values[i];
        if (slot < 0 || slot >= 8
            || !Classes.exists(Class(levels.classes[slot]))
            || value < property_editor_class_level_min
            || value > property_editor_class_level_max) {
            return false;
        }
        for (var j = 0; j < i; j += 1) {
            if (slots[j] == slot) {
                return false;
            }
        }
    }
    return true;
}

fn set_class_levels(creature: Creature, slots: array!(int), values: array!(int)): bool {
    if (!can_set_class_levels(creature, slots, values)) {
        return false;
    }

    var levels = get_propset!(CreatureLevels)(creature);
    for (var i = 0; i < arr.len(slots); i += 1) {
        var slot = slots[i];
        var value = values[i];
        levels.class_levels[slot] = value;
    }
    return true;
}

fn _ensure_phenotypes_loaded() {
    if (_phenotype_loaded) {
        return;
    }
    _phenotypes = load_config!(PhenotypeEntry)("nwn1.data.phenotype");
    _phenotype_loaded = true;
}

fn _ensure_parts_robe_loaded() {
    if (_parts_robe_loaded) {
        return;
    }
    _parts_robe = load_config!(RobePartsEntry)("nwn1.data.parts_robe");
    _parts_robe_loaded = true;
}

fn _ensure_feats_loaded() {
    if (_feat_loaded) {
        return;
    }
    _feats = load_config!(FeatEntry)("nwn1.data.feats");
    _feat_loaded = true;
}

fn _invalid_model(appearance: int, model_type: int, error: string): CreatureResolvedModel {
    return CreatureResolvedModel {
        model = T.resref(""),
        race = T.resref(""),
        appearance = appearance,
        model_type = model_type,
        model_flags = 0,
        wing_tail_scale = 1.0,
        helmet_scale_m = 1.0,
        helmet_scale_f = 1.0,
        hand_item_visible = true,
        hand_item_scale = 1.0,
        hand_item_reason = appearance_hand_item_visible,
        humanoid = false,
        valid = false,
        error = error,
    };
}

fn _model_name_is_null(model: T.ResRef): bool {
    var value = T.resref_to_string(model);
    return value == "" || value == "****" || value == "null" || value == "none";
}

fn _attachment_model_name_is_null(model: T.ResRef): bool {
    var value = T.resref_to_string(model);
    return value == "" || value == "****" || value == "null" || value == "none" || value == "c_nulltail";
}

fn _empty_resref(): T.ResRef {
    return T.resref("");
}

fn _resref_empty(value: T.ResRef): bool {
    return T.resref_to_string(value) == "";
}

fn _body_part_armor_part(part: int): int {
    if (part == Cre.body_part_belt) { return NwnItem.item_model_part_armor_belt; }
    if (part == Cre.body_part_bicep_left) { return NwnItem.item_model_part_armor_lbicep; }
    if (part == Cre.body_part_bicep_right) { return NwnItem.item_model_part_armor_rbicep; }
    if (part == Cre.body_part_foot_left) { return NwnItem.item_model_part_armor_lfoot; }
    if (part == Cre.body_part_foot_right) { return NwnItem.item_model_part_armor_rfoot; }
    if (part == Cre.body_part_forearm_left) { return NwnItem.item_model_part_armor_lfarm; }
    if (part == Cre.body_part_forearm_right) { return NwnItem.item_model_part_armor_rfarm; }
    if (part == Cre.body_part_hand_left) { return NwnItem.item_model_part_armor_lhand; }
    if (part == Cre.body_part_hand_right) { return NwnItem.item_model_part_armor_rhand; }
    if (part == Cre.body_part_neck) { return NwnItem.item_model_part_armor_neck; }
    if (part == Cre.body_part_pelvis) { return NwnItem.item_model_part_armor_pelvis; }
    if (part == Cre.body_part_shin_left) { return NwnItem.item_model_part_armor_lshin; }
    if (part == Cre.body_part_shin_right) { return NwnItem.item_model_part_armor_rshin; }
    if (part == Cre.body_part_shoulder_left) { return NwnItem.item_model_part_armor_lshoul; }
    if (part == Cre.body_part_shoulder_right) { return NwnItem.item_model_part_armor_rshoul; }
    if (part == Cre.body_part_thigh_left) { return NwnItem.item_model_part_armor_lthigh; }
    if (part == Cre.body_part_thigh_right) { return NwnItem.item_model_part_armor_rthigh; }
    if (part == Cre.body_part_torso) { return NwnItem.item_model_part_armor_torso; }
    return -1;
}

fn _resolve_body_part_value(value: int, mirror_value: int): int {
    if (value == 255) {
        if (mirror_value != 0 && mirror_value != 255) {
            return mirror_value;
        }
        return 0;
    }
    return value;
}

fn _resolve_armor_part_value(value: int, mirror_value: int): int {
    if (value == 0 || value == 255) {
        if (mirror_value != 0 && mirror_value != 255) {
            return mirror_value;
        }
        return value;
    }
    return value;
}

fn _body_part_tattoo_model_uses_tattoo_palette(part: int): bool {
    return part == Cre.body_part_bicep_left
        || part == Cre.body_part_bicep_right
        || part == Cre.body_part_torso
        || part == Cre.body_part_forearm_left
        || part == Cre.body_part_forearm_right
        || part == Cre.body_part_thigh_left
        || part == Cre.body_part_thigh_right
        || part == Cre.body_part_shin_left
        || part == Cre.body_part_shin_right;
}

fn _resolve_armor_skin_tattoo_model_part(part: int, creature_model_part: int, armor_model_part: int): int {
    const skin_model_part = 1;
    const tattoo_model_part = 2;

    if (armor_model_part == skin_model_part
        && creature_model_part == tattoo_model_part
        && _body_part_tattoo_model_uses_tattoo_palette(part)) {
        return tattoo_model_part;
    }
    return armor_model_part;
}

fn _armor_can_supply_missing_body_part(part: int): bool {
    return part == Cre.body_part_belt
        || part == Cre.body_part_shoulder_left
        || part == Cre.body_part_shoulder_right;
}

fn _normalized_body_part(creature: Creature, assembly: int, part: int): int {
    var value = Cre.get_body_part(creature, part);
    var mirror = NativeCreature.body_part_mirror(assembly, part);
    if (mirror >= 0) {
        return _resolve_body_part_value(value, Cre.get_body_part(creature, mirror));
    }
    return value;
}

fn _robe_hides_body_part(robe_part: int, part: int): bool {
    if (robe_part <= 0) {
        return false;
    }
    _ensure_parts_robe_loaded();
    if (robe_part >= arr.len(_parts_robe)) {
        return false;
    }

    var robe = arr.get(_parts_robe, robe_part);
    if (part == Cre.body_part_belt) { return robe.hide_belt != 0; }
    if (part == Cre.body_part_bicep_left) { return robe.hide_bicep_left != 0; }
    if (part == Cre.body_part_bicep_right) { return robe.hide_bicep_right != 0; }
    if (part == Cre.body_part_foot_left) { return robe.hide_foot_left != 0; }
    if (part == Cre.body_part_foot_right) { return robe.hide_foot_right != 0; }
    if (part == Cre.body_part_forearm_left) { return robe.hide_forearm_left != 0; }
    if (part == Cre.body_part_forearm_right) { return robe.hide_forearm_right != 0; }
    if (part == Cre.body_part_hand_left) { return robe.hide_hand_left != 0; }
    if (part == Cre.body_part_hand_right) { return robe.hide_hand_right != 0; }
    if (part == Cre.body_part_head) { return robe.hide_head != 0; }
    if (part == Cre.body_part_neck) { return robe.hide_neck != 0; }
    if (part == Cre.body_part_pelvis) { return robe.hide_pelvis != 0; }
    if (part == Cre.body_part_shin_left) { return robe.hide_shin_left != 0; }
    if (part == Cre.body_part_shin_right) { return robe.hide_shin_right != 0; }
    if (part == Cre.body_part_shoulder_left) { return robe.hide_shoulder_left != 0; }
    if (part == Cre.body_part_shoulder_right) { return robe.hide_shoulder_right != 0; }
    if (part == Cre.body_part_thigh_left) { return robe.hide_thigh_left != 0; }
    if (part == Cre.body_part_thigh_right) { return robe.hide_thigh_right != 0; }
    if (part == Cre.body_part_torso) { return robe.hide_torso != 0; }
    return false;
}

fn _phenotype_fallback(phenotype: int): int {
    _ensure_phenotypes_loaded();
    if (phenotype < 0 || phenotype >= arr.len(_phenotypes)) {
        return 0;
    }

    var fallback = arr.get(_phenotypes, phenotype).fallback;
    if (fallback < 0 || fallback >= arr.len(_phenotypes)) {
        return 0;
    }
    return fallback;
}

fn _body_part_assembly(creature: Creature, model: CreatureResolvedModel): int {
    var appearance = get_propset!(CreatureAppearance)(creature);
    return NativeCreature.body_part_assembly(
        model.appearance,
        Cre.get_gender(creature),
        appearance.phenotype,
        _phenotype_fallback(appearance.phenotype));
}

fn count_appearances(): int {
    return Appearances.count();
}

fn _hand_item_reason(info: NativeCreature.AppearanceInfo): int {
    if (!info.has_arms) {
        return appearance_hand_item_hidden_no_arms;
    }
    if (info.weapon_scale < 0.0) {
        return appearance_hand_item_hidden_null_weapon_scale;
    }
    if (info.weapon_scale <= 0.0) {
        return appearance_hand_item_hidden_invalid_weapon_scale;
    }
    return appearance_hand_item_visible;
}

fn _hand_item_scale(info: NativeCreature.AppearanceInfo, reason: int): float {
    if (reason == appearance_hand_item_visible) {
        return info.weapon_scale;
    }
    return 1.0;
}

fn resolve_creature_model(appearance: int): CreatureResolvedModel {
    if (appearance < 0) {
        return _invalid_model(appearance, -1, f"appearance {appearance} is invalid");
    }
    if (appearance >= Appearances.count()) {
        return _invalid_model(appearance, -1, f"appearance {appearance} was not found in appearance.2da");
    }

    var entry = Appearances.get_info(appearance);
    if (entry.id != appearance || !Appearances.exists(appearance)) {
        return _invalid_model(appearance, -1, f"appearance {appearance} was not found in appearance.2da");
    }
    if (_model_name_is_null(entry.model)) {
        return _invalid_model(appearance, entry.model_type, f"appearance {appearance} has no model in appearance.2da");
    }

    var hand_reason = _hand_item_reason(entry);
    var hand_visible = hand_reason == appearance_hand_item_visible;
    var hand_scale = _hand_item_scale(entry, hand_reason);

    if (entry.model_type == appearance_model_type_parts) {
        return CreatureResolvedModel {
            model = T.resref(""),
            race = entry.model,
            appearance = appearance,
            model_type = entry.model_type,
            model_flags = entry.model_flags,
            wing_tail_scale = entry.wing_tail_scale,
            helmet_scale_m = entry.helmet_scale_m,
            helmet_scale_f = entry.helmet_scale_f,
            hand_item_visible = hand_visible,
            hand_item_scale = hand_scale,
            hand_item_reason = hand_reason,
            humanoid = true,
            valid = true,
            error = "",
        };
    }

    if (entry.model_type < 0) {
        return _invalid_model(appearance, entry.model_type, f"appearance {appearance} has an unsupported MODELTYPE");
    }

    return CreatureResolvedModel {
        model = entry.model,
        race = entry.model,
        appearance = appearance,
        model_type = entry.model_type,
        model_flags = entry.model_flags,
        wing_tail_scale = entry.wing_tail_scale,
        helmet_scale_m = entry.helmet_scale_m,
        helmet_scale_f = entry.helmet_scale_f,
        hand_item_visible = hand_visible,
        hand_item_scale = hand_scale,
        hand_item_reason = hand_reason,
        humanoid = false,
        valid = true,
        error = "",
    };
}

fn appearance_exists(appearance: int): bool {
    return resolve_creature_model(appearance).valid;
}

fn _append_humanoid_visual_row(
    creature: Creature,
    model: T.ResRef,
    anchor: T.ResRef,
    slot: int,
    part: int,
    source_part: int,
    model_part: int): bool {
    return Visual.add_visual_model_row(
        creature,
        model,
        _empty_resref(),
        anchor,
        _empty_resref(),
        Visual.visual_model_kind_creature_model_part,
        slot,
        part,
        source_part,
        model_part,
        Visual.visual_model_flag_none);
}

fn _set_creature_base_plt_colors(creature: Creature, equipment_visible: bool): bool {
    var appearance = get_propset!(CreatureAppearance)(creature);
    var mask = Visual.visual_plt_mask_creature;
    var metal1 = 0;
    var metal2 = 0;
    var cloth1 = 0;
    var cloth2 = 0;
    var leather1 = 0;
    var leather2 = 0;

    if (equipment_visible) {
        var chest_item = Item.get_equipped_item(creature, Const.equip_index_chest);
        if ((chest_item as object) != O.invalid
            && NwnItem.get_baseitem_type(chest_item) == Const.base_item_armor) {
            mask = bit.or(mask, Visual.visual_plt_mask_material);
            metal1 = NwnItem.get_visual_model_color(chest_item, NwnItem.item_color_metal1);
            metal2 = NwnItem.get_visual_model_color(chest_item, NwnItem.item_color_metal2);
            cloth1 = NwnItem.get_visual_model_color(chest_item, NwnItem.item_color_cloth1);
            cloth2 = NwnItem.get_visual_model_color(chest_item, NwnItem.item_color_cloth2);
            leather1 = NwnItem.get_visual_model_color(chest_item, NwnItem.item_color_leather1);
            leather2 = NwnItem.get_visual_model_color(chest_item, NwnItem.item_color_leather2);
        }
    }

    return Visual.set_visual_base_plt_colors(
        creature,
        mask,
        appearance.color_skin,
        appearance.color_hair,
        metal1,
        metal2,
        cloth1,
        cloth2,
        leather1,
        leather2,
        appearance.color_tattoo1,
        appearance.color_tattoo2);
}

fn _update_humanoid_visual_robe(
    creature: Creature,
    assembly: int,
    chest_item: Item,
    robe_part: int): bool {
    if (robe_part <= 0 || robe_part == 255) {
        return true;
    }

    var robe_model = NativeCreature.body_part_model(
        assembly, Cre.body_part_robe, robe_part, false);
    if (_resref_empty(robe_model)) {
        return true;
    }

    if (!_append_humanoid_visual_row(
        creature,
        robe_model,
        _empty_resref(),
        Const.equip_index_chest as int,
        NwnItem.item_model_part_armor_robe,
        robe_part,
        robe_part)) {
        return false;
    }
    return NwnItem.set_visual_plt_colors_for_row(
        creature,
        chest_item,
        Const.equip_index_chest as int,
        Visual.visual_model_kind_creature_model_part,
        NwnItem.item_model_part_armor_robe);
}

fn _update_humanoid_visual_body_part(
    creature: Creature,
    assembly: int,
    part: int,
    chest_is_armor: bool,
    chest_item: Item): bool {
    var creature_model_part = _normalized_body_part(creature, assembly, part);
    if ((creature_model_part == 0 || creature_model_part == 255)
        && !_armor_can_supply_missing_body_part(part)) {
        return true;
    }
    var model_part = creature_model_part;
    var slot = Visual.visual_model_slot_none;
    var item_part = -1;
    var prefer_mirror = false;
    var mirror_part = NativeCreature.body_part_mirror(assembly, part);

    if (chest_is_armor) {
        var armor_part = _body_part_armor_part(part);
        if (armor_part >= 0) {
            var raw_armor_model_part = NwnItem.get_visual_model_part(chest_item, armor_part);
            var armor_model_part = raw_armor_model_part;
            var inherited_from_mirror = false;
            if (mirror_part >= 0) {
                var mirror_armor_part = _body_part_armor_part(mirror_part);
                if (mirror_armor_part >= 0) {
                    var mirrored_model_part = NwnItem.get_visual_model_part(chest_item, mirror_armor_part);
                    armor_model_part = _resolve_armor_part_value(armor_model_part, mirrored_model_part);
                    inherited_from_mirror = (raw_armor_model_part == 0 || raw_armor_model_part == 255)
                        && mirrored_model_part != 0
                        && mirrored_model_part != 255;
                    prefer_mirror = inherited_from_mirror;
                    if (inherited_from_mirror) {
                        item_part = mirror_armor_part;
                    }
                }
            }
            armor_model_part = _resolve_armor_skin_tattoo_model_part(part, creature_model_part, armor_model_part);
            if (armor_model_part > 0 && armor_model_part != 255) {
                model_part = armor_model_part;
                slot = Const.equip_index_chest as int;
                if (item_part < 0) {
                    item_part = armor_part;
                }
            }
        }
    }

    var resolved = NativeCreature.body_part_model(
        assembly, part, model_part, prefer_mirror);
    if (_resref_empty(resolved)) {
        return true;
    }

    if (!_append_humanoid_visual_row(
        creature,
        resolved,
        NativeCreature.body_part_anchor(assembly, part),
        slot,
        item_part,
        creature_model_part,
        model_part)) {
        return false;
    }
    if (slot == Const.equip_index_chest as int && item_part >= 0) {
        return NwnItem.set_visual_plt_colors_for_row(
            creature,
            chest_item,
            slot,
            Visual.visual_model_kind_creature_model_part,
            item_part);
    }
    return true;
}

fn update_humanoid_visual_parts(
    creature: Creature,
    model: CreatureResolvedModel,
    equipment_visible: bool): bool {
    var assembly = _body_part_assembly(creature, model);
    if (assembly < 0) {
        return false;
    }
    var head_item = O.invalid as Item;
    var chest_item = O.invalid as Item;
    if (equipment_visible) {
        head_item = Item.get_equipped_item(creature, Const.equip_index_head);
        chest_item = Item.get_equipped_item(creature, Const.equip_index_chest);
    }
    var chest_is_armor = (chest_item as object) != O.invalid
        && NwnItem.get_baseitem_type(chest_item) == Const.base_item_armor;
    var equipped_robe_part = 0;
    if (chest_is_armor) {
        equipped_robe_part = NwnItem.get_visual_model_part(chest_item, NwnItem.item_model_part_armor_robe);
    }
    var robe_part = Cre.get_body_part(creature, Cre.body_part_robe);
    if (robe_part == 0) {
        robe_part = equipped_robe_part;
    }
    if (!chest_is_armor) {
        robe_part = 0;
    }

    var ok = true;
    for (var index = 0; index < NativeCreature.body_part_count(assembly); index += 1) {
        var part = NativeCreature.body_part_id_at(assembly, index);
        var flags = NativeCreature.body_part_flags(assembly, part);
        if (bit.and(flags, NativeCreature.body_part_info_flag_robe) != 0) {
            continue;
        }
        if ((head_item as object) != O.invalid && part == Cre.body_part_head) {
            continue;
        }
        if (_robe_hides_body_part(robe_part, part)) {
            continue;
        }
        if (!_update_humanoid_visual_body_part(
            creature,
            assembly,
            part,
            chest_is_armor,
            chest_item)) {
            ok = false;
        }
    }

    if (!_update_humanoid_visual_robe(
        creature,
        assembly,
        chest_item,
        robe_part)) {
        ok = false;
    }
    return ok;
}

fn _creature_attachment_anchor(part: int): T.ResRef {
    if (part == Visual.visual_creature_attachment_wing) { return T.resref("wings"); }
    if (part == Visual.visual_creature_attachment_tail) { return T.resref("tail"); }
    return _empty_resref();
}

fn _creature_attachment_model(part: int, row: int): T.ResRef {
    if (row <= 0) {
        return _empty_resref();
    }

    if (part == Visual.visual_creature_attachment_wing) {
        return NativeCreature.accessory_model(Cre.accessory_wings, row);
    }

    if (part == Visual.visual_creature_attachment_tail) {
        return NativeCreature.accessory_model(Cre.accessory_tail, row);
    }

    return _empty_resref();
}

fn _creature_attachment_is_null(part: int, row: int): bool {
    if (row <= 0) {
        return true;
    }

    var model = _creature_attachment_model(part, row);
    if (T.resref_to_string(model) == "") {
        return false;
    }
    return _attachment_model_name_is_null(model);
}

fn _update_creature_attachment_visual(creature: Creature, part: int, row: int): bool {
    if (row <= 0 || _creature_attachment_is_null(part, row)) {
        return true;
    }

    var anchor = _creature_attachment_anchor(part);
    if (T.resref_to_string(anchor) == "") {
        return false;
    }

    return Visual.add_visual_model_row(
        creature,
        _creature_attachment_model(part, row),
        _empty_resref(),
        anchor,
        anchor,
        Visual.visual_model_kind_creature_attachment,
        Visual.visual_model_slot_none,
        part,
        row,
        row,
        Visual.visual_model_flag_none);
}

fn _update_visual_by_appearance(
    creature: Creature,
    appearance: int,
    equipment_visible: bool): bool {
    var model = resolve_creature_model(appearance);
    if (!model.valid) {
        return false;
    }
    if (!Visual.clear_visual(creature, appearance)) {
        return false;
    }
    if (!Visual.set_visual_body_variant(creature, Cre.get_gender(creature))) {
        return false;
    }
    if (!_set_creature_base_plt_colors(creature, equipment_visible)) {
        return false;
    }

    var ok = true;
    if (model.humanoid) {
        if (!update_humanoid_visual_parts(creature, model, equipment_visible)) {
            ok = false;
        }
    } else {
        ok = Visual.add_visual_model(
            creature,
            model.model,
            T.resref(""),
            T.resref(""),
            Visual.visual_model_kind_root,
            Visual.visual_model_slot_none,
            0,
            Visual.visual_model_flag_none
        );
    }
    if (!_update_creature_attachment_visual(creature, Visual.visual_creature_attachment_wing, Cre.get_wings(creature))) {
        ok = false;
    }
    if (!_update_creature_attachment_visual(creature, Visual.visual_creature_attachment_tail, Cre.get_tail(creature))) {
        ok = false;
    }
    return ok;
}

fn update_visual_by_appearance(creature: Creature, appearance: int): bool {
    return _update_visual_by_appearance(creature, appearance, true);
}

fn _visual_body_slot(slot: Item.EquipIndex): bool {
    return slot == Const.equip_index_chest || slot == Const.equip_index_head;
}

fn _rebuild_visual_after_body_slot_change(creature: Creature, slot: Item.EquipIndex) {
    if (!_visual_body_slot(slot)) {
        return;
    }
    update_visual(creature);
    NwnItem.update_creature_visual_equipment(creature);
}

fn _on_item_equipped_update_creature_visual(creature: Creature, _equipped: Item, slot: Item.EquipIndex) {
    _rebuild_visual_after_body_slot_change(creature, slot);
}

fn _on_item_unequipped_update_creature_visual(creature: Creature, _removed: Item, slot: Item.EquipIndex) {
    _rebuild_visual_after_body_slot_change(creature, slot);
}

fn _ensure_creature_visual_callbacks() {
    if (did_install_creature_visual_callbacks) {
        return;
    }

    NwnItem.add_on_equip_callback(_on_item_equipped_update_creature_visual);
    NwnItem.add_on_unequip_callback(_on_item_unequipped_update_creature_visual);
    did_install_creature_visual_callbacks = true;
}

fn _movement_rate_row(obj: Creature, raw_walkrate: int): int {
    if (raw_walkrate != 7) {
        return raw_walkrate;
    }

    var appearance = Cre.get_appearance(obj);
    if (appearance >= 0 && appearance < Appearances.count()) {
        return Appearances.get_rules(appearance).movement_rate;
    }
    return raw_walkrate;
}

fn get_base_moverate(creature: Creature): float {
    var levels = get_propset!(CreatureLevels)(creature);
    var row = _movement_rate_row(creature, levels.walkrate);
    if (row == 1) {
        return 0.0;
    }

    var result = CreatureSpeeds.get_base_moverate(row);
    if (result > 0.0) {
        return result;
    }
    return CreatureSpeeds.get_base_moverate(0);
}

fn update_movement_rate(creature: Creature): bool {
    return NativeCreature.set_movement_rate(
        creature, get_base_moverate(creature));
}

fn update_visual(creature: Creature): bool {
    _ensure_creature_visual_callbacks();
    return update_visual_by_appearance(creature, Cre.get_appearance(creature))
        && update_movement_rate(creature);
}

fn update_appearance_preview(creature: Creature, equipment_visible: bool): bool {
    _ensure_creature_visual_callbacks();
    if (!_update_visual_by_appearance(
        creature,
        Cre.get_appearance(creature),
        equipment_visible)) {
        return false;
    }
    if (!update_movement_rate(creature)) {
        return false;
    }
    return !equipment_visible || NwnItem.update_creature_visual_equipment(creature);
}

fn get_editable_colors(creature: Creature): array!(int) {
    var model = resolve_creature_model(Cre.get_appearance(creature));
    if (!model.valid || !model.humanoid) {
        var empty: array!(int) = {};
        return empty;
    }
    var values = Cre.get_colors(creature);
    for (var value in values) {
        if (value < 0 || value >= creature_color_value_count) {
            var empty: array!(int) = {};
            return empty;
        }
    }
    return values;
}

fn get_color_editor_rows(creature: Creature): array!(CreatureColorEditorRow) {
    var rows: array!(CreatureColorEditorRow) = {};
    var values = get_editable_colors(creature);
    if (arr.len(values) != Cre.color_count) {
        return rows;
    }

    var hair: CreatureColorEditorRow = {
        color = Cre.color_hair,
        label = "Hair",
        value = values[Cre.color_hair],
        palette = creature_color_palette_hair,
    };
    var skin: CreatureColorEditorRow = {
        color = Cre.color_skin,
        label = "Skin",
        value = values[Cre.color_skin],
        palette = creature_color_palette_skin,
    };
    var tattoo1: CreatureColorEditorRow = {
        color = Cre.color_tattoo1,
        label = "Tattoo 1",
        value = values[Cre.color_tattoo1],
        palette = creature_color_palette_skin,
    };
    var tattoo2: CreatureColorEditorRow = {
        color = Cre.color_tattoo2,
        label = "Tattoo 2",
        value = values[Cre.color_tattoo2],
        palette = creature_color_palette_skin,
    };
    arr.push(rows, hair);
    arr.push(rows, skin);
    arr.push(rows, tattoo1);
    arr.push(rows, tattoo2);
    return rows;
}

fn can_set_colors(creature: Creature, colors: array!(int), values: array!(int)): bool {
    var count = arr.len(colors);
    if (count <= 0 || count != arr.len(values) || count > Cre.color_count) {
        return false;
    }

    var model = resolve_creature_model(Cre.get_appearance(creature));
    if (!model.valid || !model.humanoid) {
        return false;
    }

    for (var i = 0; i < count; i += 1) {
        var color = colors[i];
        var value = values[i];
        if (color < 0 || color >= Cre.color_count
            || value < 0 || value >= creature_color_value_count) {
            return false;
        }
        for (var j = 0; j < i; j += 1) {
            if (colors[j] == color) {
                return false;
            }
        }
    }
    return true;
}

fn set_colors(creature: Creature, colors: array!(int), values: array!(int)): bool {
    if (!can_set_colors(creature, colors, values)) {
        return false;
    }

    var previous: array!(int) = {};
    arr.reserve(previous, arr.len(colors));
    var changed = false;
    for (var i = 0; i < arr.len(colors); i += 1) {
        var value = Cre.get_color(creature, colors[i]);
        arr.push(previous, value);
        if (value != values[i]) {
            changed = true;
        }
    }
    if (!changed) {
        return true;
    }

    var applied = 0;
    for (applied < arr.len(colors)) {
        if (!Cre.set_color(creature, colors[applied], values[applied])) {
            for (var rollback = 0; rollback < applied; rollback += 1) {
                Cre.set_color(creature, colors[rollback], previous[rollback]);
            }
            return false;
        }
        applied += 1;
    }

    if (update_visual(creature)
        && NwnItem.update_creature_visual_equipment(creature)) {
        return true;
    }

    for (var rollback = 0; rollback < arr.len(colors); rollback += 1) {
        Cre.set_color(creature, colors[rollback], previous[rollback]);
    }
    update_visual(creature);
    NwnItem.update_creature_visual_equipment(creature);
    return false;
}

fn set_color(creature: Creature, color: int, value: int): bool {
    var colors: array!(int) = {color};
    var values: array!(int) = {value};
    return set_colors(creature, colors, values);
}

fn _accessory_value_available(accessory: int, value: int): bool {
    if (value < 0) {
        return false;
    }
    if (value == 0) {
        return true;
    }
    return NativeCreature.accessory_exists(accessory, value);
}

fn get_editable_accessories(creature: Creature): array!(int) {
    var model = resolve_creature_model(Cre.get_appearance(creature));
    if (!model.valid) {
        var empty: array!(int) = {};
        return empty;
    }
    return Cre.get_accessories(creature);
}

fn can_set_accessories(creature: Creature, accessories: array!(int), values: array!(int)): bool {
    var count = arr.len(accessories);
    if (count <= 0 || count != arr.len(values) || count > Cre.accessory_count) {
        return false;
    }

    var model = resolve_creature_model(Cre.get_appearance(creature));
    if (!model.valid) {
        return false;
    }

    for (var i = 0; i < count; i += 1) {
        var accessory = accessories[i];
        if (accessory < 0 || accessory >= Cre.accessory_count
            || !_accessory_value_available(accessory, values[i])) {
            return false;
        }
        for (var j = 0; j < i; j += 1) {
            if (accessories[j] == accessory) {
                return false;
            }
        }
    }
    return true;
}

fn set_accessories(creature: Creature, accessories: array!(int), values: array!(int)): bool {
    if (!can_set_accessories(creature, accessories, values)) {
        return false;
    }

    var previous: array!(int) = {};
    arr.reserve(previous, arr.len(accessories));
    var changed = false;
    for (var i = 0; i < arr.len(accessories); i += 1) {
        var value = Cre.get_accessory(creature, accessories[i]);
        arr.push(previous, value);
        if (value != values[i]) {
            changed = true;
        }
    }
    if (!changed) {
        return true;
    }

    var applied = 0;
    for (applied < arr.len(accessories)) {
        if (!Cre.set_accessory(creature, accessories[applied], values[applied])) {
            for (var rollback = 0; rollback < applied; rollback += 1) {
                Cre.set_accessory(creature, accessories[rollback], previous[rollback]);
            }
            return false;
        }
        applied += 1;
    }

    if (update_visual(creature)
        && NwnItem.update_creature_visual_equipment(creature)) {
        return true;
    }

    for (var rollback = 0; rollback < arr.len(accessories); rollback += 1) {
        Cre.set_accessory(creature, accessories[rollback], previous[rollback]);
    }
    update_visual(creature);
    NwnItem.update_creature_visual_equipment(creature);
    return false;
}

fn set_accessory(creature: Creature, accessory: int, value: int): bool {
    var accessories: array!(int) = {accessory};
    var values: array!(int) = {value};
    return set_accessories(creature, accessories, values);
}

fn get_editable_body_parts(creature: Creature): array!(int) {
    return get_body_part_editor_snapshot(creature).values;
}

// Native editor protocol: one immutable snapshot per refresh. Values are
// indexed by the stable profile body-part ID. Resource labels, options, and
// model associations remain in the native catalog identified by assembly.
fn get_body_part_editor_snapshot(creature: Creature): CreatureBodyPartEditorSnapshot {
    var snapshot: CreatureBodyPartEditorSnapshot = {
        assembly = -1,
        values = {},
    };
    var model = resolve_creature_model(Cre.get_appearance(creature));
    if (!model.valid || !model.humanoid) {
        return snapshot;
    }
    snapshot.assembly = _body_part_assembly(creature, model);
    if (snapshot.assembly >= 0) {
        snapshot.values = Cre.get_body_parts(creature);
    }
    return snapshot;
}

fn get_body_part_options(creature: Creature, part: int): array!(int) {
    var options: array!(int) = {};
    var model = resolve_creature_model(Cre.get_appearance(creature));
    if (!model.valid || !model.humanoid) {
        return options;
    }

    var assembly = _body_part_assembly(creature, model);
    var count = NativeCreature.body_part_option_count(assembly, part);
    var current = Cre.get_body_part(creature, part);
    var current_added = current < 0 || current > 255;
    arr.reserve(options, count + 1);
    for (var index = 0; index < count; index += 1) {
        var value = NativeCreature.body_part_option_id_at(assembly, part, index);
        if (!current_added && current < value) {
            arr.push(options, current);
            current_added = true;
        }
        arr.push(options, value);
        if (value == current) {
            current_added = true;
        }
    }
    if (!current_added) {
        arr.push(options, current);
    }
    return options;
}

fn can_set_body_parts(creature: Creature, parts: array!(int), values: array!(int)): bool {
    var count = arr.len(parts);
    if (count <= 0 || count != arr.len(values)) {
        return false;
    }

    var model = resolve_creature_model(Cre.get_appearance(creature));
    if (!model.valid || !model.humanoid) {
        return false;
    }

    var assembly = _body_part_assembly(creature, model);
    if (assembly < 0 || count > NativeCreature.body_part_count(assembly)) {
        return false;
    }

    for (var i = 0; i < count; i += 1) {
        var part = parts[i];
        var value = values[i];
        if (NativeCreature.body_part_option_count(assembly, part) <= 0
            || value < 0 || value > 255) {
            return false;
        }
        for (var j = 0; j < i; j += 1) {
            if (parts[j] == part) {
                return false;
            }
        }
    }
    return true;
}

fn set_body_parts(creature: Creature, parts: array!(int), values: array!(int)): bool {
    if (!can_set_body_parts(creature, parts, values)) {
        return false;
    }

    var previous: array!(int) = {};
    arr.reserve(previous, arr.len(parts));
    var changed = false;
    for (var i = 0; i < arr.len(parts); i += 1) {
        var value = Cre.get_body_part(creature, parts[i]);
        arr.push(previous, value);
        if (value != values[i]) {
            changed = true;
        }
    }
    if (!changed) {
        return true;
    }

    var applied = 0;
    for (applied < arr.len(parts)) {
        if (!Cre.set_body_part(creature, parts[applied], values[applied])) {
            for (var rollback = 0; rollback < applied; rollback += 1) {
                Cre.set_body_part(creature, parts[rollback], previous[rollback]);
            }
            return false;
        }
        applied += 1;
    }

    if (update_visual(creature)
        && NwnItem.update_creature_visual_equipment(creature)) {
        return true;
    }

    for (var rollback = 0; rollback < arr.len(parts); rollback += 1) {
        Cre.set_body_part(creature, parts[rollback], previous[rollback]);
    }
    update_visual(creature);
    NwnItem.update_creature_visual_equipment(creature);
    return false;
}

fn set_body_part(creature: Creature, part: int, value: int): bool {
    var parts: array!(int) = {part};
    var values: array!(int) = {value};
    return set_body_parts(creature, parts, values);
}

fn _has_body_parts(creature: Creature): bool {
    for (var part = 0; part < Cre.body_part_segment_count; part += 1) {
        if (Cre.get_body_part(creature, part) != 0) {
            return true;
        }
    }
    return false;
}

fn _default_body_part(part: int): int {
    // Dynamic bodies use model 1; belts, shoulders, and the robe override are optional.
    if (part == Cre.body_part_belt
        || part == Cre.body_part_shoulder_left
        || part == Cre.body_part_shoulder_right
        || part == Cre.body_part_robe) {
        return 0;
    }
    return 1;
}

fn _set_default_body_parts(creature: Creature): bool {
    for (var part = 0; part < Cre.body_part_count; part += 1) {
        if (!Cre.set_body_part(creature, part, _default_body_part(part))) {
            return false;
        }
    }
    return true;
}

fn _clear_body_parts(creature: Creature) {
    for (var part = 0; part < Cre.body_part_count; part += 1) {
        Cre.set_body_part(creature, part, 0);
    }
}

fn set_appearance(creature: Creature, appearance: int): bool {
    var model = resolve_creature_model(appearance);
    if (!model.valid) {
        return false;
    }

    var state = get_propset!(CreatureAppearance)(creature);
    var previous = state.appearance;
    if (previous == appearance) {
        return true;
    }

    var initialize_body_parts = model.humanoid && !_has_body_parts(creature);
    state.appearance = appearance;
    if ((!initialize_body_parts || _set_default_body_parts(creature))
        && update_visual(creature)
        && NwnItem.update_creature_visual_equipment(creature)) {
        return true;
    }

    state.appearance = previous;
    if (initialize_body_parts) {
        _clear_body_parts(creature);
    }
    update_visual(creature);
    NwnItem.update_creature_visual_equipment(creature);
    return false;
}

// == Const.Ability scores ==========================================================
// ============================================================================

// Const.Ability score: base=true returns score without temporary effects (includes
// racial adjustments and permanent modifiers); base=false also adds effects.
fn _compute_ability_scores(obj: Creature, combat: CreatureCombat) {
    var stats = get_propset!(CreatureStats)(obj);
    for (var i = 0; i < 6; i += 1) {
        var score = stats.abilities[i];
        score = score + races.ability_modifier(stats.race, i);
        score = score + Mod.sum_modifiers(obj, Const.mod_type_ability, i, O.invalid);
        var bonus = Comb.aggregate_effect_int(obj, Const.effect_type_ability_increase, i, O.invalid, 0, stack_sum);
        var decrease = Comb.aggregate_effect_int(obj, Const.effect_type_ability_decrease, i, O.invalid, 0, stack_sum);
        combat.ability_scores[i] = score + Math.clamp(bonus - decrease, -12, 12);
    }
    combat.ability_cache_valid = true;
    combat.ability_cache_effect_epoch = combat.effect_epoch;
    combat.ability_cache_progression_epoch = combat.progression_epoch;
}

fn get_ability_score(obj: Creature, ability: Const.Ability, base: bool = false): int {
    if (base) {
        var stats = get_propset!(CreatureStats)(obj);
        var score = stats.abilities[ability as int];
        score = score + races.ability_modifier(stats.race, ability as int);
        score = score + Mod.sum_modifiers(obj, Const.mod_type_ability, ability as int, O.invalid);
        return score;
    }

    var combat = get_propset!(CreatureCombat)(obj);
    var progression_epoch = Cre.progression_version(obj);
    var effect_epoch = NativeCombat.creature_effect_version(obj);
    if (!combat.ability_cache_valid
        || combat.ability_cache_effect_epoch != effect_epoch
        || combat.ability_cache_progression_epoch != progression_epoch) {
        combat.effect_epoch = effect_epoch;
        combat.progression_epoch = progression_epoch;
        _compute_ability_scores(obj, combat);
    }
    return combat.ability_scores[ability as int];
}

fn get_ability_modifier(obj: Creature, ability: Const.Ability, base: bool = false): int {
    return (get_ability_score(obj, ability, base) - 10) / 2;
}

// Legacy NWN1/toolset CR approximation. Kept here so the approximation reads
// Smalls-owned creature state instead of C++ mirrors.
fn _challenge_rating_class_average_hitpoints(obj: Creature): float {
    var result = 0.0;
    var class_count = Cre.get_class_count(obj);
    for (var i = 0; i < class_count; i += 1) {
        var cl = Cre.get_class_at(obj, i);
        var levels = Cre.get_class_levels_at(obj, i);
        var hit_die = Classes.hit_die(cl);
        if (hit_die > 0 && levels > 0) {
            result += (levels as float) * (((hit_die + 1) as float) / 2.0);
        }
    }
    return result;
}

fn _challenge_rating_equipment_value(obj: Creature): float {
    var result = 0.0;
    var slot = 0;
    var stop = Const.equip_index_creature_left as int;
    for (slot < stop) {
        var equipped = Item.get_equipped_item(obj, Item.EquipIndex(slot));
        if (equipped != O.invalid) {
            result += NwnItem.calculate_value(equipped) as float;
        }
        slot += 1;
    }
    return result;
}

fn _challenge_rating_special_ability_levels(stats: CreatureStats): float {
    var result = 0.0;
    for (var ability in stats.special_abilities) {
        var innate = Spells.innate_level(ability.spell);
        if (innate > 0) {
            result += innate as float;
        } else {
            result += 0.5;
        }
    }
    return result;
}

fn _challenge_rating_total_spell_levels(obj: Creature): float {
    var result = 0.0;
    var count = NativeCreature.get_ability_loadout_count(obj);
    for (var i = 0; i < count; i += 1) {
        var ability = NativeCreature.get_ability_loadout_ability(obj, i);
        if (ability < 0) { continue; }

        var innate = Spells.innate_level(Spell(ability));
        if (innate > 0) {
            result += innate as float;
        } else {
            result += 0.5;
        }
    }
    return result;
}

fn _challenge_rating_class_save_bonus(obj: Creature, save_type: Const.Save): int {
    var result = 0;
    var class_count = Cre.get_class_count(obj);
    for (var i = 0; i < class_count; i += 1) {
        result += Classes.save_bonus(
            Cre.get_class_at(obj, i),
            Cre.get_class_levels_at(obj, i),
            save_type);
    }
    return result;
}

fn _challenge_rating_feat_value(feat: int): float {
    _ensure_feats_loaded();
    if (feat < 0 || feat >= arr.len(_feats)) {
        return 0.0;
    }

    var entry = arr.get(_feats, feat);
    if (entry.id != feat) {
        return 0.0;
    }
    return entry.cr_value;
}

fn _challenge_rating_feat_values(stats: CreatureStats): float {
    var result = 0.0;
    for (var feat in stats.feats) {
        result += _challenge_rating_feat_value(feat);
    }
    return result;
}

fn calculate_challenge_rating(obj: Creature): float {
    var hd = Cre.get_total_levels(obj);
    if (hd <= 0) { return 0.0; }

    var stats = get_propset!(CreatureStats)(obj);
    var health = get_propset!(CreatureHealth)(obj);
    var levels = get_propset!(CreatureLevels)(obj);
    var hd_f = hd as float;

    var base_cr = hd_f * 0.15;
    var natural_ac_cr = (stats.ac_natural_bonus as float) * 0.1;

    var inventory_value = _challenge_rating_equipment_value(obj);
    var inventory_cr = (inventory_value / (hd_f * 20000.0 + 100000.0)) * 0.2 * hd_f;

    var walkrate_row = _movement_rate_row(obj, levels.walkrate);
    var walkrate = CreatureSpeeds.get_base_moverate(walkrate_row);
    var player_walkrate = CreatureSpeeds.get_base_moverate(0);
    var average_hitpoints = _challenge_rating_class_average_hitpoints(obj);
    if (walkrate == 0.0 || player_walkrate == 0.0 || average_hitpoints == 0.0) {
        return 0.0;
    }

    var hitpoint_cr = ((health.hp as float) / average_hitpoints) * 0.2 * hd_f * (walkrate / player_walkrate);

    var ability_total = 0;
    for (var i = 0; i < 6; i += 1) {
        ability_total += stats.abilities[i];
    }
    var ability_cr = ((ability_total as float) / (hd_f + 50.0)) * 0.1 * hd_f;

    var special_ability_levels = _challenge_rating_special_ability_levels(stats);
    var specabil_cr = (special_ability_levels / (hd_f * (hd_f + 1.0) + (hd_f * 5.0))) * 0.15 * hd_f;

    var total_spell_levels = _challenge_rating_total_spell_levels(obj);
    var spells_cr = (total_spell_levels / (hd_f * (hd_f + 1.0))) * 0.15 * hd_f;

    var bonus_saves = stats.save_fort + stats.save_reflex + stats.save_will;
    var base_saves = get_saving_throw(obj, Const.saving_throw_fort)
        + _challenge_rating_class_save_bonus(obj, Const.saving_throw_fort)
        + get_saving_throw(obj, Const.saving_throw_reflex)
        + _challenge_rating_class_save_bonus(obj, Const.saving_throw_reflex)
        + get_saving_throw(obj, Const.saving_throw_will)
        + _challenge_rating_class_save_bonus(obj, Const.saving_throw_will);
    base_saves -= bonus_saves;

    var saves_cr = 0.15 * hd_f;
    if (base_saves > 0) {
        saves_cr *= (bonus_saves + base_saves) as float / (base_saves as float);
    }

    var total_feat_values = _challenge_rating_feat_values(stats);
    var feat_cr = (total_feat_values / (hd_f * 0.5 + 7.0)) * 0.1 * hd_f;

    var additive_cr = base_cr
        + natural_ac_cr
        + inventory_cr
        + hitpoint_cr
        + ability_cr
        + specabil_cr
        + spells_cr
        + saves_cr
        + feat_cr;

    var race_modifier = races.cr_modifier(stats.race);
    if (race_modifier == 0.0) { return 0.0; }
    additive_cr *= race_modifier;

    if (additive_cr < 1.5) {
        if (additive_cr > 0.75) {
            additive_cr -= 0.35;
        } else {
            additive_cr -= 0.25;
        }
    }

    additive_cr += stats.cr_adjust as float;

    if (additive_cr > 0.75) {
        return Math.round(additive_cr);
    }
    return FractionalCr.resolve(additive_cr);
}

fn get_spell_dc(obj: Creature, class_: Class, spell: Spell): int {
    var caster_ability = Classes.caster_ability(class_);
    var innate_level = Spells.innate_level(spell);
    var school = Spells.school(spell);
    if ((caster_ability as int) < 0 || innate_level < 0 || (school as int) < 0) {
        return 0;
    }

    var result = 10 + innate_level;
    result = result + get_ability_modifier(obj, caster_ability);
    result = result + mfeat.resolve(obj, Const.mfeat_spell_focus, school);
    result = result + mfeat.resolve(obj, Const.mfeat_spell_focus_greater, school);
    result = result + mfeat.resolve(obj, Const.mfeat_spell_focus_epic, school);
    return result;
}

fn get_caster_level(obj: Creature, class_: Class): int {
    if (!Classes.spellcaster(class_)) {
        return 0;
    }

    var result = Cre.get_level_by_class(obj, class_);
    if (result == 0) {
        return 0;
    }

    var main_arcane = Classes.arcane(class_);
    var class_count = Cre.get_class_count(obj);
    for (var i = 0; i < class_count; i = i + 1) {
        var class_id = Cre.get_class_at(obj, i);
        if ((class_id as int) < 0) {
            break;
        }
        if (class_id == class_) {
            continue;
        }

        var class_levels = Cre.get_class_levels_at(obj, i);
        if (main_arcane) {
            var mod = Classes.arcane_spellgain_mod(class_id);
            if (mod > 0) {
                result = result + class_levels / mod;
            }
        } else {
            var mod = Classes.divine_spellgain_mod(class_id);
            if (mod > 0) {
                result = result + class_levels / mod;
            }
        }
    }

    return result;
}

fn get_available_spell_uses(obj: Creature, class_: Class, spell: Spell, min_spell_level: int = 0, meta: int = -1): int {
    if (!Classes.spellcaster(class_) || (spell as int) < 0 || min_spell_level < 0) {
        return 0;
    }

    var result = 0;
    var class_id = class_ as int;
    var spell_id = spell as int;
    var count = NativeCreature.get_ability_loadout_count(obj);

    for (var i = 0; i < count; i = i + 1) {
        if (NativeCreature.get_ability_loadout_slot(obj, i) < 0) { continue; }
        if (NativeCreature.get_ability_loadout_source(obj, i) != class_id) { continue; }
        if (NativeCreature.get_ability_loadout_tier(obj, i) < min_spell_level) { continue; }
        if (NativeCreature.get_ability_loadout_ability(obj, i) != spell_id) { continue; }
        if (meta != Metamagic.metamagic_any && NativeCreature.get_ability_loadout_modifier(obj, i) != meta) { continue; }
        result = result + 1;
    }

    return result;
}

fn effective_spell_level(class_: Class, spell: Spell, meta: int): int {
    return Metamagic.effective_spell_level(class_, spell, meta);
}

fn _unslotted_spell_tier_count(obj: Creature, class_: Class, spell_level: int): int {
    var result = 0;
    var class_id = class_ as int;
    var count = NativeCreature.get_ability_loadout_count(obj);
    for (var i = 0; i < count; i = i + 1) {
        if (NativeCreature.get_ability_loadout_slot(obj, i) >= 0) { continue; }
        if (NativeCreature.get_ability_loadout_source(obj, i) != class_id) { continue; }
        if (NativeCreature.get_ability_loadout_tier(obj, i) != spell_level) { continue; }
        result = result + 1;
    }
    return result;
}

fn _available_spell_slot_count(obj: Creature, class_: Class, spell_level: int): int {
    var result = 0;
    var class_id = class_ as int;
    var count = NativeCreature.get_ability_loadout_count(obj);
    for (var i = 0; i < count; i = i + 1) {
        if (NativeCreature.get_ability_loadout_slot(obj, i) < 0) { continue; }
        if (NativeCreature.get_ability_loadout_source(obj, i) != class_id) { continue; }
        if (NativeCreature.get_ability_loadout_tier(obj, i) != spell_level) { continue; }
        if (NativeCreature.get_ability_loadout_ability(obj, i) >= 0) { continue; }
        result = result + 1;
    }
    return result;
}

fn _bonus_spell_slot_count(obj: Creature, class_: Class, spell_level: int): int {
    var result = 0;
    var count = NativeCombat.object_effect_count(obj);
    for (var i = 0; i < count; i = i + 1) {
        var effect = NativeCombat.object_effect_at(obj, i);
        if (!Effects.is_valid(effect)) { continue; }
        if (Effects.get_type(effect) != (Const.effect_type_bonus_spell_of_level as int)) { continue; }
        if (Effects.get_subtype(effect) != (class_ as int)) { continue; }
        if (Effects.get_int(effect, 0) != spell_level) { continue; }
        result = result + 1;
    }
    return result;
}

fn compute_total_spell_slots(obj: Creature, class_: Class, spell_level: int): int {
    if (!Classes.spellcaster(class_)) {
        return 0;
    }

    var class_level = get_caster_level(obj, class_);
    if (class_level <= 0) {
        return 0;
    }

    var result = Classes.spells_gained(class_, class_level, spell_level);
    if (result <= 0) {
        return 0;
    }

    if (spell_level <= get_ability_modifier(obj, Classes.caster_ability(class_))) {
        result = result + 1;
    }

    result = result + _bonus_spell_slot_count(obj, class_, spell_level);
    return result;
}

fn compute_total_spells_knowable(obj: Creature, class_: Class, spell_level: int): int {
    if (!Classes.spellcaster(class_)) {
        return 0;
    }

    return Classes.spells_known(class_, get_caster_level(obj, class_), spell_level);
}

fn get_available_spell_slots(obj: Creature, class_: Class, spell_level: int): int {
    if (!Classes.spellcaster(class_)) {
        return 0;
    }

    if (!Classes.memorizes_spells(class_)) {
        return compute_total_spell_slots(obj, class_, spell_level);
    }

    return _available_spell_slot_count(obj, class_, spell_level);
}

fn recompute_all_available_spell_slots(obj: Creature) {
    var class_count = Cre.get_class_count(obj);
    for (var i = 0; i < class_count; i = i + 1) {
        var class_ = Cre.get_class_at(obj, i);
        if ((class_ as int) < 0) {
            break;
        }
        if (!Classes.memorizes_spells(class_)) {
            continue;
        }

        for (var tier = 0; tier < Classes.spell_progression_tier_count; tier = tier + 1) {
            NativeCreature.set_slotted_ability_count(obj, class_, tier, compute_total_spell_slots(obj, class_, tier));
        }
    }
}

fn can_add_known_spell(obj: Creature, class_: Class, spell: Spell): bool {
    if (!Classes.spellcaster(class_)) {
        return false;
    }

    var class_level = Cre.get_level_by_class(obj, class_);
    if ((spell as int) < 0 || class_level == 0) {
        return false;
    }

    var spell_level = Classes.spell_level(class_, spell);
    if (spell_level < 0) {
        return false;
    }

    if (!Classes.memorizes_spells(class_)) {
        var can_know = Classes.spells_known(class_, class_level, spell_level);
        var do_know = _unslotted_spell_tier_count(obj, class_, spell_level);
        if (can_know <= 0 || do_know >= can_know) {
            return false;
        }
    }

    return true;
}

fn add_known_spell(obj: Creature, class_: Class, spell: Spell): bool {
    if (!can_add_known_spell(obj, class_, spell)) {
        return false;
    }

    var spell_level = Classes.spell_level(class_, spell);
    if (spell_level < 0) {
        return false;
    }
    return NativeCreature.add_unslotted_ability(obj, class_, spell_level, spell);
}

fn add_memorized_spell(obj: Creature, class_: Class, spell: Spell, meta: int): bool {
    if (!Classes.spellcaster(class_) || !Classes.memorizes_spells(class_)) {
        return false;
    }

    if (meta == Metamagic.metamagic_any) {
        meta = Metamagic.metamagic_none;
    }

    var spell_level = Metamagic.effective_spell_level(class_, spell, meta);
    if (spell_level < 0) {
        return false;
    }

    if (NativeCreature.available_ability_slots(obj, class_, spell_level) == 0) {
        return false;
    }
    return NativeCreature.add_slotted_ability(obj, class_, spell_level, spell, meta, spell_flag_readied);
}

fn get_memorized_spell_uses(obj: Creature, class_: Class, spell: Spell, meta: int): int {
    if (!Classes.spellcaster(class_) || !Classes.memorizes_spells(class_)) {
        return 0;
    }
    if (meta == Metamagic.metamagic_any) {
        meta = Metamagic.metamagic_none;
    }
    var spell_level = Metamagic.effective_spell_level(class_, spell, meta);
    if (spell_level < 0) {
        return 0;
    }
    return get_available_spell_uses(obj, class_, spell, spell_level, meta);
}

fn get_memorized_spell_editor_value(obj: Creature, class_: Class, spell: Spell, meta: int): int {
    if (Cre.get_level_by_class(obj, class_) <= 0
        || !Classes.spellcaster(class_)
        || !Classes.memorizes_spells(class_)
        || Metamagic.effective_spell_level(class_, spell, meta) < 0) {
        return -1;
    }
    return get_memorized_spell_uses(obj, class_, spell, meta);
}

fn remove_memorized_spell(obj: Creature, class_: Class, spell: Spell, meta: int): bool {
    if (!Classes.spellcaster(class_) || !Classes.memorizes_spells(class_)) {
        return false;
    }

    if (meta == Metamagic.metamagic_any) {
        meta = Metamagic.metamagic_none;
    }

    var spell_level = Metamagic.effective_spell_level(class_, spell, meta);
    if (spell_level < 0) {
        return false;
    }
    return NativeCreature.remove_slotted_ability(obj, class_, spell_level, spell, meta);
}

fn set_memorized_spell_slot(obj: Creature, class_: Class, spell: Spell, meta: int,
    spell_level: int, slot: int, flags: int, assigned: bool): bool {
    if (Cre.get_level_by_class(obj, class_) <= 0
        || !Classes.spellcaster(class_)
        || !Classes.memorizes_spells(class_)
        || slot < 0 || flags < 0 || flags > 255) {
        return false;
    }
    if (meta == Metamagic.metamagic_any) {
        meta = Metamagic.metamagic_none;
    }
    var effective_level = Metamagic.effective_spell_level(class_, spell, meta);
    if (effective_level < 0 || effective_level > spell_level || spell_level >= 10) {
        return false;
    }
    if (assigned) {
        return NativeCreature.set_slotted_ability(obj, class_, spell_level, slot, spell, meta, flags);
    }
    return NativeCreature.clear_slotted_ability(obj, class_, spell_level, slot, spell, meta, flags);
}

fn remove_known_spell(obj: Creature, class_: Class, spell: Spell): bool {
    if ((class_ as int) < 0 || (spell as int) < 0
        || Cre.get_level_by_class(obj, class_) <= 0) {
        return false;
    }

    var spell_level = Classes.spell_level(class_, spell);
    if (spell_level < 0 || !get_knows_spell(obj, class_, spell)) {
        return false;
    }
    NativeCreature.remove_unslotted_ability(obj, class_, spell_level, spell);
    NativeCreature.clear_slotted_ability_from_tier(obj, class_, spell_level, spell);
    return true;
}

fn get_knows_spell(obj: Creature, class_: Class, spell: Spell): bool {
    if (!Classes.spellcaster(class_)) {
        return false;
    }

    var spell_level = Classes.spell_level(class_, spell);
    if (spell_level < 0) {
        return false;
    }
    if (!Classes.spellbook_restricted(class_)) {
        return true;
    }

    var class_id = class_ as int;
    var spell_id = spell as int;
    var count = NativeCreature.get_ability_loadout_count(obj);
    for (var i = 0; i < count; i = i + 1) {
        if (NativeCreature.get_ability_loadout_slot(obj, i) >= 0) { continue; }
        if (NativeCreature.get_ability_loadout_source(obj, i) != class_id) { continue; }
        if (NativeCreature.get_ability_loadout_tier(obj, i) != spell_level) { continue; }
        if (NativeCreature.get_ability_loadout_ability(obj, i) == spell_id) {
            return true;
        }
    }
    return false;
}

fn get_known_spell_editor_value(obj: Creature, class_: Class, spell: Spell): int {
    if (Cre.get_level_by_class(obj, class_) <= 0
        || !Classes.spellcaster(class_)
        || Classes.memorizes_spells(class_)
        || Classes.spell_level(class_, spell) < 0) {
        return -1;
    }
    return get_knows_spell(obj, class_, spell) ? 1 : 0;
}

fn get_spell_class_editor_rows(obj: Creature): array!(CreatureSpellClassEditorRow) {
    var rows: array!(CreatureSpellClassEditorRow) = {};
    var count = Cre.get_class_count(obj);
    arr.reserve(rows, count);
    for (var i = 0; i < count; i += 1) {
        var class_ = Cre.get_class_at(obj, i);
        if (!Classes.spellcaster(class_)) {
            continue;
        }
        var row: CreatureSpellClassEditorRow = {
            class_id = class_ as int,
            name_strref = Classes.name_strref(class_) as int,
            memorizes = Classes.memorizes_spells(class_),
        };
        arr.push(rows, row);
    }
    return rows;
}

fn get_spell_metamagic_editor_rows(obj: Creature): array!(CreatureSpellMetamagicEditorRow) {
    var rows: array!(CreatureSpellMetamagicEditorRow) = {};
    var count = Metamagic.count();
    arr.reserve(rows, count);
    for (var index = 0; index < count; index += 1) {
        var code = Metamagic.code_for_row(index);
        var feat = Metamagic.feat(code);
        if (code < 0 || (feat >= 0 && !Cre.has_feat(obj, Feat(feat)))) {
            continue;
        }
        var row: CreatureSpellMetamagicEditorRow = {
            code = code,
            name_strref = Metamagic.name_strref(code) as int,
        };
        arr.push(rows, row);
    }
    return rows;
}

fn get_spell_editor_rows(obj: Creature, class_: Class, meta: int): array!(CreatureSpellEditorRow) {
    var rows: array!(CreatureSpellEditorRow) = {};
    if (Cre.get_level_by_class(obj, class_) <= 0 || !Classes.spellcaster(class_)) {
        return rows;
    }

    var memorizes = Classes.memorizes_spells(class_);
    var restricted = Classes.spellbook_restricted(class_);
    var spell_table = Classes.spell_table(class_);
    if (spell_table < 0) {
        return rows;
    }

    var level_adjustment = 0;
    if (meta != Metamagic.metamagic_none && meta != Metamagic.metamagic_any) {
        if (!Metamagic.is_specific_code(meta)) {
            return rows;
        }
        level_adjustment = Metamagic.level_adjustment(meta);
    }

    var count = Spells.count();
    arr.reserve(rows, count);
    var row_indices: array!(int) = {};
    arr.reserve(row_indices, count);
    for (var spell_id = 0; spell_id < count; spell_id += 1) {
        var spell = Spell(spell_id);
        var base_level = Spells.class_level(spell, spell_table);
        var level = base_level + level_adjustment;
        if (base_level < 0 || level < 0 || level >= Classes.spell_progression_tier_count) {
            arr.push(row_indices, -1);
            continue;
        }
        arr.push(row_indices, arr.len(rows));
        var row: CreatureSpellEditorRow = {
            spell = spell_id,
            level = level,
            uses = 0,
            known = !restricted,
        };
        arr.push(rows, row);
    }

    var class_id = class_ as int;
    var loadout_count = NativeCreature.get_ability_loadout_count(obj);
    for (var index = 0; index < loadout_count; index += 1) {
        if (NativeCreature.get_ability_loadout_source(obj, index) != class_id) { continue; }
        var spell_id = NativeCreature.get_ability_loadout_ability(obj, index);
        if (spell_id < 0 || spell_id >= count) { continue; }
        var row_index = arr.get(row_indices, spell_id);
        if (row_index < 0) { continue; }

        var row = arr.get(rows, row_index);
        var slot = NativeCreature.get_ability_loadout_slot(obj, index);
        if (slot < 0) {
            if (restricted
                && NativeCreature.get_ability_loadout_tier(obj, index) == row.level - level_adjustment) {
                row.known = true;
                arr.set(rows, row_index, row);
            }
            continue;
        }
        if (memorizes
            && NativeCreature.get_ability_loadout_tier(obj, index) >= row.level
            && NativeCreature.get_ability_loadout_modifier(obj, index) == meta) {
            row.uses += 1;
            arr.set(rows, row_index, row);
        }
    }
    return rows;
}

fn get_monk_ability_level(obj: Creature): int {
    return Cre.get_level_by_class(obj, Const.class_type_monk);
}

fn _is_monk_weapon_base_item(base_item: BaseItemType): bool {
    if (base_item == Const.base_item_invalid) {
        return true;
    }

    return base_item == Const.base_item_kama
        || base_item == Const.base_item_quarterstaff
        || base_item == Const.base_item_shuriken
        || base_item == Const.base_item_gloves
        || base_item == Const.base_item_bracer;
}

fn weapon_for_attack(obj: Creature, attack_type: Const.AttackType): Item {
    var attack = attack_type as int;
    if (attack == Const.attack_type_onhand) { return Item.get_equipped_item(obj, Const.equip_index_righthand); }
    if (attack == Const.attack_type_offhand) { return Item.get_equipped_item(obj, Const.equip_index_lefthand); }
    if (attack == Const.attack_type_unarmed) { return Item.get_equipped_item(obj, Const.equip_index_arms); }
    if (attack == Const.attack_type_cweapon1) { return Item.get_equipped_item(obj, Const.equip_index_creature_bite); }
    if (attack == Const.attack_type_cweapon2) { return Item.get_equipped_item(obj, Const.equip_index_creature_left); }
    if (attack == Const.attack_type_cweapon3) { return Item.get_equipped_item(obj, Const.equip_index_creature_right); }
    return O.invalid as Item;
}

fn attack_sequence_index(obj: Creature, attack_type: Const.AttackType): int {
    var combat = get_propset!(CreatureCombat)(obj);
    if (attack_type == Const.attack_type_offhand) {
        return combat.attack_current - combat.attacks_onhand - combat.attacks_extra;
    }
    return combat.attack_current;
}

fn weapon_iteration_for_attack(obj: Creature, attack_type: Const.AttackType): int {
    var weapon = weapon_for_attack(obj, attack_type);
    var base_item = NwnItem.get_baseitem_type(weapon);
    if (get_monk_ability_level(obj) > 0 && _is_monk_weapon_base_item(base_item)) {
        return 3;
    }
    return 5;
}

fn ac_armor_base(obj: Creature): int {
    Equipment.sync_equipment_armor_class(obj);
    return get_propset!(CreatureCombat)(obj).ac_armor_base;
}

fn creature_size(obj: Creature): int {
    return CreatureSize.creature_size(obj);
}

fn get_dex_modifier(obj: Creature): int {
    var result = get_ability_modifier(obj, Const.ability_dexterity);
    var chest = Item.get_equipped_item(obj, Const.equip_index_chest);
    if (chest == O.invalid) { return result; }

    var stats = get_propset!(ItemStats)(chest);
    if (stats.armor_id != -1 && stats.armor_dex_bonus_valid != 0) {
        return Math.min(result, stats.armor_dex_bonus);
    }
    return result;
}

// == Saving throws ===========================================================
// ============================================================================

// Base saving throw: innate save + ability modifier (no class bonuses, no effects)
fn get_saving_throw(obj: Creature, save_type: Const.Save): int {
    var stats = get_propset!(CreatureStats)(obj);
    if (save_type == Const.saving_throw_fort) {
        return stats.save_fort + get_ability_modifier(obj, Const.ability_constitution);
    } elif (save_type == Const.saving_throw_reflex) {
        return stats.save_reflex + get_ability_modifier(obj, Const.ability_dexterity);
    } elif (save_type == Const.saving_throw_will) {
        return stats.save_will + get_ability_modifier(obj, Const.ability_wisdom);
    }
    return 0;
}

// == Skills ==================================================================
// ============================================================================

// Const.Skill rank from propset
fn get_skill_rank(obj: Creature, skill: Const.Skill): int {
    var stats = get_propset!(CreatureStats)(obj);
    return stats.skills[skill as int];
}

// Full skill rank: rank + ability modifier (if trained or skill is untrained-accessible)
// + permanent modifiers + effects.
fn get_skill_rank_full(obj: Creature, skill: Const.Skill, versus: object): int {
    var rank = get_skill_rank(obj, skill);
    if (rank > 0 || Skills.is_untrained(skill)) {
        const ability = Skills.key_ability(skill);
        if ((ability as int) >= 0) {
            rank += get_ability_modifier(obj, ability);
        }
    }

    // Master feats + permanent modifiers (feats, etc.)
    rank += mfeat.resolve(obj, Const.mfeat_skill_focus, skill);
    rank += mfeat.resolve(obj, Const.mfeat_skill_focus_epic, skill);
    rank += Mod.sum_modifiers(obj, Const.mod_type_skill, skill as int, versus);

    // Effects
    const eff_inc = Comb.aggregate_effect_int(obj, Const.effect_type_skill_increase, skill as int, versus, 0, 0);
    const eff_dec = Comb.aggregate_effect_int(obj, Const.effect_type_skill_decrease, skill as int, versus, 0, 0);

    return rank + Math.clamp(eff_inc - eff_dec, -20, 20);
}

// Skill check: rank + 20 < dc => impossible; else rank + d20 >= dc => success.
fn resolve_skill_check(obj: Creature, skill: Const.Skill, dc: int, versus: object): bool {
    var rank = get_skill_rank_full(obj, skill, versus);
    if (rank + 20 < dc) { return false; }
    return rank + NativeCombat.roll_uniform_int(1, 20) >= dc;
}

// == Special Abilities =======================================================
// ============================================================================

fn _sa_find(stats: CreatureStats, spell: Spell): int {
    var i = 0;
    var n = arr.len(stats.special_abilities);
    for (i < n) {
        if (arr.get(stats.special_abilities, i).spell == spell) { return i; }
        i = i + 1;
    }
    return -1;
}

fn _sa_swap_pop(stats: CreatureStats, idx: int) {
    var last = arr.len(stats.special_abilities) - 1;
    if (idx != last) {
        arr.set(stats.special_abilities, idx, arr.get(stats.special_abilities, last));
    }
    arr.pop(stats.special_abilities);
}

fn has_special_ability(obj: Creature, spell: Spell): bool {
    var stats = get_propset!(CreatureStats)(obj);
    return _sa_find(stats, spell) >= 0;
}

fn get_special_ability(obj: Creature, spell: Spell): SpecialAbility {
    var stats = get_propset!(CreatureStats)(obj);
    var idx = _sa_find(stats, spell);
    if (idx >= 0) {
        return arr.get(stats.special_abilities, idx);
    }
    return SpecialAbility { spell = spell, uses = 0, level = 0 };
}

fn remove_special_ability(obj: Creature, spell: Spell) {
    var stats = get_propset!(CreatureStats)(obj);
    var idx = _sa_find(stats, spell);
    if (idx < 0) { return; }
    _sa_swap_pop(stats, idx);
}

fn set_special_ability(obj: Creature, sa: SpecialAbility) {
    var stats = get_propset!(CreatureStats)(obj);
    var idx = _sa_find(stats, sa.spell);
    if (sa.uses <= 0) {
        if (idx >= 0) {
            _sa_swap_pop(stats, idx);
        }
        return;
    }
    var eff_level = sa.level;
    if (Spells.user_type(sa.spell) == 1 && eff_level < 1) { eff_level = 1; }
    var clamped = Math.clamp(eff_level, 0, 15);
    var entry = SpecialAbility { spell = sa.spell, uses = 1, level = clamped };
    if (idx >= 0) {
        arr.set(stats.special_abilities, idx, entry);
    } else {
        arr.push(stats.special_abilities, entry);
    }
}
