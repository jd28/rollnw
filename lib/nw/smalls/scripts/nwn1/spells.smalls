from nwn1.rules import { SpellEntry, StrRef };
from core.types import { Spell, SpellSchool };

import core.array as Array;
import core.string as String;
import nwn1.spellschools as SpellSchools;

var _loaded = false;
var _spells: array!(SpellEntry);

const class_spell_table_count = 6;

fn _ensure_loaded() {
    if (_loaded) {
        return;
    }

    SpellSchools.init();
    var source = load_config!(SpellEntry)("nwn1.data.spells");
    var resolved: array!(SpellEntry) = {};
    Array.reserve(resolved, Array.len(source));
    for (var spell_id = 0; spell_id < Array.len(source); spell_id += 1) {
        var spell = Array.get(source, spell_id);
        if (spell.id == spell_id) {
            var letter = String.to_lower(spell.school_letter);
            var match = -1;
            var matches = 0;
            for (var school_id = 0; school_id < SpellSchools.count(); school_id += 1) {
                var school = SpellSchools.entry(school_id);
                if (school.id == school_id
                    && letter != ""
                    && String.to_lower(school.letter) == letter) {
                    match = school_id;
                    matches += 1;
                }
            }
            if (matches == 1) {
                spell.school = match;
            } else {
                spell.school = -1;
                warn(f"spell {spell_id} has missing or duplicate school letter '{spell.school_letter}'");
            }
        }
        Array.push(resolved, spell);
    }
    _spells = resolved;
    _loaded = true;
}

fn init(): bool {
    _ensure_loaded();
    return _loaded;
}

fn count(): int {
    _ensure_loaded();
    return Array.len(_spells);
}

fn exists(spell: Spell): bool {
    _ensure_loaded();
    var index = spell as int;
    return index >= 0
        && index < Array.len(_spells)
        && Array.get(_spells, index).id == index;
}

// Returns the innate level of the spell, or -1 if invalid.
fn innate_level(spell: Spell): int {
    if (!exists(spell)) {
        return -1;
    }
    return Array.get(_spells, spell as int).innate_level;
}

// Returns the spell school, or SpellSchool(-1) if invalid.
fn school(spell: Spell): SpellSchool {
    if (!exists(spell)) {
        return SpellSchool(-1);
    }
    return SpellSchool(Array.get(_spells, spell as int).school);
}

fn name_strref(spell: Spell): StrRef {
    if (!exists(spell)) {
        return StrRef(-1);
    }
    return Array.get(_spells, spell as int).name_strref;
}

// Returns the user_type field of a spell (0 if invalid).
fn user_type(spell: Spell): int {
    if (!exists(spell)) {
        return 0;
    }
    return Array.get(_spells, spell as int).user_type;
}

// Returns this spell's level in one of the class spell tables, or -1 if absent.
fn class_level(spell: Spell, class_spell_table: int): int {
    if (!exists(spell) || class_spell_table < 0 || class_spell_table >= class_spell_table_count) {
        return -1;
    }
    return Array.get(_spells, spell as int).class_levels[class_spell_table];
}
