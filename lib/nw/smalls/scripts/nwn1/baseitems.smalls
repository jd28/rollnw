from nwn1.rules import { BaseItemDefinition, BaseItemRules };
from core.item import {
    BaseItemInfo,
    BaseItemType,
    publish_baseitem_info,
};
from core.types import { DiceRoll };

import core.array as Array;
import core.object as O;
import nwn1.requirements as Requirements;

var _loaded = false;
var _infos: array!(BaseItemInfo);
var _rules: array!(BaseItemRules);
var _valid: array!(bool);

fn _ensure_loaded(): bool {
    if (_loaded) {
        return true;
    }

    var definitions = load_config!(BaseItemDefinition)("nwn1.data.baseitems");
    var infos: array!(BaseItemInfo) = {};
    var rules: array!(BaseItemRules) = {};
    var valid: array!(bool) = {};
    for (var index = 0; index < Array.len(definitions); index += 1) {
        var definition = Array.get(definitions, index);
        if (definition.id == index) {
            Array.push(infos, definition.info);
            Array.push(rules, definition.rules);
            Array.push(valid, true);
        } else {
            var invalid_info: BaseItemInfo;
            var invalid_rules: BaseItemRules;
            Array.push(infos, invalid_info);
            Array.push(rules, invalid_rules);
            Array.push(valid, false);
        }
    }

    if (!publish_baseitem_info(infos)) {
        return false;
    }

    _infos = infos;
    _rules = rules;
    _valid = valid;
    _loaded = true;
    return true;
}

fn _is_valid_index(index: int): bool {
    _ensure_loaded();
    return index >= 0
        && index < Array.len(_valid)
        && Array.get(_valid, index);
}

fn _get_info(index: int): BaseItemInfo {
    if (_is_valid_index(index)) {
        return Array.get(_infos, index);
    }

    var invalid: BaseItemInfo;
    return invalid;
}

fn _get_rules(index: int): BaseItemRules {
    if (_is_valid_index(index)) {
        return Array.get(_rules, index);
    }

    var invalid: BaseItemRules;
    return invalid;
}

fn init(): bool {
    return _ensure_loaded();
}

fn count(): int {
    _ensure_loaded();
    return Array.len(_valid);
}

fn exists(base_item: BaseItemType): bool {
    return _is_valid_index(base_item as int);
}

fn get_info(base_item: BaseItemType): BaseItemInfo {
    return _get_info(base_item as int);
}

fn get_rules(base_item: BaseItemType): BaseItemRules {
    return _get_rules(base_item as int);
}

fn requirements_met(creature: Creature, base_item: BaseItemType): bool {
    if ((creature as object) == O.invalid) {
        return false;
    }

    var index = base_item as int;
    if (!_is_valid_index(index)) {
        return false;
    }

    var requirements = Array.get(_rules, index).requirements;
    for (var requirement_index = 0;
         requirement_index < Array.len(requirements);
         requirement_index += 1) {
        var requirement = Array.get(requirements, requirement_index);
        if (requirement.req_type != Requirements.req_type_feat
            || !Requirements.match_feat(
                creature,
                requirement.subtype,
                requirement.match,
                requirement.value)) {
            return false;
        }
    }
    return true;
}

fn ranged(base_item: BaseItemType): bool {
    var index = base_item as int;
    if (!_is_valid_index(index)) {
        return false;
    }
    return Array.get(_rules, index).ranged;
}

fn weapon_type(base_item: BaseItemType): int {
    var index = base_item as int;
    if (!_is_valid_index(index)) {
        return -1;
    }
    return Array.get(_rules, index).weapon_type;
}

fn is_weapon(base_item: BaseItemType): bool {
    var index = base_item as int;
    var entry = _get_rules(index);
    return entry.weapon_type > 0;
}

fn weapon_size(base_item: BaseItemType): int {
    var index = base_item as int;
    if (!_is_valid_index(index)) {
        return 0;
    }
    return Array.get(_rules, index).weapon_size;
}

fn base_ac(base_item: BaseItemType): int {
    var index = base_item as int;
    if (!_is_valid_index(index)) {
        return 0;
    }
    return Array.get(_rules, index).base_ac;
}

fn crit_threat(base_item: BaseItemType): int {
    var index = base_item as int;
    if (!_is_valid_index(index)) {
        return 0;
    }
    return Array.get(_rules, index).crit_threat;
}

fn crit_multiplier(base_item: BaseItemType): int {
    var index = base_item as int;
    if (!_is_valid_index(index)) {
        return 0;
    }
    return Array.get(_rules, index).crit_multiplier;
}

fn base_damage_roll(base_item: BaseItemType): DiceRoll {
    var index = base_item as int;
    if (!_is_valid_index(index)) {
        return DiceRoll{0, 0, 0};
    }
    var entry = Array.get(_rules, index);
    return DiceRoll{entry.damage_num, entry.damage_die, 0};
}

fn damage_has_bludgeoning(base_item: BaseItemType): bool {
    var index = base_item as int;
    if (index < 0) {
        return true;
    }
    if (!_is_valid_index(index)) {
        return false;
    }
    var wt = Array.get(_rules, index).weapon_type;
    return wt == 2 || wt == 5;
}

fn damage_has_piercing(base_item: BaseItemType): bool {
    var index = base_item as int;
    if (index < 0) {
        return false;
    }
    if (!_is_valid_index(index)) {
        return false;
    }
    var wt = Array.get(_rules, index).weapon_type;
    return wt == 1 || wt == 4 || wt == 5;
}

fn damage_has_slashing(base_item: BaseItemType): bool {
    var index = base_item as int;
    if (index < 0) {
        return false;
    }
    if (!_is_valid_index(index)) {
        return false;
    }
    var wt = Array.get(_rules, index).weapon_type;
    return wt == 3 || wt == 4;
}

