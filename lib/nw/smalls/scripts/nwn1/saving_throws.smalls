import core.combat as NativeCombat;
import nwn1.combat_primitives as Comb;
import nwn1.creature_state as Cre;
import core.math as Math;
import core.object as O;
from nwn1.propsets import { DoorState };
from nwn1.propsets import { PlaceableState };

import nwn1.classes as Classes;
import nwn1.constants as Const;
import nwn1.creature as NCre;
import nwn1.modifier as Mod;

const stack_sum = 0;

fn _innate_save(obj: object, save_type: Const.Save): int {
    switch (obj) {
        case Creature(cre): {
            return NCre.get_saving_throw(cre, save_type);
        }
        case Door(door): {
            var state = get_propset!(DoorState)(door);
            switch (save_type as int) {
                case 1: { return state.save_fort; }
                case 2: { return state.save_reflex; }
                case 3: { return state.save_will; }
                default: { return 0; }
            }
        }
        case Placeable(placeable): {
            var state = get_propset!(PlaceableState)(placeable);
            switch (save_type as int) {
                case 1: { return state.save_fort; }
                case 2: { return state.save_reflex; }
                case 3: { return state.save_will; }
                default: { return 0; }
            }
        }
        default: { return 0; }
    }
}

fn _class_save_bonus(obj: Creature, save_type: Const.Save): int {
    var result = 0;
    var class_count = Cre.get_class_count(obj);
    for (var i = 0; i < class_count; i += 1) {
        result += Classes.save_bonus(
            Cre.get_class_at(obj, i),
            Cre.get_class_levels_at(obj, i),
            save_type);
    }
    return result;
}

fn _effect_delta(obj: object, save_type: Const.Save, save_vs: Const.SaveVersus, versus: object): int {
    var inc = 0;
    var dec = 0;
    const save_filter = save_vs as int;
    const save_type_sub = save_type as int;
    const save_all_sub = Const.saving_throw_all as int;

    inc += Comb.aggregate_effect_int_filtered(obj, Const.effect_type_saving_throw_increase,
        save_type_sub, versus, 1, save_filter, 0, stack_sum);

    inc += Comb.aggregate_effect_int_filtered(obj, Const.effect_type_saving_throw_increase,
        save_all_sub, versus, 1, save_filter, 0, stack_sum);

    dec += Comb.aggregate_effect_int_filtered(obj, Const.effect_type_saving_throw_decrease,
        save_type_sub, versus, 1, save_filter, 0, stack_sum);

    dec += Comb.aggregate_effect_int_filtered(obj, Const.effect_type_saving_throw_decrease,
        save_all_sub, versus, 1, save_filter, 0, stack_sum);

    return Math.clamp(inc - dec, -20, 20);
}

fn get_saving_throw(obj: object, save_type: Const.Save, save_vs: Const.SaveVersus, versus: object, base: bool): int {
    var result = _innate_save(obj, save_type);

    if (obj is Creature) {
        result += _class_save_bonus(obj, save_type);
    }

    if (base) {
        return Math.max(0, result);
    }

    // Feat bonuses (Great Fortitude, Iron Will, Lightning Reflexes and their
    // epic counterparts) arrive through the modifier registry. mod_type_save
    // was declared and had no dispatch at all before this, which is why those
    // feats did nothing. They sit outside the `base` path deliberately: base
    // saves are innate plus class progression, matching GetBaseSavingThrow.
    if (obj is Creature) {
        result += Mod.sum_modifiers(obj, Const.mod_type_save, save_type as int, versus);
    }

    result += _effect_delta(obj, save_type, save_vs, versus);
    return Math.max(0, result);
}

// Slippery Mind: "Characters failing their Will save versus mind-affecting
// spells get an automatic reroll." One reroll, and only for that save and that
// category -- a natural 1 still fails outright, as it does on the first roll.
fn _has_slippery_mind_reroll(obj: object, save_type: Const.Save,
    save_vs: Const.SaveVersus): bool {
    if (save_type != Const.saving_throw_will) { return false; }
    if (save_vs != Const.saving_throw_vs_mind_spells) { return false; }
    if (obj is Creature) {
        return Cre.has_feat(obj, Const.feat_slippery_mind);
    }
    return false;
}

fn _roll_saving_throw(obj: object, save_type: Const.Save, dc: int,
    save_vs: Const.SaveVersus, versus: object): bool {
    var roll = NativeCombat.roll_uniform_int(1, 20);
    if (roll == 1) { return false; }
    if (roll == 20) { return true; }

    var save = get_saving_throw(obj, save_type, save_vs, versus, false);
    return roll + save >= dc;
}

fn resolve_saving_throw(obj: object, save_type: Const.Save, dc: int,
    save_vs: Const.SaveVersus, versus: object): bool {
    dc = Math.clamp(dc, 1, 255);

    if (_roll_saving_throw(obj, save_type, dc, save_vs, versus)) {
        return true;
    }

    if (_has_slippery_mind_reroll(obj, save_type, save_vs)) {
        return _roll_saving_throw(obj, save_type, dc, save_vs, versus);
    }

    return false;
}

// Reflex-save-for-half damage, with Evasion and Improved Evasion applied.
// Returns the damage the target actually takes.
//
// This is the entry point area/breath/trap damage should use instead of calling
// resolve_saving_throw() and halving by hand: Evasion only means anything at
// the point where a Reflex save is being converted into a damage amount.
//
//   no feat         -- save: half damage,  fail: full damage
//   Evasion         -- save: no damage,    fail: full damage
//   Improved Evasion-- save: no damage,    fail: half damage
fn resolve_reflex_damage(obj: object, dc: int, amount: int,
    save_vs: Const.SaveVersus, versus: object): int {
    if (amount <= 0) { return 0; }

    const saved = resolve_saving_throw(obj, Const.saving_throw_reflex, dc, save_vs, versus);

    var has_evasion = false;
    var has_improved_evasion = false;
    if (obj is Creature) {
        has_improved_evasion = Cre.has_feat(obj, Const.feat_improved_evasion);
        has_evasion = has_improved_evasion
            || Cre.has_feat(obj, Const.feat_evasion);
    }

    if (saved) {
        return has_evasion ? 0 : amount / 2;
    }
    return has_improved_evasion ? amount / 2 : amount;
}
