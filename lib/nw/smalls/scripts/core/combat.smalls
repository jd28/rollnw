[[native]] fn roll_uniform_int(min: int, max: int): int;
[[native]] fn aggregate_effect_int(obj: object, effect_type: EffectType, subtype: int, versus_race: int, versus_alignment_flags: int, int_index: int, stack_policy: int): int;
[[native]] fn aggregate_effect_int_filtered(obj: object, effect_type: EffectType, subtype: int, versus_race: int, versus_alignment_flags: int, filter_int_index: int, filter_int_value: int, int_index: int, stack_policy: int): int;
[[native]] fn damage_immunity_effect_delta(obj: object, increase_type: EffectType, decrease_type: EffectType, damage_type: Damage, versus_race: int, versus_alignment_flags: int): int;
[[native]] fn object_effect_count(obj: object): int;
[[native]] fn object_effect_at(obj: object, index: int): effects.Effect;
