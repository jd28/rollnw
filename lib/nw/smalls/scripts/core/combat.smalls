from core.types import { AttackType, Damage, EffectType };
import core.effects as effects;

[[native]] fn attack_bonus_effect_delta(obj: Creature, attack_type: AttackType, any_attack_type: AttackType, increase_type: EffectType, decrease_type: EffectType, versus_race: int, versus_alignment_flags: int): int;
[[native]] fn roll_uniform_int(min: int, max: int): int;
[[native]] fn aggregate_effect_int(obj: object, effect_type: EffectType, subtype: int, versus_race: int, versus_alignment_flags: int, int_index: int, stack_policy: int): int;
[[native]] fn aggregate_effect_int_filtered(obj: object, effect_type: EffectType, subtype: int, versus_race: int, versus_alignment_flags: int, filter_int_index: int, filter_int_value: int, int_index: int, stack_policy: int): int;
[[native]] fn damage_immunity_effect_delta(obj: object, increase_type: EffectType, decrease_type: EffectType, damage_type: Damage, versus_race: int, versus_alignment_flags: int): int;
[[native]] fn object_effect_count(obj: object): int;
[[native]] fn object_effect_at(obj: object, index: int): effects.Effect;
[[native]] fn object_find_first_effect_of(obj: object, effect_type: int, subtype: int, start_index: int): int;
[[native]] fn effect_best_damage_reduction(obj: object, effect_type: EffectType, power: int): effects.Effect;
[[native]] fn effect_best_damage_resistance(obj: object, effect_type: EffectType, damage_type: Damage): effects.Effect;
[[native]] fn roll_dice(dice: int, sides: int, bonus: int, multiplier: int): int;
// Scheduling. These are requests, not callbacks: a script asks the engine to
// schedule an attack, and the engine keeps no script state in its event queue.
// `pacing_ticks` of 0 means "use the combat policy's own pacing".
[[native]] fn schedule_attack(attacker: Creature, target: object, delay_ticks: int): bool;
[[native]] fn start_auto_attack(attacker: Creature, target: object, initial_delay_ticks: int, pacing_ticks: int): bool;
[[native]] fn stop_auto_attack(attacker: Creature): bool;
// The initiative the attacker rolled on entering combat; 0 when out of combat.
[[native]] fn combat_initiative(attacker: Creature): int;

[[native]] fn creature_effect_version(obj: Creature): int;
[[native]] fn creature_equip_version(obj: Creature): int;
