from core.types import { Class, ResRef, Spell };

[[native]]
type AppearanceInfo {
    id: int;
    model: ResRef;
    model_type: int;
};

[[native]] fn appearance_info(id: int): AppearanceInfo;
[[native]] fn set_vitals(obj: Creature, hp_current: int, hp_max: int): bool;
[[native]] fn get_vitals_hp_current(obj: Creature): int;
[[native]] fn get_vitals_hp_max(obj: Creature): int;
[[native]] fn get_ability_loadout_count(obj: Creature): int;
[[native]] fn get_ability_loadout_ability(obj: Creature, index: int): int;
[[native]] fn get_ability_loadout_source(obj: Creature, index: int): int;
[[native]] fn get_ability_loadout_tier(obj: Creature, index: int): int;
[[native]] fn get_ability_loadout_slot(obj: Creature, index: int): int;
[[native]] fn get_ability_loadout_modifier(obj: Creature, index: int): int;
[[native]] fn add_unslotted_ability(obj: Creature, source: Class, tier: int, ability: Spell): bool;
[[native]] fn remove_unslotted_ability(obj: Creature, source: Class, tier: int, ability: Spell): bool;
[[native]] fn set_slotted_ability_count(obj: Creature, source: Class, tier: int, count: int): bool;
[[native]] fn available_ability_slots(obj: Creature, source: Class, tier: int): int;
[[native]] fn add_slotted_ability(obj: Creature, source: Class, tier: int, ability: Spell, modifier: int, flags: int): bool;
[[native]] fn set_slotted_ability(obj: Creature, source: Class, tier: int, slot: int, ability: Spell, modifier: int, flags: int): bool;
[[native]] fn clear_slotted_ability(obj: Creature, source: Class, tier: int, slot: int, ability: Spell, modifier: int, flags: int): bool;
[[native]] fn remove_slotted_ability(obj: Creature, source: Class, tier: int, ability: Spell, modifier: int): bool;
[[native]] fn clear_slotted_ability_from_tier(obj: Creature, source: Class, min_tier: int, ability: Spell): bool;
