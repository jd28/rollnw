import core.array as Array;
import core.effects as effects;
import core.map as Map;
from core.types import { ResRef };
from core.effects import { Effect };

type BaseItemType(int);
type EquipIndex(int);
type ItemPropertyType(int);

[[native]]
type ItemProperty {
    prop_type: int;
    subtype: int;
    cost_table: int;
    cost_value: int;
    param_table: int;
    param_value: int;
    tag: string;
};

type ItemEffectRow {
    op: int;
    timing: int;
    subject: int;
    value0: int;
    value1: int;
    value2: int;
    condition: int;
    flags: int;
};

const item_effect_op_ability_modifier = 1;
const item_effect_op_attack_modifier = 2;
const item_effect_op_bonus_spell_slot = 3;
const item_effect_op_damage_bonus = 4;
const item_effect_op_haste = 5;
const item_effect_op_save_modifier = 6;
const item_effect_op_skill_modifier = 7;
const item_effect_timing_equipped = 1;
const item_effect_condition_none = 0;
const item_effect_flag_none = 0;

var itemprop_generators_by_type: map!(int, fn(ItemProperty, EquipIndex): ItemEffectRow) = {};
var item_effect_generators_by_op: map!(int, fn(ItemEffectRow): Effect) = {};

[[native, value_type]]
type BaseItemInfo {
    label: string;
    name: int;
    model_type: int;
    item_class: ResRef;
    default_model: ResRef;
    default_icon: ResRef;
    item_property_column: int;
    inventory_width: int;
    inventory_height: int;
    equipable_slots: int;
    stack_size: int;
    is_container: bool;
};

[[native]] fn publish_baseitem_info(entries: array!(BaseItemInfo)): bool;

[[native]] fn apply_item_effect(creature: Creature, item: Item, effect: Effect): bool;
[[native]] fn remove_item_effects(creature: Creature, item: Item): int;
[[native]] fn ip_cost_table_int(prop_type: int, cost_value: int, column: string): int;
[[native]] fn ip_definition_cost(prop_type: int): float;
[[native]] fn ip_subtype_cost(prop_type: int, subtype: int): float;
[[native]] fn ip_cost_table_float(prop_type: int, cost_value: int, column: string): float;
[[native]] fn ip_definition_count(): int;
[[native]] fn ip_definition_name(prop_type: int): int;
[[native]] fn ip_definition_allowed(prop_type: int, item_property_column: int): bool;
[[native]] fn ip_definition_table(prop_type: int, field: int): int;
[[native]] fn ip_option_count(prop_type: int, field: int): int;
[[native]] fn ip_option_name(prop_type: int, field: int, value: int): int;

[[native]] fn set_item_layout(item: Item, inventory_width: int, inventory_height: int): bool;
[[native]] fn clear_item_layout(item: Item): bool;

[[native]] fn item_properties(item: Item): array!(ItemProperty);
[[native]] fn set_item_properties(item: Item, properties: array!(ItemProperty)): bool;

[[native]] fn get_visual_color(item: Item, part: int, color: int): int;
[[native]] fn get_visual_colors(item: Item, parts: array!(int), colors: array!(int)): array!(int);
[[native]] fn set_visual_colors_raw(item: Item, parts: array!(int), colors: array!(int), values: array!(int)): bool;
[[native]] fn get_visual_model_part(item: Item, part: int): int;
[[native]] fn get_visual_model_parts(item: Item, parts: array!(int)): array!(int);
[[native]] fn set_visual_model_parts_raw(item: Item, parts: array!(int), model_numbers: array!(int)): bool;

[[native]] fn equip_item_in_slot(creature: Creature, item: Item, slot: EquipIndex): bool;
[[native]] fn get_equipped_item(creature: Creature, slot: EquipIndex): Item;
[[native]] fn unequip_item_in_slot(creature: Creature, slot: EquipIndex): Item;
[[native]] fn inventory_add_item(owner: object, item: Item): bool;
[[native]] fn inventory_remove_item(owner: object, item: Item): bool;
[[native]] fn inventory_items(owner: object): array!(Item);

const store_inventory_armor = 0;
const store_inventory_miscellaneous = 1;
const store_inventory_potions = 2;
const store_inventory_rings = 3;
const store_inventory_weapons = 4;
[[native]] fn store_inventory_item_count(store: Store, category: int): int;
[[native]] fn store_inventory_items(
    store: Store, category: int, maximum_items: int): array!(Item);

fn set_generator_for_type(
    prop_type: ItemPropertyType,
    generator: fn(ItemProperty, EquipIndex): ItemEffectRow) {
    itemprop_generators_by_type[prop_type as int] = generator;
}

fn clear_generator_for_type(prop_type: ItemPropertyType) {
    Map.remove(itemprop_generators_by_type, prop_type as int);
}

fn clear_generators() {
    Map.clear(itemprop_generators_by_type);
}

fn set_effect_generator_for_op(op: int, generator: fn(ItemEffectRow): Effect) {
    item_effect_generators_by_op[op] = generator;
}

fn item_effect_to_effect(row: ItemEffectRow): Effect {
    if (row.timing != item_effect_timing_equipped
        || row.condition != item_effect_condition_none
        || !Map.has(item_effect_generators_by_op, row.op)) {
        return effects.invalid();
    }

    var generator: fn(ItemEffectRow): Effect = item_effect_generators_by_op[row.op];
    return generator(row);
}

fn process_item_properties(
    creature: Creature,
    item: Item,
    equip_index: EquipIndex,
    remove: bool): int {
    if (remove) {
        return remove_item_effects(creature, item);
    }

    var properties = item_properties(item);
    var processed = 0;
    for (var i = 0; i < Array.len(properties); i += 1) {
        var property = properties[i];
        if (!Map.has(itemprop_generators_by_type, property.prop_type)) {
            continue;
        }

        var generator: fn(ItemProperty, EquipIndex): ItemEffectRow
            = itemprop_generators_by_type[property.prop_type];
        var effect = item_effect_to_effect(generator(property, equip_index));
        if (effects.is_valid(effect) && apply_item_effect(creature, item, effect)) {
            processed += 1;
        }
    }
    return processed;
}
