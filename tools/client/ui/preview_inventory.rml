<rml>
<head>
  <link type="text/rcss" href="panel.rcss" />
  <style>
    body { background: transparent; pointer-events: none; }
    #preview_inventory_overlay { position: absolute; left: 0; top: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; pointer-events: auto; }
    #preview_inventory, #preview_inventory * { box-sizing: border-box; }
    #preview_inventory { position: relative; width: 386dp; max-width: 96%; max-height: 94%; background: #10100eb0; border: 1dp #a38c5e; display: flex; flex-direction: column; color: #eee5d2; }
    .preview_inventory_header { display: flex; justify-content: flex-end; height: 26dp; padding: 1dp 3dp; flex-shrink: 0; }
    #preview_inventory_move { display: block; flex: 1; height: 24dp; cursor: move; }
    #preview_inventory_main { display: flex; flex-direction: column; align-items: center; min-height: 0dp; overflow-y: auto; padding: 0dp 10dp 10dp; }
    #preview_equipment_slots { display: block; position: relative; flex-shrink: 0; width: 360dp; height: 192dp; margin-bottom: 12dp; }
    #preview_inventory_grid { flex-shrink: 0; }
    .preview_equipment_slot, .preview_inventory_item, .preview_inventory_page { box-sizing: border-box; color: #eee5d2; cursor: pointer; tab-index: auto; font-size: 12dp; padding: 0dp; }
    .preview_equipment_slot { position: absolute; display: flex; align-items: center; justify-content: center; background: transparent; border: 1dp #8d795335; overflow: hidden; }
    .preview_equipment_slot.assigned { border-color: #a38c5e60; }
    .preview_equipment_slot:hover, .preview_equipment_slot:focus { border-color: #d5b980; background: #b89b5818; }
    .preview_equipment_slot.inventory_drop_invalid { border-color: #dc5c64; background: #dc5c6418; }
    .preview_equipment_slot *, .preview_inventory_item *, .preview_inventory_cell { pointer-events: none; }
    .preview_slot_placeholder { position: absolute; left: 0dp; top: 0dp; opacity: 0.35; }
    .preview_equipment_image { position: relative; display: block; flex-shrink: 0; overflow: hidden; }
    .preview_equipment_image img { position: absolute; }
    #preview_inventory_board { position: relative; display: block; background: #08080630; border-top: 1dp #a38c5e70; border-left: 1dp #a38c5e70; }
    .preview_inventory_cell { position: absolute; display: block; width: 32dp; height: 32dp; border-right: 1dp #a38c5e70; border-bottom: 1dp #a38c5e70; }
    .preview_inventory_item { position: absolute; background: transparent; border: 1dp transparent; overflow: hidden; }
    .preview_inventory_item.selected { background: #b89b5820; border-color: #d5b980; }
    .preview_inventory_item:hover, .preview_inventory_item:focus { background: #b89b5818; border-color: #d5b980; }
    .preview_inventory_icon { position: absolute; left: 0dp; top: 0dp; }
    .preview_inventory_stack { position: absolute; right: 2dp; bottom: 0dp; padding: 0dp 2dp; background: #080806a0; color: #eee5d2; font-size: 11dp; }
    .preview_icon_fallback { font-size: 10dp; color: #eee5d2; }
    #preview_inventory_pages { display: flex; align-items: center; justify-content: space-between; margin-top: 8dp; width: 320dp; }
    .preview_inventory_page { display: flex; align-items: center; justify-content: center; width: 28dp; height: 24dp; background: #08080640; border: 1dp #a38c5e70; }
    .preview_inventory_page:hover, .preview_inventory_page:focus { background: #b89b5830; border-color: #d5b980; }
    .inventory_chevron { display: block; width: 7dp; height: 7dp; border-top: 2dp #d5b980; border-right: 2dp #d5b980; pointer-events: none; }
    .inventory_chevron.left { transform: rotate(-135deg); margin-left: 3dp; }
    .inventory_chevron.right { transform: rotate(45deg); margin-right: 3dp; }
    .preview_inventory_page_marks { display: flex; align-items: center; }
    .preview_inventory_page_mark { display: block; width: 4dp; height: 4dp; margin: 0dp 4dp; background: #a38c5e60; }
    .preview_inventory_page_mark.active { background: #d5b980; }
    #preview_inventory_message { display: none; flex-shrink: 0; padding: 0dp 12dp 10dp; color: #e4c58d; font-size: 12dp; }
    #preview_inventory_message.visible { display: block; }
    #preview_inventory_tooltip { display: none; position: absolute; max-width: 240dp; padding: 4dp 7dp; background: #080806e8; border: 1dp #a38c5e90; color: #eee5d2; font-size: 12dp; pointer-events: none; z-index: 10; }
    #preview_inventory_tooltip.visible { display: block; }
  </style>
</head>
<body>
  <div id="preview_inventory_overlay">
    <div id="preview_inventory">
      <div class="preview_inventory_header">
        <handle id="preview_inventory_move" move_target="preview_inventory" edge_margin="4dp" />
        <button id="preview_inventory_close" class="icon_button_x" title="Close inventory"><span>&#215;</span></button>
      </div>
      <div id="preview_inventory_main">
        <div id="preview_equipment_slots"></div>
        <div id="preview_inventory_grid"></div>
      </div>
      <div id="preview_inventory_message"></div>
    </div>
    <div id="preview_inventory_tooltip"></div>
  </div>
</body>
</rml>
