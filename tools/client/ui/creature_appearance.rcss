.creature_accessory_editor {
  display: block;
  width: 100%;
  margin-top: 14dp;
  box-sizing: border-box;
}
.creature_accessory_editor .appearance_catalog_editor {
  display: block;
  width: 100%;
  margin-bottom: 8dp;
  box-sizing: border-box;
}
.creature_accessory_title {
  display: block;
  width: 100%;
  height: 24dp;
  color: #dce3ea;
  font-size: 12dp;
  font-weight: 700;
  line-height: 24dp;
  box-sizing: border-box;
}
.creature_color_editor {
  display: block;
  width: 100%;
  margin-top: 14dp;
  box-sizing: border-box;
}
.creature_color_title {
  height: 24dp;
  color: #dce3ea;
  font-size: 12dp;
  font-weight: 700;
  line-height: 24dp;
}
.creature_color_fields {
  display: flex;
  width: 100%;
  height: 42dp;
  border-top: 1dp #36414c;
  border-bottom: 1dp #36414c;
  background: #151b21;
  box-sizing: border-box;
}
.creature_color_field {
  display: flex;
  flex: 1;
  min-width: 0dp;
  height: 40dp;
  padding: 7dp 5dp;
  border-right: 1dp #303b45;
  color: #cbd3da;
  font-size: 11dp;
  line-height: 24dp;
  box-sizing: border-box;
  cursor: pointer;
}
.creature_color_field:hover {
  background: #202930;
}
.creature_color_field * {
  pointer-events: none;
}
.creature_color_field span {
  flex: 1;
  min-width: 0dp;
  margin-left: 5dp;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.creature_color_swatch {
  flex: 0 0 24dp;
  width: 24dp;
  height: 24dp;
  border: 1dp #56616b;
  box-sizing: border-box;
}
.creature_color_selector {
  background: #171d23;
}
.creature_color_channels {
  display: flex;
  flex: 0 0 37dp;
  width: 100%;
  min-width: 0dp;
  height: 37dp;
  padding: 4dp 10dp 5dp 10dp;
  border-bottom: 1dp #303943;
  background: #171d23;
  box-sizing: border-box;
}
.creature_color_channel {
  flex: 1;
  min-width: 0dp;
  height: 28dp;
  padding: 0dp 5dp;
  border-bottom: 2dp transparent;
  color: #9faab5;
  font-size: 11dp;
  font-weight: 700;
  line-height: 26dp;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
  cursor: pointer;
}
.creature_color_channel:hover {
  background: #202930;
  color: #e2e7eb;
}
.creature_color_channel.active {
  border-bottom-color: #a78d62;
  color: #f0f3f6;
}
.creature_color_palette_body {
  display: flex;
  flex: 1;
  min-width: 0dp;
  min-height: 0dp;
  padding: 10dp;
  justify-content: center;
  align-items: flex-start;
  overflow: auto;
  background: #13191e;
  box-sizing: border-box;
}
.creature_color_palette {
  position: relative;
  display: block;
  flex: 0 0 384dp;
  width: 384dp;
  height: 264dp;
  background: #0b0f12;
  cursor: pointer;
}
.creature_color_palette img {
  position: absolute;
  left: 0dp;
  top: 0dp;
  width: 384dp;
  height: 264dp;
  pointer-events: none;
}
.creature_color_selection {
  position: absolute;
  width: 24dp;
  height: 24dp;
  border: 2dp #31f36a;
  box-sizing: border-box;
  pointer-events: none;
}
