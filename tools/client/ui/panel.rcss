  background: #42272b;
  color: #ffe9ea;
}
.object_variable_toolbar {
  display: flex;
  flex: 0 0 39dp;
  height: 39dp;
  align-items: center;
  justify-content: flex-end;
  padding: 6dp 9dp;
  border-bottom: 1dp #303943;
  background: #171d23;
