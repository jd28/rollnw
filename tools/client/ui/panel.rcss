  font-size: 11dp;
  text-align: right;
  cursor: pointer;
}
.body_part_rows .managed_list_row:hover .managed_list_cell.cell_1,
.body_part_rows:focus .managed_list_row.selected .managed_list_cell.cell_1,
.body_part_rows .managed_list_cell.cell_1:focus {
  border-left-color: #a78d62;
  background: #151d23;
}
.body_part_rows .managed_list_row.selected {
