}
.creature_equipment_jewelry_row {
  width: 64px;
  height: 64px;
  margin-top: 8px;
}
.creature_equipment_jewelry_row > div {
  display: flex;
  flex: 0 0 32px;
  flex-direction: column;
  width: 32px;
  height: 64px;
}
.creature_equipment_slot {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 0px;
  background: transparent;
  box-sizing: border-box;
  cursor: pointer;
  overflow: hidden;
}
.creature_equipment_slot_right_hand {
  width: 64px;
  height: 184px;
}
.creature_equipment_slot_chest,
.creature_equipment_slot_cloak {
  width: 64px;
  height: 120px;
}
.creature_equipment_slot_left_hand {
  width: 64px;
  height: 128px;
}
.creature_equipment_slot_head,
.creature_equipment_slot_boots,
.creature_equipment_slot_creature_left,
.creature_equipment_slot_creature_right,
.creature_equipment_slot_creature_bite,
.creature_equipment_slot_creature_skin {
  width: 64px;
  height: 64px;
}
.creature_equipment_slot_arms,
.creature_equipment_slot_belt {
  width: 64px;
  height: 32px;
}
.creature_equipment_slot_arrows,
.creature_equipment_slot_bolts,
.creature_equipment_slot_neck {
  width: 32px;
  height: 64px;
}
.creature_equipment_slot_bullets,
.creature_equipment_slot_left_ring,
.creature_equipment_slot_right_ring {
  width: 32px;
  height: 32px;
}
.creature_equipment_slot_belt,
.creature_equipment_slot_arms {
  margin-top: 8px;
}
.creature_equipment_slot:hover {
  background: #202930;
}
.creature_equipment_slot.drop_valid {
  background: #244334;
  border: 2px #36d875;
}
.creature_equipment_slot.drop_invalid {
  background: #44282a;
  border: 2px #dc5c64;
}
.creature_equipment_slot * {
  pointer-events: none;
}
.creature_equipment_slot_icon {
  position: absolute;
  left: 0px;
  top: 0px;
}
.creature_equipment_item_frame {
  display: block;
  flex: 0 0 auto;
  position: relative;
  overflow: hidden;
}
.creature_equipment_item_icon {
  position: absolute;
}
.creature_equipment_slot_icon {
  opacity: 0.7;
}
.creature_inventory_page_surface {
  display: flex;
  flex: 0 0 340px;
  flex-direction: row;
  justify-content: center;
  width: 100%;
  height: 340px;
  min-width: 0px;
  padding: 10px 8px;
  background: #13191e;
  box-sizing: border-box;
}
.creature_inventory_board {
  display: flex;
  position: relative;
  flex: 0 0 320px;
  flex-wrap: wrap;
  width: 320px;
  height: 320px;
  background: #10161b;
  box-sizing: border-box;
  overflow: hidden;
}
.creature_inventory_cell {
  flex: 0 0 32px;
  width: 32px;
  height: 32px;
  border-right: 1px #46525e;
  border-bottom: 1px #46525e;
  background: #12191f;
  box-sizing: border-box;
  pointer-events: none;
}
.creature_inventory_drop_target {
  display: none;
  position: absolute;
  z-index: 4;
  box-sizing: border-box;
  pointer-events: none;
}
.creature_inventory_drop_target.valid {
  border: 2px #36d875;
  background: rgba(54, 216, 117, 61);
}
.creature_inventory_drop_target.invalid {
  border: 2px #dc5c64;
  background: rgba(220, 92, 100, 61);
}
.creature_inventory_item {
  display: flex;
  position: absolute;
  align-items: center;
  justify-content: center;
  padding: 3px;
  border: 2px #7d6948;
  background: #26333d;
  color: #e4e9ed;
  box-sizing: border-box;
  cursor: pointer;
}
.creature_inventory_item:hover {
  background: #32434f;
  border-color: #a78d62;
}
.creature_inventory_item.selected {
  border-color: #36d875;
  background: #2d443d;
}
.creature_inventory_item * {
  pointer-events: none;
}
.creature_inventory_item_label {
  max-width: 100%;
  max-height: 100%;
  font-size: 10px;
  line-height: 12px;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
}
.creature_inventory_item_icon {
  max-width: 100%;
  max-height: 100%;
}
.creature_inventory_stack {
  position: absolute;
  right: 2px;
  bottom: 1px;
  color: #ffffff;
  font-family: RollnwMono;
  font-size: 9px;
  line-height: 11px;
  text-align: right;
}
.creature_inventory_pages {
  display: flex;
  flex: 0 0 28px;
  flex-direction: column;
  width: 28px;
  height: 320px;
  margin-left: 6px;
}
.creature_inventory_page {
  flex: 0 0 30px;
  width: 28px;
  height: 30px;
  margin-bottom: 4px;
  padding: 0px;
  border: 1px #46525e;
  border-radius: 0px;
  background: #182027;
  color: #87949f;
  font-family: RollnwMono;
  font-size: 10px;
  line-height: 28px;
  text-align: center;
  cursor: pointer;
}
.creature_inventory_page:hover {
  background: #25313a;
  color: #dce3e9;
}
.creature_inventory_page.active {
  border-color: #a78d62;
  background: #2b3339;
  color: #e8d8bc;
}
.property_tree_empty {
  padding: 16px 14px;
  color: #8f9daa;
  font-size: 12px;
  line-height: 16px;
}
.workspace_area_placeholder {
  color: #8f9daa;
  font-size: 13px;
  line-height: 17px;
}
.workspace_resource_surface {
  display: flex;
  width: 100%;
  height: 100%;
  min-width: 0px;
  min-height: 0px;
  background: #171a1f;
}
.resource_inspector {
  flex: 1;
  min-width: 0px;
  min-height: 0px;
  padding: 18px;
  overflow-y: auto;
  background: #171a1f;
  color: #dce3ea;
}
.resource_inspector.compact {
  flex: 0 0 330px;
  width: 330px;
  padding: 12px;
  border-left: 1px #2b3540;
  background: #151b21;
}
.resource_inspector_header {
  padding-bottom: 12px;
  margin-bottom: 10px;
  border-bottom: 1px #2b3540;
}
.resource_inspector_title {
  color: #f4f6f8;
  font-size: 16px;
  font-weight: 700;
  line-height: 20px;
}
.resource_inspector_detail {
  margin-top: 4px;
  color: #9faab5;
  font-size: 12px;
  line-height: 15px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.resource_inspector_badges {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  margin-top: 9px;
}
.resource_inspector_badge {
  padding: 2px 6px;
  border: 1px #3a4652;
  border-radius: 3px;
  background: #1d252c;
  color: #c4ced8;
  font-size: 11px;
  font-weight: 700;
  line-height: 14px;
}
.resource_inspector_empty {
  padding: 10px 0px;
  color: #aab4bf;
  font-size: 13px;
  line-height: 17px;
}
.resource_inspector_diagnostics {
  margin-bottom: 12px;
}
.resource_inspector_diagnostic {
  display: flex;
  gap: 8px;
  padding: 7px 0px;
  border-bottom: 1px #2b3540;
  color: #cbd5df;
  font-size: 12px;
  line-height: 16px;
}
.resource_inspector_diagnostic_level {
  flex: 0 0 54px;
  color: #e4c08a;
  font-weight: 700;
}
.resource_inspector_diagnostic_Error .resource_inspector_diagnostic_level {
  color: #f0a09a;
}
.resource_inspector_diagnostic_Info .resource_inspector_diagnostic_level {
  color: #9ab6d8;
}
.resource_inspector_diagnostic_message {
  flex: 1;
  min-width: 0px;
}
.resource_property_group {
  margin-top: 12px;
}
.resource_property_group_title {
  margin-bottom: 5px;
  color: #f0f3f6;
  font-size: 12px;
  font-weight: 700;
  line-height: 15px;
  text-transform: uppercase;
}
.resource_property_row {
  display: flex;
  min-height: 26px;
  border-bottom: 1px #2b3540;
}
.resource_property_name {
  flex: 0 0 130px;
  padding: 6px 10px 6px 0px;
  color: #9faab5;
  font-size: 12px;
  font-weight: 600;
  line-height: 16px;
}
.resource_property_value {
  flex: 1;
  min-width: 0px;
  padding: 6px 0px;
  color: #e5ebf0;
  font-size: 12px;
  line-height: 16px;
  word-break: break-word;
}
.resource_inspector.compact .resource_property_name {
  flex-basis: 112px;
}
/* === Bottom dock (output / terminal) === */
#bottom_dock {
  position: absolute; left: 0px; bottom: 0px; width: 100%; height: 240px;
  min-height: 160px; max-height: 720px; background: #101418;
  border-top: 1px #3d4650; z-index: 40; display: none;
  padding: 0px 10px 8px 10px; box-sizing: border-box;
}
#bottom_dock, #bottom_dock * { box-sizing: border-box; }
#bottom_dock.visible { display: flex; flex-direction: column; }
#bottom_dock_resize_grabber {
  display: block; height: 6px; margin: 0px 0px 6px 0px; box-sizing: border-box;
  background: #151b21; border-bottom: 1px #2f3843; cursor: resize;
}
#bottom_dock_resize_grabber:hover { background: #23313a; border-color: #657884; }
#bottom_dock_tabs {
  display: flex; gap: 4px; margin-top: 6px; margin-bottom: 0px;
}
.dock_tab, .output_toggle {
  border: 1px #35414d; border-radius: 3px; background: #151b21;
  font-size: 13px; line-height: 16px;
}
.dock_tab.active, .output_toggle.active {
  color: #eadcc3; background: #222a32;
}
.dock_tab {
  min-height: 24px; padding: 4px 12px; color: #aeb8c3;
}
.dock_tab.active { border-color: #9b835d; }
.dock_widget {
  display: none; flex: 1; min-height: 0; min-width: 0;
}
.dock_widget.visible {
  display: flex; flex-direction: column;
}
#terminal_output {
  width: 100%; height: auto; flex: 1; min-height: 0; min-width: 0;
  overflow-y: auto; overflow-x: hidden;
  background: #0e1318; border: 1px #303943; padding: 6px;
  box-sizing: border-box; margin-bottom: 6px; font-family: RollnwMono;
  font-size: 14px; font-weight: normal; line-height: 17px;
}
#terminal_input {
  display: block; width: 100%; box-sizing: border-box; padding: 6px 8px;
  font-family: RollnwMono; font-size: 14px; font-weight: normal; line-height: 17px;
}
#output_panel {
  min-height: 0; min-width: 0;
}
#output_header { display: flex; gap: 4px; margin-bottom: 6px; }
.output_toggle {
  min-height: 22px; min-width: 48px; padding: 3px 8px; color: #aab4bf;
}
.output_toggle.active { border-color: #8b7657; }
#output_filter {
  flex: 1; min-width: 160px; padding: 3px 8px; font-size: 14px;
  line-height: 17px;
}
#output_list {
  height: auto; flex: 1; min-height: 0; min-width: 0; display: block;
  overflow-y: auto; overflow-x: auto; border: 1px #303943;
  background: #0e1318; padding: 6px; box-sizing: border-box;
  cursor: text; tab-index: auto;
  font-family: RollnwMono; font-size: 14px; font-weight: normal; line-height: 17px;
}
.output_line {
  min-height: 17px; margin-bottom: 1px; line-height: 17px; white-space: pre;
}
.output_line.info { color: #e1e6eb; }
.output_line.warn { color: #e8c993; }
.output_line.error { color: #ee9f9f; }
.output_line.script { color: #abd0f0; }
.output_text_selection { color: #f0f3f6; background: #8b7657; }
.terminal_line {
  margin-bottom: 1px; line-height: 17px; white-space: pre-wrap;
}
.terminal_line.cmd { color: #d5be91; }
.terminal_line.info { color: #d4d9df; }
.terminal_line.error { color: #e29898; }
