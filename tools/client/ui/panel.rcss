.body_part_editor {
  display: none;
  width: 100%;
  margin-top: 14px;
  box-sizing: border-box;
}
.body_part_editor.active {
  display: block;
}
.body_part_title {
  height: 24px;
  color: #dce3ea;
  font-size: 12px;
  font-weight: 700;
  line-height: 24px;
}
.body_part_header, .body_part_rows .managed_list_row {
  display: flex;
  width: 100%;
  box-sizing: border-box;
}
.body_part_header {
  height: 26px;
  border-top: 1px #36414c;
  border-bottom: 1px #36414c;
  background: #1c242b;
  color: #aeb8c3;
  font-size: 11px;
  font-weight: 700;
  line-height: 25px;
  text-transform: uppercase;
}
.body_part_rows {
  width: 100%;
  height: 570px;
  overflow-y: auto;
  overflow-x: hidden;
}
.body_part_header span:first-child, .body_part_rows .managed_list_cell.cell_0 {
  flex: 1;
  min-width: 0px;
  padding-left: 8px;
  box-sizing: border-box;
}
.body_part_header span:last-child {
  flex: 0 0 112px;
  padding-right: 7px;
  text-align: right;
  box-sizing: border-box;
}
.body_part_rows .managed_list_row {
  position: relative;
  height: 30px;
  border-bottom: 1px #29333c;
  background: #151b21;
  color: #cbd3da;
  font-size: 12px;
  line-height: 29px;
}
.body_part_rows .managed_list_row:hover {
  background: #1b232a;
}
.body_part_rows .managed_list_cell {
  display: block;
  height: 29px;
  line-height: 29px;
  box-sizing: border-box;
}
.body_part_rows .managed_list_cell.cell_1 {
  flex: 0 0 112px;
  width: 112px;
  padding: 0px 25px 0px 7px;
  border-left: 1px #303b45;
  background: #10161b;
  color: #e4e9ed;
  font-family: RollnwMono;
  font-size: 11px;
  text-align: right;
  cursor: pointer;
}
.body_part_rows .managed_list_row:hover .managed_list_cell.cell_1,
.body_part_rows:focus .managed_list_row.selected .managed_list_cell.cell_1,
.body_part_rows .managed_list_cell.cell_1:focus {
  border-left-color: #a78d62;
  background: #151d23;
}
.body_part_rows .managed_list_row.selected {
  z-index: 25;
}
.combobox_options {
  position: absolute;
  left: 0px;
  top: 0px;
