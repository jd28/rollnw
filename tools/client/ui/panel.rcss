/* rollnw client panel styles.
 *
 * RmlUi RCSS has no CSS variables; the recurring palette is:
 *   #171a1f  app background          #151b21  panel/widget background
 *   #0f1318  input background        #0e1318  log/list background
 *   #192027  list row background     #222b34  list row hover background
 *   #303943  border                  #2b3540  border (dark)
 *   #3a4652  input border            #667989  hover border
 *   #f0f3f6  bright text             #e7ebef  input text
 *   #8b7657  accent (bronze)         #a78d62  selection accent
 */

/* === Globals === */
body {
  margin: 0;
  width: 100%;
  height: 100%;
  display: block;
  font-family: RollnwSans;
  font-size: 15px;
  font-weight: 500;
  line-height: 19px;
  background: #171a1f;
  color: #e2e6eb;
}
button, input { font-family: RollnwSans; font-weight: 500; }

/* === Shared utilities and components === */
/* Full-width block containers. */
.recent_row, .tree_spacer, .nw_list, .nw_list_body,
#command_list_items, #terminal_output_lines, #output_list_lines,
.output_line, .terminal_line {
  display: block;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}
/* Clickable list rows (recent files, generic lists, command palette). */
.recent_item, .nw_list_row, .command_item {
  display: block;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  text-align: left;
  padding: 6px 8px;
  background: #192027;
  color: #e8ecef;
  border: 1px #2d3742;
  cursor: pointer;
}
.recent_item *, .nw_list_row *, .command_item * { pointer-events: none; }
.recent_item:hover, .recent_item.hovered, .vl_row.hovered,
.nw_list_row:hover, .command_item:hover {
  background: #222b34;
  border-color: #667989;
}
.nw_list_row:active, .command_item:active { background: #29343f; }
.recent_item.selected, .nw_list_row.selected {
  background: #25313b;
  border-color: #a78d62;
}
/* Text inputs. */
#recent_search, #command_input, #output_filter, #terminal_input {
  background: #0f1318;
  color: #e7ebef;
  border: 1px #3a4652;
}
/* One visual and focus contract for every anchored choice field. */
.combobox_field {
  display: flex;
  align-items: center;
  width: 100%;
  height: 30px;
  min-width: 0px;
  padding: 0px 7px;
  border: 1px #3a4651;
  border-radius: 2px;
  background: #10161b;
  color: #e4e9ed;
  box-sizing: border-box;
  cursor: pointer;
}
.combobox_field:hover,
.combobox_field:focus,
.combobox_field.open {
  border-color: #a78d62;
  background: #151d23;
}
.combobox_field * { pointer-events: none; }
.combobox_value {
  flex: 1;
  min-width: 0px;
  height: 28px;
  line-height: 28px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.combobox_arrow {
  display: flex;
  flex: 0 0 18px;
  height: 28px;
  align-items: center;
  justify-content: flex-end;
}
.combobox_arrow_indicator {
  width: 0px;
  height: 0px;
  border-left: 4px transparent;
  border-right: 4px transparent;
  border-top: 5px #98a5b1;
}
.combobox_close { display: none; }
#panel {
  position: absolute;
  left: 0px;
  top: 0px;
  bottom: 240px;
  width: 360px;
  min-height: 0px;
  background: #15181c;
  border: 0px;
  border-right: 1px #3d4650;
  border-radius: 0px;
  padding: 12px 18px 12px 12px;
  overflow: hidden;
  display: none;
  flex-direction: column;
  z-index: 35;
}
#panel, #panel * { box-sizing: border-box; }
#panel.area_mode { z-index: 45; }
#panel:hover { background: #171b20; }
#left_dock_resize_grabber {
  position: absolute;
  top: 0px;
  right: 0px;
  bottom: 0px;
  width: 6px;
  background: #11161b;
  border-left: 1px #303943;
  cursor: resize;
  z-index: 46;
}
#left_dock_resize_grabber:hover {
  background: #23313a;
  border-color: #657884;
}
scrollbarvertical { width: 10px; cursor: arrow; }
scrollbarhorizontal { height: 10px; cursor: arrow; }
scrollbarvertical slidertrack,
scrollbarhorizontal slidertrack {
  background: #0d1115;
  border: 1px #2b3440;
}
scrollbarvertical sliderbar,
scrollbarhorizontal sliderbar {
  background: #3a4652;
  border: 1px #57636f;
}
scrollbarvertical sliderbar:hover,
scrollbarhorizontal sliderbar:hover {
  background: #4a5967;
  border-color: #7c8f9b;
}
scrollbarcorner { background: #0d1115; cursor: arrow; }
#title {
  font-family: RollnwSans;
  font-size: 18px;
  font-weight: 600;
  color: #f4f6f8;
  margin-bottom: 10px;
  line-height: 22px;
}
#title_areas, #title_project { display: none; }
#panel.area_mode #title_areas { display: block; }
#panel.project_mode #title_project { display: block; }
/* === Left dock === */
#recent_search {
  display: block;
  width: 100%;
  box-sizing: border-box;
  padding: 6px 8px;
  margin-bottom: 8px;
  line-height: 17px;
}
#recent_list {
  display: block;
  width: 100%;
  box-sizing: border-box;
  flex: 1;
  min-height: 0;
  min-width: 0;
  overflow-y: auto;
  overflow-x: hidden;
  border: 1px #303943;
  background: #101419;
  padding: 6px;
}
.recent_row { margin: 0 0 4px 0; }
#recent_list > .recent_row:last-child { margin-bottom: 0; }
.recent_item {
  height: auto;
  min-height: 34px;
  margin: 0;
  overflow: visible;
  line-height: 16px;
  white-space: normal;
}
.recent_title { display: block; min-width: 0; white-space: normal; overflow: visible; }
.recent_title_plain {
  display: block; width: 100%; color: #f0f3f5; font-size: 15px;
  font-weight: 600;
  line-height: 19px; white-space: normal; overflow: visible;
}
.recent_path {
  display: block; width: 100%; min-width: 0;
  color: #a7b0ba; font-size: 13px; line-height: 16px; margin-top: 2px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.tree_row {
  margin: 0;
  height: 26px;
}
.tree_item {
  height: 26px;
  min-height: 24px;
  padding-top: 3px;
  padding-right: 6px;
  padding-bottom: 3px;
  background: transparent;
  border-color: transparent;
  color: #d5dde4;
  font-size: 14px;
  font-weight: 500;
  line-height: 18px;
  white-space: nowrap;
  overflow: hidden;
}
.tree_item:hover,
.tree_item.hovered {
  background: #1b232b;
  border-color: #34414d;
}
.tree_item.selected {
  background: #222d36;
  border-color: #a78d62;
}
.tree_item.tree_directory {
  background: transparent;
  color: #e4eaf0;
  font-weight: 700;
}
.tree_item.tree_area {
  color: #e1e7ed;
  font-weight: 600;
}
.tree_item.tree_resource,
.tree_item.tree_file {
  background: transparent;
}
.tree_twisty {
  display: inline-block;
  width: 16px;
  height: 18px;
  border: 0px transparent;
}
.tree_twisty.collapsed {
  width: 0px;
  height: 0px;
  margin-left: 4px;
  margin-right: 7px;
  margin-bottom: 1px;
  border-top: 4px transparent;
  border-bottom: 4px transparent;
  border-left: 5px #8f9daa;
}
.tree_twisty.expanded {
  width: 0px;
  height: 0px;
  margin-left: 3px;
  margin-right: 5px;
  margin-bottom: 3px;
  border-left: 4px transparent;
  border-right: 4px transparent;
  border-top: 5px #8f9daa;
}
.tree_item:hover .tree_twisty.collapsed,
.tree_item.hovered .tree_twisty.collapsed {
  border-left-color: #c1ccd6;
}
.tree_item:hover .tree_twisty.expanded,
.tree_item.hovered .tree_twisty.expanded {
  border-top-color: #c1ccd6;
}
.tree_label {
  display: inline-block;
  max-width: 260px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tree_meta {
  display: inline-block;
  margin-left: 8px;
  color: #d5be91;
  font-size: 12px;
  font-weight: 600;
  line-height: 16px;
}
.tree_area .tree_meta { color: #9fb8d0; }
.nw_list_header {
  display: flex; gap: 8px; margin-bottom: 6px; padding: 0 6px;
  color: #b9c1ca; font-size: 12px; line-height: 15px; text-transform: uppercase; letter-spacing: 0;
}
.nw_list_body { overflow-x: hidden; }
.nw_list_row { margin: 0 0 4px 0; }
.nw_list_row:last-child { margin-bottom: 0; }
.nw_list_col {
  display: block; width: 100%; min-width: 0;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.area_list .nw_list_col { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
.area_list .nw_list_col_label { color: #e8ecef; }
.nw_list_empty { color: #96a0aa; font-size: 12px; line-height: 15px; padding: 6px; }
.command_item .nw_list_col_desc { color: #96a0aa; font-size: 12px; line-height: 15px; }

/* === Command palette === */
#command_palette {
  position: absolute; left: 50%; top: 64px; width: 680px; margin-left: -340px;
  background: #151a20; border: 1px #586672; border-radius: 6px;
  padding: 8px; display: none; z-index: 50; box-sizing: border-box;
}
#command_palette, #command_palette * { box-sizing: border-box; }
#command_palette.visible { display: block; }
#command_input {
  display: block; width: 100%; box-sizing: border-box; padding: 8px; font-size: 15px;
  margin-bottom: 6px;
  line-height: 18px;
}
@media (max-width: 800px) {
  #command_palette {
    left: 16px; right: 16px; width: auto; margin-left: 0px;
  }
}
#command_list {
  display: block; width: 100%; min-width: 0; box-sizing: border-box;
  max-height: 300px; overflow-y: auto; overflow-x: hidden;
  background: #0e1318; border: 1px #303943; padding: 6px;
}
.command_item {
  min-height: 44px;
  margin: 0 0 4px 0;
}
.command_item:last-child { margin-bottom: 0; }
.command_item .nw_list_col_id { color: #d5be91; font-size: 13px; line-height: 16px; }
#command_details {
  margin-top: 6px; padding-top: 6px; border-top: 1px #303943;
  color: #aeb7c1; font-size: 12px; line-height: 15px; min-height: 30px;
}
#command_details .key { color: #d5be91; }
/* === Workspace shell and tabs === */
#workspace_shell {
  position: absolute;
  left: 0px;
  top: 0px;
  right: 0px;
  bottom: 240px;
  min-width: 0px;
  min-height: 0px;
  display: flex;
  flex-direction: column;
  background: #171a1f;
  border-left: 1px #202a33;
  z-index: 20;
  box-sizing: border-box;
}
#workspace_shell, #workspace_shell * { box-sizing: border-box; }
.play_preview_active #panel,
.play_preview_active #bottom_dock,
.play_preview_active #workspace_tab_bar,
.play_preview_active .workspace_area_toolbar,
.play_preview_active .object_workbench {
  display: none;
}
.play_preview_active #workspace_shell {
  left: 0px;
  bottom: 0px;
}
.play_preview_active .workspace_preview_body,
.play_preview_active .workspace_area_surface {
  width: 100%;
  height: 100%;
}
.play_preview_active .workspace_viewer_viewport {
  margin: 0px;
  border: 0px transparent;
}
.play_preview_placement_pending .workspace_viewer_viewport {
  cursor: cross;
}
#workspace_tab_bar {
  display: flex;
  flex-shrink: 0;
  height: 38px;
  min-height: 38px;
  min-width: 0px;
  background: #11161b;
  border-bottom: 1px #2f3843;
}
#workspace_tabs {
  display: block;
  flex: 1;
  min-width: 0px;
  height: 38px;
  min-height: 38px;
  overflow-x: auto;
  overflow-y: hidden;
  padding: 0px 0px;
}
#workspace_tabs scrollbarhorizontal {
  height: 2px;
}
#workspace_tabs scrollbarhorizontal slidertrack {
  background: #0d1115;
  border: 0px transparent;
}
#workspace_tabs scrollbarhorizontal sliderbar {
  height: 2px;
  min-width: 30px;
  background: #3a4652;
  border: 0px transparent;
}
#workspace_tabs scrollbarhorizontal sliderbar:hover {
  background: #6f8192;
}
.workspace_tab_scroll_button {
  flex-shrink: 0;
  width: 26px;
  min-width: 26px;
  height: 37px;
  min-height: 37px;
  margin: 0px;
  padding: 0px;
  border: 0px transparent;
  border-left: 1px #2f3843;
  border-radius: 0px;
  background: #171d23;
  color: #c4ced7;
  font-size: 22px;
  line-height: 35px;
  text-align: center;
  cursor: pointer;
}
.workspace_tab_scroll_button:hover {
  background: #28323b;
  color: #ffffff;
}
.workspace_tab_scroll_button.disabled,
.workspace_tab_scroll_button.disabled:hover {
  background: #11161b;
  color: #46515c;
  cursor: default;
}
#workspace_tab_track {
  display: flex;
  height: 36px;
  min-height: 36px;
}
.workspace_tab {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  min-width: 178px;
  max-width: 336px;
  height: 36px;
  min-height: 36px;
  padding: 0px 10px;
  margin: 0px;
  color: #aeb8c3;
  border-left: 1px #141a20;
  border-right: 1px #141a20;
  border-top: 1px #252e37;
  background: #20262d;
  cursor: pointer;
}
.workspace_tab.locked {
  cursor: pointer;
}
.workspace_tab.dragging {
  opacity: 0.72;
  cursor: grabbing;
}
.workspace_tab:hover {
  color: #e4e9ef;
  background: #262d35;
  border-color: #35414d;
}
.workspace_tab.active {
  color: #f0f3f6;
  background: #151a20;
  border-left: 1px #303a44;
  border-right: 1px #303a44;
  border-top: 2px #8b7657;
}
.workspace_tab_home, .workspace_tab_area {
  min-width: 46px;
  width: 46px;
  max-width: 46px;
  padding: 0px;
  text-align: center;
  justify-content: center;
}
.workspace_tab_home .workspace_tab_title, .workspace_tab_area .workspace_tab_title {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46px;
  height: 36px;
  text-align: center;
  font-size: 0px;
  line-height: 0px;
}
.workspace_tab_graphic {
  display: block;
  position: relative;
  width: 24px;
  height: 22px;
  min-width: 24px;
  pointer-events: none;
}
/* === Tab icons (CSS pixel art — intentional, do not refactor) ===
 * Each icon is hand-built from absolutely positioned divs; the coordinate
 * and size repetition below is inherent to the technique. */
.home_icon_cabinet, .home_icon_drawer, .home_icon_label, .home_icon_handle, .home_icon_base,
.area_icon_panel, .area_icon_path, .area_icon_dot {
  display: block;
  position: absolute;
  pointer-events: none;
}
.home_icon_cabinet {
  left: 4px;
  top: 3px;
  width: 16px;
  height: 17px;
  background: #26323b;
  border: 1px #8b7657;
}
.home_icon_drawer {
  left: 6px;
  width: 12px;
  height: 7px;
  border-bottom: 1px #6d5e45;
}
.home_icon_drawer_1 {
  top: 5px;
}
.home_icon_drawer_2 {
  top: 12px;
}
.home_icon_label {
  left: 8px;
  width: 4px;
  height: 2px;
  background: #9fc5d7;
}
.home_icon_label_1 {
  top: 7px;
}
.home_icon_label_2 {
  top: 14px;
}
.home_icon_handle {
  left: 13px;
  width: 3px;
  height: 1px;
  background: #c7b284;
}
.home_icon_handle_1 {
  top: 8px;
}
.home_icon_handle_2 {
  top: 15px;
}
.home_icon_base {
  left: 5px;
  top: 20px;
  width: 14px;
  height: 2px;
  background: #c7b284;
}
.area_icon_panel {
  top: 4px;
  height: 15px;
  border: 1px #536677;
  background: #22303a;
}
.area_icon_panel_1 {
  left: 2px;
  width: 7px;
}
.area_icon_panel_2 {
  left: 9px;
  width: 6px;
  background: #1b262e;
}
.area_icon_panel_3 {
  left: 15px;
  width: 7px;
}
.area_icon_path {
  background: #a8c5d5;
}
.area_icon_path_1 {
  left: 5px;
  top: 14px;
  width: 6px;
  height: 2px;
}
.area_icon_path_2 {
  left: 10px;
  top: 10px;
  width: 2px;
  height: 6px;
}
.area_icon_path_3 {
  left: 10px;
  top: 10px;
  width: 8px;
  height: 2px;
}
.area_icon_dot {
  width: 3px;
  height: 3px;
  background: #d0b36e;
}
.area_icon_dot_1 {
  left: 4px;
  top: 13px;
}
.area_icon_dot_2 {
  left: 17px;
  top: 9px;
}
.workspace_tab.active .home_icon_cabinet, .workspace_tab:hover .home_icon_cabinet {
  background: #2d3b45;
  border-color: #c7b284;
}
.workspace_tab.active .home_icon_handle, .workspace_tab:hover .home_icon_handle,
.workspace_tab.active .home_icon_base, .workspace_tab:hover .home_icon_base {
  background: #e2cc98;
}
.workspace_tab.active .home_icon_label, .workspace_tab:hover .home_icon_label {
  background: #c7e1ec;
}
.workspace_tab.active .area_icon_panel, .workspace_tab:hover .area_icon_panel {
  border-color: #7e95a8;
}
.workspace_tab.active .area_icon_path, .workspace_tab:hover .area_icon_path {
  background: #c7e1ec;
}
.workspace_tab.active .area_icon_dot, .workspace_tab:hover .area_icon_dot {
  background: #e1c37a;
}
.workspace_tab_icon {
  display: block;
  width: 26px;
  min-width: 26px;
  margin-right: 7px;
  color: #8fc5dd;
  font-size: 11px;
  font-weight: 800;
  line-height: 14px;
  text-align: left;
  text-transform: uppercase;
  pointer-events: none;
}
.workspace_tab_icon_project {
  color: #c9a8ec;
}
.workspace_tab_icon_area {
  color: #9fb8d0;
}
.workspace_tab_icon_preview {
  color: #c0a86a;
}
.workspace_tab_icon_module {
  color: #d5b06f;
}
.workspace_tab_icon_resource {
  color: #78bfd8;
}
.workspace_tab_title {
  display: block;
  flex: 1;
  min-width: 0px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 13px;
  line-height: 17px;
  pointer-events: none;
}
.workspace_tab_close, .workspace_subtab_close {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding: 0px;
  color: #8f9daa;
  border: 1px transparent;
  border-radius: 2px;
  text-align: center;
  font-weight: 700;
  cursor: pointer;
}
.workspace_tab_close:hover, .workspace_subtab_close:hover {
  color: #f0f3f6;
  background: #303a44;
  border-color: #536170;
}
.workspace_tab_close_glyph, .workspace_subtab_close_glyph {
  display: block;
  font-weight: 700;
  pointer-events: none;
}
.workspace_tab_close {
  width: 20px;
  min-width: 20px;
  max-width: 20px;
  height: 20px;
  min-height: 20px;
  max-height: 20px;
  margin-left: 8px;
  font-size: 16px;
  line-height: 20px;
}
.workspace_tab_close_glyph {
  font-size: 15px;
  line-height: 18px;
}
.workspace_tab.active .workspace_tab_close {
  color: #d4dbe2;
}
.workspace_subtabs {
  display: flex;
  height: 30px;
  min-height: 30px;
  padding: 0px 10px;
  background: #141a20;
  border-bottom: 1px #2b3540;
}
.workspace_subtab {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  min-width: 78px;
  max-width: 180px;
  height: 29px;
  padding: 6px 8px 5px 10px;
  margin: 0px 2px 0px 0px;
  color: #aeb8c3;
  border-left: 1px transparent;
  border-right: 1px transparent;
  border-top: 1px transparent;
  background: #151b21;
  cursor: pointer;
}
.workspace_subtab:hover {
  color: #e4e9ef;
  background: #1d252d;
  border-color: #35414d;
}
.workspace_subtab.active {
  color: #f0f3f6;
  background: #1d252d;
  border-color: #8b7657;
}
.workspace_subtab_title {
  display: block;
  flex: 1;
  min-width: 0px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 12px;
  font-weight: 600;
  line-height: 15px;
  pointer-events: none;
}
.workspace_subtab_close {
  width: 14px;
  min-width: 14px;
  max-width: 14px;
  height: 14px;
  min-height: 14px;
  max-height: 14px;
  margin-left: 7px;
  font-size: 11px;
  line-height: 14px;
}
.workspace_subtab_close_glyph {
  font-size: 11px;
  line-height: 12px;
}
/* === Workspace content: home, documents, area, resource inspector === */
#workspace_content {
  flex: 1;
  min-width: 0px;
  min-height: 0px;
  overflow: auto;
  background: #171a1f;
}
.workspace_home_surface {
  display: flex;
  width: 100%;
  height: 100%;
  min-width: 0px;
  min-height: 0px;
  overflow: hidden;
}
#workspace_home {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0px;
  min-height: 0px;
  overflow: hidden;
  color: #e2e6eb;
}
.workspace_home_content {
  display: flex;
  flex-direction: column;
  flex: 1;
  width: auto;
  min-width: 0px;
  min-height: 0px;
  padding: 36px 40px;
  box-sizing: border-box;
}
#workspace_home_header {
  display: flex;
  margin-bottom: 22px;
}
#workspace_home_title {
  color: #f4f6f8;
  font-size: 24px;
  font-weight: 700;
  line-height: 30px;
}
#workspace_home_subtitle {
  color: #d5be91;
  font-size: 13px;
  font-weight: 600;
  line-height: 17px;
}
#home_project_list {
  display: block;
  width: 100%;
}
.home_project_item {
  display: block;
  width: 100%;
  min-width: 0px;
  padding: 8px 10px;
  margin-bottom: 6px;
  border: 1px #303943;
  background: #151b21;
  cursor: pointer;
}
.home_project_item:hover {
  background: #1d252d;
  border-color: #667989;
}
.home_project_name {
  color: #f0f3f5;
  font-size: 14px;
  font-weight: 600;
  line-height: 18px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  pointer-events: none;
}
.home_project_path {
  margin-top: 2px;
  color: #9faab5;
  font-size: 12px;
  line-height: 15px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  pointer-events: none;
}
.home_empty {
  color: #96a0aa;
  font-size: 13px;
  line-height: 17px;
}
.home_section_title {
  margin-bottom: 8px;
  color: #f0f3f5;
  font-size: 14px;
  font-weight: 700;
  line-height: 18px;
}
#home_area_browser {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0px;
  min-height: 0px;
}
.home_area_browser_header {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
}
.home_area_browser_header .home_section_title {
  flex: 1;
  min-width: 0px;
}
.home_area_count {
  flex: 0 0 auto;
  color: #8f9ba7;
  font-size: 12px;
  font-weight: 700;
  line-height: 18px;
}
.home_area_search {
  display: block;
  flex: 0 0 30px;
  width: 100%;
  height: 30px;
  min-height: 30px;
  margin-bottom: 8px;
  padding: 5px 8px;
  border: 1px #35414c;
  background: #11171c;
  color: #e1e6eb;
  box-sizing: border-box;
}
.home_area_list {
  display: block;
  flex: 1;
  min-width: 0px;
  min-height: 0px;
  overflow-y: auto;
  overflow-x: hidden;
}
.home_area_grid_row {
  display: flex;
  width: 100%;
  height: 190px;
  min-height: 190px;
  gap: 8px;
  box-sizing: border-box;
}
.home_area_card {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0px;
  height: 182px;
  padding: 7px;
  border: 1px #303943;
  background: #151b21;
  cursor: pointer;
  box-sizing: border-box;
}
.home_area_card:hover,
.home_area_card:focus {
  border-color: #6c8192;
  background: #1d252d;
}
.home_area_card_filler {
  visibility: hidden;
  pointer-events: none;
}
.home_area_map {
  display: flex;
  flex: 0 0 120px;
  height: 120px;
  min-height: 120px;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #0f1418;
  pointer-events: none;
}
.home_area_map img {
  display: block;
  max-width: 100%;
  max-height: 120px;
  pointer-events: none;
}
.home_area_map_missing {
  color: #68737e;
  font-size: 11px;
  font-weight: 600;
  pointer-events: none;
}
.home_area_name {
  margin-top: 7px;
  color: #f0f3f5;
  font-size: 13px;
  font-weight: 700;
  line-height: 17px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  pointer-events: none;
}
.home_area_resref {
  color: #8f9ba7;
  font-size: 11px;
  line-height: 14px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  pointer-events: none;
}
.home_area_spacer {
  display: block;
  width: 1px;
}
.workspace_document {
  padding: 36px 40px;
}
.workspace_document_title {
  color: #f4f6f8;
  font-size: 22px;
  font-weight: 700;
  line-height: 28px;
}
.workspace_document_detail {
  margin-top: 6px;
  color: #aab4bf;
  font-size: 13px;
  line-height: 17px;
}
.workspace_area_surface {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  min-width: 0px;
  min-height: 0px;
  overflow: hidden;
  background: #171a1f;
}
.workspace_area_toolbar {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  height: 34px;
  min-height: 34px;
  padding: 0px 12px;
  border-bottom: 1px #2b3540;
  background: #151b21;
}
.workspace_area_title {
  flex: 0 1 auto;
  min-width: 0px;
  color: #f0f3f6;
  font-size: 14px;
  font-weight: 700;
  line-height: 18px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.workspace_area_detail {
  flex: 1;
  min-width: 0px;
  margin-left: 10px;
  color: #9faab5;
  font-size: 12px;
  font-weight: 500;
  line-height: 15px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.workspace_viewer_viewport {
  flex: 1;
  min-width: 0px;
  min-height: 0px;
  margin: 10px;
  border: 1px #303943;
  background: #3d4d6b;
  overflow: hidden;
}
.workspace_viewer_viewport.empty {
  display: flex;
  align-items: center;
  justify-content: center;
}
.workspace_preview_body {
  display: flex;
  flex: 1;
  min-width: 0px;
  min-height: 0px;
}
.workspace_preview_body .workspace_viewer_viewport {
  margin-right: 0px;
}
.workspace_preview_body.data_workbench_only .workspace_viewer_viewport {
  display: none;
}
.workspace_preview_body.data_workbench_only .object_workbench {
  flex: 1;
  width: auto;
  min-width: 0px;
  margin: 10px;
  border: 1px #2b3540;
}
.object_workbench {
  position: relative;
  display: flex;
  flex-direction: column;
  flex: 0 1 440px;
  width: 440px;
  min-width: 320px;
  min-height: 0px;
  overflow: hidden;
  border-left: 1px #2b3540;
  background: #151b21;
  color: #dce3ea;
  box-sizing: border-box;
}
.object_workbench_header {
  flex: 0 0 auto;
  padding: 12px 14px 10px 14px;
  border-bottom: 1px #2b3540;
}
.panel_back_button {
  display: flex;
  flex: 0 0 32px;
  width: 32px;
  height: 32px;
  align-items: center;
  justify-content: center;
  padding: 0px;
  border: 0px transparent;
  border-radius: 0px;
  background: transparent;
  color: #aeb8c3;
  cursor: pointer;
}
.panel_back_button:hover,
.panel_back_button:focus {
  color: #ffffff;
  background: #28333d;
}
.panel_back_icon {
  display: block;
  position: relative;
  width: 18px;
  height: 12px;
}
.panel_back_head {
  position: absolute;
  left: 1px;
  top: 1px;
  width: 0px;
  height: 0px;
  border-top: 5px transparent;
  border-right: 7px #aeb8c3;
  border-bottom: 5px transparent;
}
.panel_back_shaft {
  position: absolute;
  left: 7px;
  top: 5px;
  width: 10px;
  height: 2px;
  background: #aeb8c3;
}
.panel_back_button:hover .panel_back_head,
.panel_back_button:focus .panel_back_head {
  border-right-color: #ffffff;
}
.panel_back_button:hover .panel_back_shaft,
.panel_back_button:focus .panel_back_shaft {
  background: #ffffff;
}
.area_object_header,
.area_object_list_header {
  display: flex;
  align-items: center;
  gap: 9px;
}
.object_workbench_title {
  flex: 1;
  min-width: 0px;
  color: #f4f6f8;
  font-size: 16px;
  font-weight: 700;
  line-height: 20px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.area_object_list_count {
  flex: 0 0 auto;
  color: #8f9ba7;
  font-size: 12px;
  font-weight: 700;
}
.area_object_list {
  display: block;
  flex: 1;
  min-width: 0px;
  min-height: 0px;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 6px;
  background: #13191e;
  box-sizing: border-box;
}
.area_object_row {
  display: flex;
  width: 100%;
  min-width: 0px;
  min-height: 34px;
  margin-bottom: 4px;
  padding: 6px 8px;
  border: 1px #2d3742;
  background: #192027;
  color: #e8ecef;
  text-align: left;
  cursor: pointer;
  box-sizing: border-box;
}
.area_object_row:last-child { margin-bottom: 0px; }
.area_object_row:hover {
  background: #222b34;
  border-color: #667989;
}
.area_object_row * { pointer-events: none; }
.area_object_row_name {
  flex: 1;
  min-width: 0px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.area_object_row_type {
  flex: 0 0 auto;
  margin-left: 8px;
  color: #a99573;
  font-size: 12px;
}
.object_workbench_tab_bar {
  display: flex;
  flex: 0 0 31px;
  height: 31px;
  min-width: 0px;
  border-bottom: 1px #303943;
  background: #171d23;
  box-sizing: border-box;
}
.object_workbench_tabs {
  display: block;
  flex: 1;
  min-width: 0px;
  height: 30px;
  overflow-x: auto;
  overflow-y: hidden;
}
.object_workbench_tabs scrollbarhorizontal {
  height: 1px;
}
.object_workbench_tabs scrollbarhorizontal slidertrack,
.object_workbench_tabs scrollbarhorizontal sliderbar {
  background: transparent;
  border: 0px transparent;
}
.object_workbench_tab_track {
  display: flex;
  height: 30px;
  padding: 0px 10px;
}
.object_workbench_tab {
  flex-shrink: 0;
  padding: 7px 7px 5px 7px;
  color: #9faab5;
  font-size: 12px;
  font-weight: 700;
  line-height: 18px;
  border-bottom: 2px transparent;
  cursor: pointer;
}
.object_workbench_tab.active {
  color: #eef2f5;
  border-bottom-color: #a78d62;
}
.object_workbench_tab_scroll_button {
  flex-shrink: 0;
  width: 23px;
  min-width: 23px;
  height: 30px;
  min-height: 30px;
  margin: 0px;
  padding: 0px;
  border: 0px transparent;
  border-left: 1px #303943;
  border-radius: 0px;
  background: #171d23;
  color: #c4ced7;
  font-size: 19px;
  line-height: 28px;
  text-align: center;
  cursor: pointer;
}
.object_workbench_tab_scroll_button:hover {
  background: #28323b;
  color: #ffffff;
}
.object_workbench_tab_scroll_button.disabled,
.object_workbench_tab_scroll_button.disabled:hover {
  background: #171d23;
  color: #46515c;
  cursor: default;
}
.data_object_collection {
  display: flex;
  flex: 1;
  min-width: 0px;
  min-height: 0px;
  flex-direction: column;
  overflow: hidden;
  background: #13191e;
}
.data_object_collection.drop_valid {
  border: 2px #36d875;
}
.data_object_collection.drop_invalid {
  border: 2px #dc5c64;
}
.data_collection_header,
.data_collection_rows .managed_list_row {
  display: flex;
  min-width: 0px;
  box-sizing: border-box;
}
.data_collection_header {
  flex: 0 0 31px;
  min-height: 31px;
  align-items: center;
  padding: 0px 10px;
  border-bottom: 1px #303943;
  background: #171d23;
  color: #9faab5;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
}
.data_collection_summary {
  flex: 0 0 25px;
  min-height: 25px;
  padding: 0px 10px;
  border-bottom: 1px #2a343e;
  background: #13191e;
  color: #7f8b96;
  font-size: 11px;
  line-height: 25px;
}
.data_collection_rows {
  display: block;
  flex: 1;
  min-width: 0px;
  min-height: 0px;
  overflow-y: auto;
  overflow-x: hidden;
}
.data_collection_rows .managed_list_row {
  min-height: 34px;
  align-items: center;
  padding: 6px 10px;
  border-bottom: 1px #2a343e;
  background: #151b21;
  color: #dce3ea;
}
.data_collection_header span,
.data_collection_rows .managed_list_cell {
  min-width: 0px;
  padding-right: 10px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.encounter_spawn_header span:nth-child(1),
.encounter_spawn_rows .cell_0 { flex: 3; }
.encounter_spawn_header span:nth-child(2),
.encounter_spawn_rows .cell_1 { flex: 1; }
.encounter_spawn_header span:nth-child(3),
.encounter_spawn_rows .cell_2 { flex: 1; }
.encounter_spawn_header span:nth-child(4),
.encounter_spawn_rows .cell_3 { flex: 1; }
.sound_resource_header span,
.sound_resource_rows .cell_0 {
  flex: 1;
}
.store_inventory_header span:nth-child(1),
.store_inventory_rows .cell_0 { flex: 1; }
.store_inventory_header span:nth-child(2),
.store_inventory_rows .cell_1 { flex: 2; }
.store_inventory_header span:nth-child(3),
.store_inventory_rows .cell_2 { flex: 2; }
.store_inventory_header span:nth-child(4),
.store_inventory_rows .cell_3 { flex: 0 0 60px; }
.store_inventory_drop_targets {
  display: flex;
  flex: 0 0 35px;
  gap: 4px;
  padding: 4px 6px;
  border-bottom: 1px #303943;
  background: #171d23;
  box-sizing: border-box;
}
.store_inventory_drop_target {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-width: 0;
  border: 1px #46535e;
  border-radius: 2px;
  background: #202830;
  color: #cbd3d9;
  font-size: 11px;
  text-align: center;
}
.store_inventory_drop_target.drop_valid {
  border-color: #55c28c;
  background: #1f4033;
  color: #e4fff1;
}
.store_inventory_drop_target.drop_invalid {
  border-color: #c65f64;
  background: #42272b;
  color: #ffe9ea;
}
.object_variable_toolbar {
  display: flex;
  flex: 0 0 39px;
  height: 39px;
  align-items: center;
  justify-content: flex-end;
  padding: 6px 9px;
  border-bottom: 1px #303943;
  background: #171d23;
  box-sizing: border-box;
}
.object_variable_toolbar button {
  height: 27px;
  padding: 3px 9px;
  border: 1px #536371;
  border-radius: 2px;
  background: #202930;
  color: #e4e9ed;
  font-size: 12px;
  cursor: pointer;
}
.object_variable_toolbar button:hover,
.object_variable_toolbar button:focus {
  border-color: #a78d62;
  background: #28333d;
}
.object_variable_header {
  display: flex;
  flex: 0 0 27px;
  height: 27px;
  min-width: 0px;
  border-bottom: 1px #36414c;
  background: #1c242b;
  color: #aeb8c3;
  font-size: 11px;
  font-weight: 700;
  line-height: 26px;
  text-transform: uppercase;
  box-sizing: border-box;
}
.object_variable_header_name {
  flex: 0 0 34%;
  padding-left: 9px;
  box-sizing: border-box;
}
.object_variable_header_type {
  flex: 0 0 20%;
  padding-left: 7px;
  box-sizing: border-box;
}
.object_variable_header_value {
  flex: 1;
  padding-left: 7px;
  box-sizing: border-box;
}
.object_variable_rows {
  display: block;
  flex: 1;
  min-width: 0px;
  min-height: 0px;
  overflow-y: auto;
  overflow-x: hidden;
  background: #13191e;
}
.object_variable_row {
  display: block;
  width: 100%;
  height: 34px;
  min-width: 0px;
  padding: 3px 5px;
  border-bottom: 1px #29333c;
  background: #151b21;
  box-sizing: border-box;
}
.object_variable_row:hover {
  background: #202930;
}
.object_variable_cells {
  display: flex;
  width: 100%;
  height: 27px;
  min-width: 0px;
  align-items: center;
}
.object_variable_name,
.object_variable_value {
  width: auto;
  min-width: 0px;
  height: 25px;
  padding: 2px 5px;
  border: 1px transparent;
  border-radius: 2px;
  background: transparent;
  color: #e4e9ed;
  font-family: RollnwMono;
  font-size: 11px;
  line-height: 19px;
  box-sizing: border-box;
  cursor: text;
}
.object_variable_field {
  display: flex;
  width: auto;
  min-width: 0px;
  height: 25px;
  align-items: center;
  box-sizing: border-box;
}
.object_variable_name_field {
  flex: 0 0 34%;
}
.object_variable_value_field {
  flex: 1;
}
.object_variable_name,
.object_variable_value {
  flex: 1;
  width: auto;
}
.object_variable_name:hover,
.object_variable_value:hover {
  border-color: #3a4651;
  background: #10161b;
}
.object_variable_name:focus,
.object_variable_value:focus {
  border-color: #a78d62;
  background: #0f1419;
}
.object_variable_field.warning_duplicate,
.object_variable_field.warning_type {
  border-color: #98783f;
  background: #2a2519;
}
.object_variable_field.warning_duplicate,
.object_variable_field.warning_type {
  border-width: 1px;
  border-radius: 2px;
}
.object_variable_field.warning_duplicate .object_variable_name,
.object_variable_field.warning_type .object_variable_value,
.object_variable_field.warning_duplicate .object_variable_name:hover,
.object_variable_field.warning_type .object_variable_value:hover,
.object_variable_field.warning_duplicate .object_variable_name:focus,
.object_variable_field.warning_type .object_variable_value:focus {
  height: 23px;
  padding-left: 3px;
  border-color: transparent;
  background: transparent;
}
.object_variable_field_warning {
  display: block;
  flex: 0 0 16px;
  width: 16px;
  height: 17px;
  margin-left: 4px;
  margin-right: 1px;
  border: 1px #f0c86e;
  border-radius: 9px;
  background: #c99a3a;
  color: #101419;
  font-size: 11px;
  font-weight: 700;
  line-height: 15px;
  text-align: center;
  cursor: help;
  box-sizing: border-box;
}
#object_variable_warning_tooltip {
  display: none;
  position: absolute;
  min-height: 0px;
  padding: 7px 9px;
  border: 1px #8f7a51;
  border-radius: 3px;
  background: #171b20;
  color: #f0d99f;
  font-size: 11px;
  line-height: 16px;
  white-space: normal;
  pointer-events: none;
  box-sizing: border-box;
  z-index: 60;
}
.object_variable_type {
  flex: 0 0 20%;
  height: 25px;
  min-width: 0px;
  padding: 2px 5px;
  border: 1px transparent;
  border-radius: 2px;
  background: transparent;
  color: #a99573;
  font-size: 11px;
  text-align: left;
  cursor: pointer;
  box-sizing: border-box;
}
.object_variable_type:hover,
.object_variable_type:focus {
  border-color: #596673;
  background: #151d23;
}
.object_variable_remove {
  flex: 0 0 27px;
  width: 27px;
  height: 25px;
  padding: 0px;
  border: 1px transparent;
  background: transparent;
  color: #8f9ba7;
  font-size: 18px;
  line-height: 23px;
  text-align: center;
  cursor: pointer;
  box-sizing: border-box;
}
.object_variable_remove:hover,
.object_variable_remove:focus {
  color: #f0a0a0;
  border-color: #744545;
  background: #2a1b1b;
}
.module_hak_list {
  display: block;
  flex: 1;
  min-width: 0px;
  min-height: 0px;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 6px;
  background: #13191e;
  box-sizing: border-box;
}
.module_hak_item {
  display: block;
  width: 100%;
  min-width: 0px;
  padding: 7px 10px;
  margin-bottom: 5px;
  border-bottom: 1px #303943;
  color: #dbe2e8;
  background: #151b21;
  box-sizing: border-box;
