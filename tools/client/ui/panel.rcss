  overflow-y: auto;
  overflow-x: hidden;
}
.body_part_header span:first-child, .body_part_rows .managed_list_cell.cell_0 {
  flex: 1;
  min-width: 0dp;
  padding-left: 8dp;
  box-sizing: border-box;
}
.body_part_header span:last-child {
  flex: 0 0 112dp;
  padding-right: 7dp;
