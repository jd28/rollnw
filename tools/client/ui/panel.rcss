}
.object_variable_toolbar button:hover,
.object_variable_toolbar button:focus {
  border-color: #a78d62;
  background: #28333d;
}
.object_variable_header {
  display: flex;
  flex: 0 0 27dp;
  height: 27dp;
  min-width: 0dp;
  border-bottom: 1dp #36414c;
  background: #1c242b;
  color: #aeb8c3;
  font-size: 11dp;
  font-weight: 700;
  line-height: 26dp;
  text-transform: uppercase;
  box-sizing: border-box;
}
.object_variable_header_name {
  flex: 0 0 34%;
  padding-left: 9dp;
  box-sizing: border-box;
}
.object_variable_header_type {
  flex: 0 0 20%;
  padding-left: 7dp;
  box-sizing: border-box;
}
.object_variable_header_value {
  flex: 1;
  padding-left: 7dp;
  box-sizing: border-box;
}
.object_variable_rows {
  display: block;
  flex: 1;
  min-width: 0dp;
  min-height: 0dp;
  overflow-y: auto;
  overflow-x: hidden;
  background: #13191e;
}
.object_variable_row {
  display: block;
  width: 100%;
  height: 34dp;
  min-width: 0dp;
  padding: 3dp 5dp;
  border-bottom: 1dp #29333c;
  background: #151b21;
  box-sizing: border-box;
}
.object_variable_row:hover {
  background: #202930;
}
.object_variable_cells {
  display: flex;
  width: 100%;
  height: 27dp;
  min-width: 0dp;
  align-items: center;
}
.object_variable_name,
.object_variable_value {
  width: auto;
  min-width: 0dp;
  height: 25dp;
  padding: 2dp 5dp;
  border: 1dp transparent;
  border-radius: 2dp;
  background: transparent;
  color: #e4e9ed;
  font-family: RollnwMono;
  font-size: 11dp;
  line-height: 19dp;
  box-sizing: border-box;
  cursor: text;
}
.object_variable_field {
  display: flex;
  width: auto;
  min-width: 0dp;
  height: 25dp;
  align-items: center;
  box-sizing: border-box;
}
.object_variable_name_field {
  flex: 0 0 34%;
}
.object_variable_value_field {
  flex: 1;
}
.object_variable_name,
.object_variable_value {
  flex: 1;
  width: auto;
}
.object_variable_name:hover,
.object_variable_value:hover {
  border-color: #3a4651;
  background: #10161b;
}
.object_variable_name:focus,
.object_variable_value:focus {
  border-color: #a78d62;
  background: #0f1419;
}
.object_variable_field.warning_duplicate,
.object_variable_field.warning_type {
  border-color: #98783f;
  background: #2a2519;
}
.object_variable_field.warning_duplicate,
.object_variable_field.warning_type {
  border-width: 1dp;
  border-radius: 2dp;
}
.object_variable_field.warning_duplicate .object_variable_name,
.object_variable_field.warning_type .object_variable_value,
.object_variable_field.warning_duplicate .object_variable_name:hover,
.object_variable_field.warning_type .object_variable_value:hover,
.object_variable_field.warning_duplicate .object_variable_name:focus,
.object_variable_field.warning_type .object_variable_value:focus {
  height: 23dp;
  padding-left: 3dp;
  border-color: transparent;
  background: transparent;
}
.object_variable_field_warning {
  display: block;
  flex: 0 0 16dp;
  width: 16dp;
  height: 17dp;
  margin-left: 4dp;
  margin-right: 1dp;
  border: 1dp #f0c86e;
  border-radius: 9dp;
  background: #c99a3a;
  color: #101419;
  font-size: 11dp;
  font-weight: 700;
  line-height: 15dp;
  text-align: center;
  cursor: help;
  box-sizing: border-box;
}
#object_variable_warning_tooltip {
  display: none;
  position: absolute;
  min-height: 0dp;
  padding: 7dp 9dp;
  border: 1dp #8f7a51;
  border-radius: 3dp;
  background: #171b20;
  color: #f0d99f;
  font-size: 11dp;
  line-height: 16dp;
  white-space: normal;
  pointer-events: none;
  box-sizing: border-box;
  z-index: 60;
}
.object_variable_type {
  flex: 0 0 20%;
  height: 25dp;
  min-width: 0dp;
  padding: 2dp 5dp;
  border: 1dp transparent;
  border-radius: 2dp;
  background: transparent;
  color: #a99573;
  font-size: 11dp;
  text-align: left;
  cursor: pointer;
  box-sizing: border-box;
}
.object_variable_type:hover,
.object_variable_type:focus {
  border-color: #596673;
  background: #151d23;
}
.object_variable_remove {
  flex: 0 0 27dp;
  width: 27dp;
  height: 25dp;
  padding: 0dp;
  border: 1dp transparent;
  background: transparent;
  color: #8f9ba7;
  font-size: 18dp;
  line-height: 23dp;
  text-align: center;
  cursor: pointer;
  box-sizing: border-box;
}
.object_variable_remove:hover,
.object_variable_remove:focus {
  color: #f0a0a0;
  border-color: #744545;
  background: #2a1b1b;
}
