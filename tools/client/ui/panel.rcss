/* rollnw client panel styles.
 *
 * RmlUi RCSS has no CSS variables; the recurring palette is:
 *   #171a1f  app background          #151b21  panel/widget background
 *   #0f1318  input background        #0e1318  log/list background
 *   #192027  list row background     #222b34  list row hover background
 *   #303943  border                  #2b3540  border (dark)
 *   #3a4652  input border            #667989  hover border
 *   #f0f3f6  bright text             #e7ebef  input text
 *   #8b7657  accent (bronze)         #a78d62  selection accent
 */

/* === Globals === */
body {
  margin: 0;
  width: 100%;
  height: 100%;
  display: block;
  font-family: RollnwSans;
  font-size: 15dp;
  font-weight: 500;
  line-height: 19dp;
  background: #171a1f;
  color: #e2e6eb;
}
button, input { font-family: RollnwSans; font-weight: 500; }

/* === Shared utilities and components === */
/* Full-width block containers. */
.recent_row, .tree_spacer, .nw_list, .nw_list_body,
#command_list_items, #terminal_output_lines, #output_list_lines,
.output_line, .terminal_line {
  display: block;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}
/* Clickable list rows (recent files, generic lists, command palette). */
.recent_item, .nw_list_row, .command_item {
  display: block;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  text-align: left;
  padding: 6dp 8dp;
  background: #192027;
  color: #e8ecef;
  border: 1dp #2d3742;
  cursor: pointer;
}
.recent_item *, .nw_list_row *, .command_item * { pointer-events: none; }
.recent_item:hover, .recent_item.hovered, .vl_row.hovered,
.nw_list_row:hover, .command_item:hover {
  background: #222b34;
  border-color: #667989;
}
.nw_list_row:active, .command_item:active { background: #29343f; }
.recent_item.selected, .nw_list_row.selected {
  background: #25313b;
  border-color: #a78d62;
}
/* Text inputs. */
#recent_search, #command_input, #output_filter, #terminal_input {
  background: #0f1318;
  color: #e7ebef;
  border: 1dp #3a4652;
}
/* One visual and focus contract for every anchored choice field. */
.combobox_field {
  display: flex;
  align-items: center;
  width: 100%;
  height: 30dp;
  min-width: 0dp;
  padding: 0dp 7dp;
  border: 1dp #3a4651;
  border-radius: 2dp;
  background: #10161b;
  color: #e4e9ed;
  box-sizing: border-box;
  cursor: pointer;
}
.combobox_field:hover,
.combobox_field:focus,
.combobox_field.open {
  border-color: #a78d62;
  background: #151d23;
}
.combobox_field * { pointer-events: none; }
.combobox_value {
  flex: 1;
  min-width: 0dp;
  height: 28dp;
  line-height: 28dp;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.combobox_arrow {
  display: flex;
  flex: 0 0 18dp;
  height: 28dp;
  align-items: center;
  justify-content: flex-end;
}
.combobox_arrow_indicator {
  width: 0dp;
  height: 0dp;
  border-left: 4dp transparent;
  border-right: 4dp transparent;
  border-top: 5dp #98a5b1;
}
.combobox_close { display: none; }
#panel {
  position: absolute;
  left: 0dp;
  top: 0dp;
  bottom: 240dp;
  width: 360dp;
  min-height: 0dp;
  background: #15181c;
  border: 0dp;
  border-right: 1dp #3d4650;
  border-radius: 0dp;
  padding: 12dp 18dp 12dp 12dp;
  overflow: hidden;
  display: none;
  flex-direction: column;
  z-index: 35;
}
#panel, #panel * { box-sizing: border-box; }
#panel.area_mode { z-index: 45; }
#panel:hover { background: #171b20; }
#left_dock_resize_grabber {
  position: absolute;
  top: 0dp;
  right: 0dp;
  bottom: 0dp;
  width: 6dp;
  background: #11161b;
  border-left: 1dp #303943;
  cursor: resize;
  z-index: 46;
}
#left_dock_resize_grabber:hover {
  background: #23313a;
  border-color: #657884;
}
scrollbarvertical { width: 10dp; cursor: arrow; }
scrollbarhorizontal { height: 10dp; cursor: arrow; }
scrollbarvertical slidertrack,
scrollbarhorizontal slidertrack {
  background: #0d1115;
  border: 1dp #2b3440;
}
scrollbarvertical sliderbar,
scrollbarhorizontal sliderbar {
  background: #3a4652;
  border: 1dp #57636f;
}
scrollbarvertical sliderbar:hover,
scrollbarhorizontal sliderbar:hover {
  background: #4a5967;
  border-color: #7c8f9b;
}
scrollbarcorner { background: #0d1115; cursor: arrow; }
#title {
  display: flex;
  position: relative;
  align-items: center;
  min-height: 24dp;
  font-family: RollnwSans;
  font-size: 18dp;
  font-weight: 600;
  color: #f4f6f8;
  margin-bottom: 10dp;
  line-height: 24dp;
}
#title_areas, #title_project { display: none; }
#panel.area_mode #title_areas { display: block; }
#panel.project_mode #title_project { display: block; }
#project_new_resource {
  display: none;
  flex: none;
  margin-left: auto;
  width: 24dp;
  height: 24dp;
  padding: 0dp;
  font-family: RollnwSans;
  font-size: 18dp;
  font-weight: 500;
  line-height: 18dp;
  color: #e7ebef;
  background: #192027;
  border: 1dp #3a4652;
  border-radius: 2dp;
  cursor: pointer;
}
#panel.project_mode #project_new_resource { display: block; }
#project_new_resource:hover { border-color: #a78d62; background: #222b34; }
#project_new_resource:focus,
#project_new_resource.active { border-color: #a78d62; background: #25313b; }
#project_new_resource.hidden { display: none; }
.project_new_resource_glyph {
  display: block;
  width: 100%;
  height: 20dp;
  line-height: 20dp;
  text-align: center;
}
#project_new_resource_menu {
  display: none;
  position: absolute;
  top: 28dp;
  right: 0dp;
  width: 172dp;
  max-height: 290dp;
  padding: 4dp;
  border: 1dp #3a4652;
  border-radius: 2dp;
  background: #13191e;
  overflow-y: auto;
  overflow-x: hidden;
  z-index: 60;
}
#project_new_resource_menu.active { display: block; }
.project_new_resource_action {
  display: block;
  width: 100%;
  height: 28dp;
  margin: 0dp;
  padding: 5dp 9dp;
  border: 0dp transparent;
  border-left: 2dp transparent;
  border-radius: 0dp;
  background: transparent;
  color: #e8ecef;
  font-family: RollnwSans;
  font-size: 14dp;
  font-weight: 500;
  line-height: 16dp;
  text-align: left;
  cursor: pointer;
}
.project_new_resource_action:hover,
.project_new_resource_action:focus {
  border-left-color: #a78d62;
  background: #222b34;
  color: #f0f3f6;
}
/* === Left dock === */
#recent_search {
  display: block;
  width: 100%;
  box-sizing: border-box;
  padding: 6dp 8dp;
  margin-bottom: 8dp;
  line-height: 17dp;
}
#recent_list {
  display: block;
  width: 100%;
  box-sizing: border-box;
  flex: 1;
  min-height: 0;
  min-width: 0;
  overflow-y: auto;
  overflow-x: hidden;
  border: 1dp #303943;
  background: #101419;
  padding: 6dp;
}
.recent_row { margin: 0 0 4dp 0; }
#recent_list > .recent_row:last-child { margin-bottom: 0; }
.recent_item {
  height: auto;
  min-height: 34dp;
  margin: 0;
  overflow: visible;
  line-height: 16dp;
  white-space: normal;
}
.recent_title { display: block; min-width: 0; white-space: normal; overflow: visible; }
.recent_title_plain {
  display: block; width: 100%; color: #f0f3f5; font-size: 15dp;
  font-weight: 600;
  line-height: 19dp; white-space: normal; overflow: visible;
}
.recent_path {
  display: block; width: 100%; min-width: 0;
  color: #a7b0ba; font-size: 13dp; line-height: 16dp; margin-top: 2dp;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.tree_row {
  margin: 0;
  height: 26dp;
}
.tree_item {
  height: 26dp;
  min-height: 24dp;
  padding-top: 3dp;
  padding-right: 6dp;
  padding-bottom: 3dp;
  background: transparent;
  border-color: transparent;
  color: #d5dde4;
  font-size: 14dp;
  font-weight: 500;
  line-height: 18dp;
  white-space: nowrap;
  overflow: hidden;
}
.tree_item:hover,
.tree_item.hovered {
  background: #1b232b;
  border-color: #34414d;
}
.tree_item.selected {
  background: #222d36;
  border-color: #a78d62;
}
.tree_item.tree_directory {
  background: transparent;
  color: #e4eaf0;
  font-weight: 700;
}
.tree_item.tree_area {
  color: #e1e7ed;
  font-weight: 600;
}
.tree_item.tree_resource,
.tree_item.tree_file {
  background: transparent;
}
.tree_twisty {
  display: inline-block;
  width: 16dp;
  height: 18dp;
  border: 0dp transparent;
}
.tree_twisty.collapsed {
  width: 0dp;
  height: 0dp;
  margin-left: 4dp;
  margin-right: 7dp;
  margin-bottom: 1dp;
  border-top: 4dp transparent;
  border-bottom: 4dp transparent;
  border-left: 5dp #8f9daa;
}
.tree_twisty.expanded {
  width: 0dp;
  height: 0dp;
  margin-left: 3dp;
  margin-right: 5dp;
  margin-bottom: 3dp;
  border-left: 4dp transparent;
  border-right: 4dp transparent;
  border-top: 5dp #8f9daa;
}
.tree_item:hover .tree_twisty.collapsed,
.tree_item.hovered .tree_twisty.collapsed {
  border-left-color: #c1ccd6;
}
.tree_item:hover .tree_twisty.expanded,
.tree_item.hovered .tree_twisty.expanded {
  border-top-color: #c1ccd6;
}
.tree_label {
  display: inline-block;
  max-width: 260dp;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tree_meta {
  display: inline-block;
  margin-left: 8dp;
  color: #d5be91;
  font-size: 12dp;
  font-weight: 600;
  line-height: 16dp;
}
.tree_area .tree_meta { color: #9fb8d0; }
.nw_list_header {
  display: flex; gap: 8dp; margin-bottom: 6dp; padding: 0 6dp;
  color: #b9c1ca; font-size: 12dp; line-height: 15dp; text-transform: uppercase; letter-spacing: 0;
}
.nw_list_body { overflow-x: hidden; }
.nw_list_row { margin: 0 0 4dp 0; }
.nw_list_row:last-child { margin-bottom: 0; }
.nw_list_col {
  display: block; width: 100%; min-width: 0;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.area_list .nw_list_col { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
.area_list .nw_list_col_label { color: #e8ecef; }
.nw_list_empty { color: #96a0aa; font-size: 12dp; line-height: 15dp; padding: 6dp; }
.command_item .nw_list_col_desc { color: #96a0aa; font-size: 12dp; line-height: 15dp; }

/* === Command palette === */
#command_palette {
  position: absolute; left: 50%; top: 64dp; width: 680dp; margin-left: -340dp;
  background: #151a20; border: 1dp #586672; border-radius: 6dp;
  padding: 8dp; display: none; z-index: 50; box-sizing: border-box;
}
#command_palette, #command_palette * { box-sizing: border-box; }
#command_palette.visible { display: block; }
#command_input {
  display: block; width: 100%; box-sizing: border-box; padding: 8dp; font-size: 15dp;
  margin-bottom: 6dp;
  line-height: 18dp;
}
@media (max-width: 800dp) {
  #command_palette {
    left: 16dp; right: 16dp; width: auto; margin-left: 0dp;
  }
}
#command_list {
  display: block; width: 100%; min-width: 0; box-sizing: border-box;
  max-height: 300dp; overflow-y: auto; overflow-x: hidden;
  background: #0e1318; border: 1dp #303943; padding: 6dp;
}
.command_item {
  min-height: 44dp;
  margin: 0 0 4dp 0;
}
.command_item:last-child { margin-bottom: 0; }
.command_item .nw_list_col_id { color: #d5be91; font-size: 13dp; line-height: 16dp; }
#command_details {
  margin-top: 6dp; padding-top: 6dp; border-top: 1dp #303943;
  color: #aeb7c1; font-size: 12dp; line-height: 15dp; min-height: 30dp;
}
#command_details .key { color: #d5be91; }
/* === Workspace shell and tabs === */
#workspace_shell {
  position: absolute;
  left: 0dp;
  top: 0dp;
  right: 0dp;
  bottom: 240dp;
  min-width: 0dp;
  min-height: 0dp;
  display: flex;
  flex-direction: column;
  background: #171a1f;
  border-left: 1dp #202a33;
  z-index: 20;
  box-sizing: border-box;
}
#workspace_shell, #workspace_shell * { box-sizing: border-box; }
.play_preview_active #panel,
.play_preview_active #bottom_dock.visible,
.play_preview_active #workspace_tab_bar,
.play_preview_active .workspace_area_toolbar,
.play_preview_active .object_workbench {
  display: none;
}
.play_preview_active #workspace_shell {
  left: 0dp;
  bottom: 0dp;
}
.play_preview_active .workspace_preview_body,
.play_preview_active .workspace_area_surface {
  width: 100%;
  height: 100%;
}
.play_preview_active .workspace_viewer_viewport {
  margin: 0dp;
  border: 0dp transparent;
}
.play_preview_placement_pending .workspace_viewer_viewport {
  cursor: cross;
}
#workspace_tab_bar {
  display: flex;
  flex-shrink: 0;
  height: 38dp;
  min-height: 38dp;
  min-width: 0dp;
  background: #11161b;
  border-bottom: 1dp #2f3843;
}
#workspace_tabs {
  display: block;
  flex: 1;
  min-width: 0dp;
  height: 38dp;
  min-height: 38dp;
  overflow-x: auto;
  overflow-y: hidden;
  padding: 0dp 0dp;
}
#workspace_tabs scrollbarhorizontal {
  height: 2dp;
}
#workspace_tabs scrollbarhorizontal slidertrack {
  background: #0d1115;
  border: 0dp transparent;
}
#workspace_tabs scrollbarhorizontal sliderbar {
  height: 2dp;
  min-width: 30dp;
  background: #3a4652;
  border: 0dp transparent;
}
#workspace_tabs scrollbarhorizontal sliderbar:hover {
  background: #6f8192;
}
.workspace_tab_scroll_button {
  flex-shrink: 0;
  width: 26dp;
  min-width: 26dp;
  height: 37dp;
  min-height: 37dp;
  margin: 0dp;
  padding: 0dp;
  border: 0dp transparent;
  border-left: 1dp #2f3843;
  border-radius: 0dp;
  background: #171d23;
  color: #c4ced7;
  font-size: 22dp;
  line-height: 35dp;
  text-align: center;
  cursor: pointer;
}
.workspace_tab_scroll_button:hover {
  background: #28323b;
  color: #ffffff;
}
.workspace_tab_scroll_button.disabled,
.workspace_tab_scroll_button.disabled:hover {
  background: #11161b;
  color: #46515c;
  cursor: default;
}
#workspace_tab_track {
  display: flex;
  height: 36dp;
  min-height: 36dp;
}
.workspace_tab {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  min-width: 178dp;
  max-width: 336dp;
  height: 36dp;
  min-height: 36dp;
  padding: 0dp 10dp;
  margin: 0dp;
  color: #aeb8c3;
  border-left: 1dp #141a20;
  border-right: 1dp #141a20;
  border-top: 1dp #252e37;
  background: #20262d;
  cursor: pointer;
}
.workspace_tab.locked {
  cursor: pointer;
}
.workspace_tab.dragging {
  opacity: 0.72;
  cursor: grabbing;
}
.workspace_tab:hover {
  color: #e4e9ef;
  background: #262d35;
  border-color: #35414d;
}
.workspace_tab.active {
  color: #f0f3f6;
  background: #151a20;
  border-left: 1dp #303a44;
  border-right: 1dp #303a44;
  border-top: 2dp #8b7657;
}
.workspace_tab_home, .workspace_tab_area {
  min-width: 46dp;
  width: 46dp;
  max-width: 46dp;
  padding: 0dp;
  text-align: center;
  justify-content: center;
}
.workspace_tab_home .workspace_tab_title, .workspace_tab_area .workspace_tab_title {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46dp;
  height: 36dp;
  text-align: center;
  font-size: 0dp;
  line-height: 0dp;
}
.workspace_tab_area {
  position: relative;
}
.workspace_tab_dirty {
  display: none;
  position: absolute;
  top: 4dp;
  right: 4dp;
  width: 8dp;
  height: 8dp;
  border: 1dp #151a20;
  border-radius: 5dp;
  background: #d5b06f;
  pointer-events: none;
}
.workspace_tab.dirty .workspace_tab_dirty {
  display: block;
}
.workspace_tab_graphic {
  display: block;
  position: relative;
  width: 24dp;
  height: 22dp;
  min-width: 24dp;
  pointer-events: none;
}
/* === Tab icons (CSS pixel art — intentional, do not refactor) ===
 * Each icon is hand-built from absolutely positioned divs; the coordinate
 * and size repetition below is inherent to the technique. */
.home_icon_cabinet, .home_icon_drawer, .home_icon_label, .home_icon_handle, .home_icon_base,
.area_icon_panel, .area_icon_path, .area_icon_dot {
  display: block;
  position: absolute;
  pointer-events: none;
}
.home_icon_cabinet {
  left: 4dp;
  top: 3dp;
  width: 16dp;
  height: 17dp;
  background: #26323b;
  border: 1dp #8b7657;
}
.home_icon_drawer {
  left: 6dp;
  width: 12dp;
  height: 7dp;
  border-bottom: 1dp #6d5e45;
}
.home_icon_drawer_1 {
  top: 5dp;
}
.home_icon_drawer_2 {
  top: 12dp;
}
.home_icon_label {
  left: 8dp;
  width: 4dp;
  height: 2dp;
  background: #9fc5d7;
}
.home_icon_label_1 {
  top: 7dp;
}
.home_icon_label_2 {
  top: 14dp;
}
.home_icon_handle {
  left: 13dp;
  width: 3dp;
  height: 1dp;
  background: #c7b284;
}
.home_icon_handle_1 {
  top: 8dp;
}
.home_icon_handle_2 {
  top: 15dp;
}
.home_icon_base {
  left: 5dp;
  top: 20dp;
  width: 14dp;
  height: 2dp;
  background: #c7b284;
}
.area_icon_panel {
  top: 4dp;
  height: 15dp;
  border: 1dp #536677;
  background: #22303a;
}
.area_icon_panel_1 {
  left: 2dp;
  width: 7dp;
}
.area_icon_panel_2 {
  left: 9dp;
  width: 6dp;
  background: #1b262e;
}
.area_icon_panel_3 {
  left: 15dp;
  width: 7dp;
}
.area_icon_path {
  background: #a8c5d5;
}
.area_icon_path_1 {
  left: 5dp;
  top: 14dp;
  width: 6dp;
  height: 2dp;
}
.area_icon_path_2 {
  left: 10dp;
  top: 10dp;
  width: 2dp;
  height: 6dp;
}
.area_icon_path_3 {
  left: 10dp;
  top: 10dp;
  width: 8dp;
  height: 2dp;
}
.area_icon_dot {
  width: 3dp;
  height: 3dp;
  background: #d0b36e;
}
.area_icon_dot_1 {
  left: 4dp;
  top: 13dp;
}
.area_icon_dot_2 {
  left: 17dp;
  top: 9dp;
}
.workspace_tab.active .home_icon_cabinet, .workspace_tab:hover .home_icon_cabinet {
  background: #2d3b45;
  border-color: #c7b284;
}
.workspace_tab.active .home_icon_handle, .workspace_tab:hover .home_icon_handle,
.workspace_tab.active .home_icon_base, .workspace_tab:hover .home_icon_base {
  background: #e2cc98;
}
.workspace_tab.active .home_icon_label, .workspace_tab:hover .home_icon_label {
  background: #c7e1ec;
}
.workspace_tab.active .area_icon_panel, .workspace_tab:hover .area_icon_panel {
  border-color: #7e95a8;
}
.workspace_tab.active .area_icon_path, .workspace_tab:hover .area_icon_path {
  background: #c7e1ec;
}
.workspace_tab.active .area_icon_dot, .workspace_tab:hover .area_icon_dot {
  background: #e1c37a;
}
.workspace_tab_icon {
  display: block;
  width: 26dp;
  min-width: 26dp;
  margin-right: 7dp;
  color: #8fc5dd;
  font-size: 11dp;
  font-weight: 800;
  line-height: 14dp;
  text-align: left;
  text-transform: uppercase;
  pointer-events: none;
}
.workspace_tab_icon_project {
  color: #c9a8ec;
}
.workspace_tab_icon_area {
  color: #9fb8d0;
}
.workspace_tab_icon_preview {
  color: #c0a86a;
}
.workspace_tab_icon_module {
  color: #d5b06f;
}
.workspace_tab_icon_resource {
  color: #78bfd8;
}
.workspace_tab_title {
  display: block;
  flex: 1;
  min-width: 0dp;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 13dp;
  line-height: 17dp;
  pointer-events: none;
}
.workspace_tab_close, .workspace_subtab_close {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding: 0dp;
  color: #8f9daa;
  border: 1dp transparent;
  border-radius: 2dp;
  text-align: center;
  font-weight: 700;
  cursor: pointer;
}
.workspace_tab_close:hover, .workspace_subtab_close:hover {
  color: #f0f3f6;
  background: #303a44;
  border-color: #536170;
}
.workspace_tab_close_glyph, .workspace_subtab_close_glyph {
  display: block;
  font-weight: 700;
  pointer-events: none;
}
.workspace_tab_close {
  width: 20dp;
  min-width: 20dp;
  max-width: 20dp;
  height: 20dp;
  min-height: 20dp;
  max-height: 20dp;
  margin-left: 8dp;
  font-size: 16dp;
  line-height: 20dp;
}
.workspace_tab_close_glyph {
  font-size: 15dp;
  line-height: 18dp;
}
.workspace_tab.active .workspace_tab_close {
  color: #d4dbe2;
}
.workspace_subtabs {
  display: flex;
  height: 30dp;
  min-height: 30dp;
  padding: 0dp 10dp;
  background: #141a20;
  border-bottom: 1dp #2b3540;
}
.workspace_subtab {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  min-width: 78dp;
  max-width: 180dp;
  height: 29dp;
  padding: 6dp 8dp 5dp 10dp;
  margin: 0dp 2dp 0dp 0dp;
  color: #aeb8c3;
  border-left: 1dp transparent;
  border-right: 1dp transparent;
  border-top: 1dp transparent;
  background: #151b21;
  cursor: pointer;
}
.workspace_subtab:hover {
  color: #e4e9ef;
  background: #1d252d;
  border-color: #35414d;
}
.workspace_subtab.active {
  color: #f0f3f6;
  background: #1d252d;
  border-color: #8b7657;
}
.workspace_subtab_title {
  display: block;
  flex: 1;
  min-width: 0dp;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 12dp;
  font-weight: 600;
  line-height: 15dp;
  pointer-events: none;
}
.workspace_subtab_close {
  width: 14dp;
  min-width: 14dp;
  max-width: 14dp;
  height: 14dp;
  min-height: 14dp;
  max-height: 14dp;
  margin-left: 7dp;
  font-size: 11dp;
  line-height: 14dp;
}
.workspace_subtab_close_glyph {
  font-size: 11dp;
  line-height: 12dp;
}
/* === Workspace content: home, documents, area, resource inspector === */
#workspace_content {
  flex: 1;
  min-width: 0dp;
  min-height: 0dp;
  overflow: auto;
  background: #171a1f;
}
.workspace_home_surface {
  display: flex;
  width: 100%;
  height: 100%;
  min-width: 0dp;
  min-height: 0dp;
  overflow: hidden;
}
#workspace_home {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0dp;
  min-height: 0dp;
  overflow: hidden;
  color: #e2e6eb;
}
.workspace_home_content {
  display: flex;
  flex-direction: column;
  flex: 1;
  width: auto;
  min-width: 0dp;
  min-height: 0dp;
  padding: 36dp 40dp;
  box-sizing: border-box;
}
#workspace_home_header {
  display: flex;
}
#workspace_home_title {
  display: block;
  color: #f4f6f8;
  font-size: 24dp;
  font-weight: 700;
  line-height: 30dp;
}
#workspace_home_subtitle {
  display: block;
  color: #d5be91;
  font-size: 13dp;
  font-weight: 600;
  line-height: 17dp;
}
#home_project_list {
  display: block;
  width: 100%;
}
.home_project_actions {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 8dp;
}
.home_project_actions button, .home_import_row button {
  height: 34dp;
  padding: 6dp 14dp;
  margin-right: 8dp;
  margin-bottom: 4dp;
  border: 1dp #536371;
  border-radius: 2dp;
  background: #202930;
  color: #e4e9ed;
  font-size: 14dp;
  cursor: pointer;
}
.home_app_version {
  display: block;
  margin-bottom: 12dp;
  color: #96a0aa;
  font-size: 12dp;
}
.home_project_actions button:hover,
.home_project_actions button:focus,
.home_import_row button:hover, .home_import_row button:focus {
  border-color: #a78d62;
  background: #28333d;
}
.home_project_actions button:disabled, .home_import_row button:disabled {
  color: #85909b;
  cursor: arrow;
}
.home_import_status {
  display: block;
  max-height: 96dp;
  overflow: auto;
  margin-bottom: 22dp;
  color: #adb9c4;
  font-size: 13dp;
}
.home_import_panel {
  display: block;
  flex-shrink: 0;
  min-width: 0dp;
  box-sizing: border-box;
  padding: 16dp;
  margin-bottom: 12dp;
  border: 1dp #303943;
  background: #171e25;
}
.home_import_row {
  display: flex;
  align-items: center;
  margin-bottom: 8dp;
}
.home_import_label {
  flex: 0 0 90dp;
  font-size: 13dp;
}
.home_import_path {
  flex: 1;
  min-width: 0dp;
  margin-right: 8dp;
  padding: 6dp 8dp;
  border: 1dp #303943;
  background: #0d1115;
  font-size: 13dp;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.home_import_row button { flex-shrink: 0; }
.home_import_hint {
  display: block;
  margin-bottom: 12dp;
  color: #adb9c4;
  font-size: 12dp;
}
.home_import_progress {
  display: block;
  position: relative;
  height: 8dp;
  overflow: hidden;
  background: #0d1115;
}
.home_import_progress_fill {
  position: absolute;
  width: 30%;
  height: 100%;
  background: #d5b06f;
  animation: 1.2s linear infinite alternate import_busy;
}
@keyframes import_busy {
  from { left: 0%; }
  to { left: 70%; }
}
.home_project_row {
  display: flex;
  width: 100%;
  margin-bottom: 6dp;
  align-items: center;
}
.home_project_item {
  display: block;
  flex: 1;
  min-width: 0dp;
  padding: 8dp 10dp;
  border: 1dp #303943;
  background: #151b21;
  cursor: pointer;
}
.home_project_item:hover {
  background: #1d252d;
  border-color: #667989;
}
.home_project_item.unavailable { border-color: #995b5b; }
.home_project_error {
  display: block;
  margin-top: 4dp;
  color: #efa0a0;
  font-size: 12dp;
  line-height: 16dp;
  pointer-events: none;
}
.home_project_remove {
  flex: 0 0 28dp;
  width: 28dp;
  height: 28dp;
  margin-left: 8dp;
  padding: 0dp;
  border: 1dp transparent;
  border-radius: 2dp;
  background: transparent;
  color: #e07979;
  font-size: 20dp;
  line-height: 26dp;
  text-align: center;
  cursor: pointer;
  box-sizing: border-box;
}
.home_project_remove:hover,
.home_project_remove:focus {
  color: #f0a0a0;
  border-color: #744545;
  background: #2a1b1b;
}
.home_project_name {
  display: block;
  color: #f0f3f5;
  font-size: 14dp;
  font-weight: 600;
  line-height: 18dp;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  pointer-events: none;
}
.home_project_path {
  display: block;
  margin-top: 2dp;
  color: #9faab5;
  font-size: 12dp;
  line-height: 15dp;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  pointer-events: none;
}
.home_empty {
  color: #96a0aa;
  font-size: 13dp;
  line-height: 17dp;
}
.home_section_title {
  margin-bottom: 8dp;
  color: #f0f3f5;
  font-size: 14dp;
  font-weight: 700;
  line-height: 18dp;
}
#home_area_browser {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0dp;
  min-height: 0dp;
}
.home_area_browser_header {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
}
.home_area_browser_header .home_section_title {
  flex: 1;
  min-width: 0dp;
}
.home_area_count {
  flex: 0 0 auto;
  color: #8f9ba7;
  font-size: 12dp;
  font-weight: 700;
  line-height: 18dp;
}
.home_area_search {
  display: block;
  flex: 0 0 30dp;
  width: 100%;
  height: 30dp;
  min-height: 30dp;
  margin-bottom: 8dp;
  padding: 5dp 8dp;
  border: 1dp #35414c;
  background: #11171c;
  color: #e1e6eb;
  box-sizing: border-box;
}
.home_area_list {
  display: block;
  flex: 1;
  min-width: 0dp;
  min-height: 0dp;
  overflow-y: auto;
  overflow-x: hidden;
}
.home_area_grid_row {
  display: flex;
  width: 100%;
  height: 190dp;
  min-height: 190dp;
  gap: 8dp;
  box-sizing: border-box;
}
.home_area_card {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0dp;
  height: 182dp;
  padding: 7dp;
  border: 1dp #303943;
  background: #151b21;
  cursor: pointer;
  box-sizing: border-box;
}
.home_area_card:hover,
.home_area_card:focus {
  border-color: #6c8192;
  background: #1d252d;
}
.home_area_card_filler {
  visibility: hidden;
  pointer-events: none;
}
.home_area_map {
  display: flex;
  flex: 0 0 120dp;
  height: 120dp;
  min-height: 120dp;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #0f1418;
  pointer-events: none;
}
.home_area_map img {
  display: block;
  max-width: 100%;
  max-height: 120dp;
  pointer-events: none;
}
.home_area_map_missing {
  color: #68737e;
  font-size: 11dp;
  font-weight: 600;
  pointer-events: none;
}
.home_area_name {
  margin-top: 7dp;
  color: #f0f3f5;
  font-size: 13dp;
  font-weight: 700;
  line-height: 17dp;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  pointer-events: none;
}
.home_area_resref {
  color: #8f9ba7;
  font-size: 11dp;
  line-height: 14dp;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  pointer-events: none;
}
.home_area_spacer {
  display: block;
  width: 1dp;
}
.workspace_document {
  padding: 36dp 40dp;
}
.workspace_document_title {
  color: #f4f6f8;
  font-size: 22dp;
  font-weight: 700;
  line-height: 28dp;
}
.workspace_document_detail {
  margin-top: 6dp;
  color: #aab4bf;
  font-size: 13dp;
  line-height: 17dp;
}
.workspace_area_surface {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  min-width: 0dp;
  min-height: 0dp;
  overflow: hidden;
  background: #171a1f;
}
.workspace_area_toolbar {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  height: 34dp;
  min-height: 34dp;
  padding: 0dp 12dp;
  border-bottom: 1dp #2b3540;
  background: #151b21;
}
.workspace_area_title {
  flex: 0 1 auto;
  min-width: 0dp;
  color: #f0f3f6;
  font-size: 14dp;
  font-weight: 700;
  line-height: 18dp;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.workspace_area_detail {
  flex: 1;
  min-width: 0dp;
  margin-left: 10dp;
  color: #9faab5;
  font-size: 12dp;
  font-weight: 500;
  line-height: 15dp;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.workspace_area_tabs.object_workbench_tab_track {
  flex: 0 0 auto;
  height: 34dp;
  padding: 2dp 0dp 0dp 0dp;
  box-sizing: border-box;
}
.workspace_area_tabs .object_workbench_tab {
  padding-left: 10dp;
  padding-right: 10dp;
}
.workspace_viewer_viewport {
  flex: 1;
  min-width: 0dp;
  min-height: 0dp;
  margin: 10dp;
  border: 1dp #303943;
  background: #3d4d6b;
  overflow: hidden;
}
.workspace_viewer_viewport.empty {
  display: flex;
  align-items: center;
  justify-content: center;
}
.workspace_preview_body {
  display: flex;
  flex: 1;
  min-width: 0dp;
  min-height: 0dp;
}
.workspace_preview_body .workspace_viewer_viewport {
  margin-right: 0dp;
}
.workspace_preview_body.data_workbench_only .workspace_viewer_viewport {
  display: none;
}
.workspace_preview_body.data_workbench_only .object_workbench {
  flex: 1;
  width: auto;
  min-width: 0dp;
  margin: 10dp;
  border: 1dp #2b3540;
}
.object_workbench {
  position: relative;
  display: flex;
  flex-direction: column;
  flex: 0 1 440dp;
  width: 440dp;
  min-width: 320dp;
  min-height: 0dp;
  overflow: hidden;
  border-left: 1dp #2b3540;
  background: #151b21;
  color: #dce3ea;
  box-sizing: border-box;
}
/* Selection must not resize the area viewport while the pointer is held.
 * Standalone blueprint workbenches retain their type-specific widths. */
.workspace_preview_body.workspace_area_body .object_workbench {
  flex-basis: 440dp;
  width: 440dp;
}
.area_tile_palette {
  flex-basis: 360dp;
  width: 360dp;
  min-width: 300dp;
}
.area_tile_palette_header {
  display: flex;
  align-items: center;
  gap: 9dp;
}
.area_tile_palette_heading {
  flex: 1;
  min-width: 0dp;
}
.area_tile_palette_controls {
  flex: 0 0 auto;
  padding: 10dp 12dp;
  border-bottom: 1dp #2b3540;
}
#area_tile_palette_search {
  width: 100%;
  height: 30dp;
  padding: 5dp 7dp;
  border: 1dp #3a4652;
  border-radius: 2dp;
  background: #0f1318;
  color: #e7ebef;
  box-sizing: border-box;
}
.area_tile_modifier_hint {
  display: none;
  margin-top: 7dp;
  padding: 6dp 8dp;
  border: 1dp #3d5948;
  border-radius: 2dp;
  background: #18231d;
  color: #a8d9b5;
  font-size: 10dp;
  line-height: 15dp;
}
.area_tile_modifier_hint.visible {
  display: block;
}
.area_tile_selection_info {
  display: none;
  flex: 0 0 auto;
  padding: 8dp 12dp 9dp 12dp;
  border-bottom: 1dp #3d493f;
  background: #18231d;
  box-sizing: border-box;
}
.area_tile_selection_info.visible {
  display: block;
}
.area_tile_selection_title {
  color: #82d49a;
  font-size: 10dp;
  font-weight: 700;
  line-height: 14dp;
  text-transform: uppercase;
}
.area_tile_selection_name {
  color: #e4e9ed;
  font-size: 12dp;
  font-weight: 600;
  line-height: 18dp;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.area_tile_selection_meta {
  color: #9da9b2;
  font-size: 10dp;
  line-height: 15dp;
}
.area_tile_light_panel {
  display: none;
  flex: 0 0 auto;
  padding: 8dp 12dp 10dp 12dp;
  border-bottom: 1dp #35424c;
  background: #12191e;
  box-sizing: border-box;
}
.area_tile_light_panel.visible {
  display: block;
}
.area_tile_light_title {
  color: #b8c2c9;
  font-size: 10dp;
  font-weight: 700;
  line-height: 16dp;
  text-transform: uppercase;
}
.area_tile_light_fields {
  display: block;
  border: 1dp #35424c;
  background: #11171b;
}
.area_tile_light_field {
  display: flex;
  align-items: center;
  width: 100%;
  height: 30dp;
  padding: 4dp 6dp;
  border-width: 0dp 0dp 1dp 0dp;
  border-color: #28333c;
  background: transparent;
  color: #dbe1e5;
  box-sizing: border-box;
  cursor: pointer;
}
.area_tile_light_field:hover {
  background: #1b252c;
}
.area_tile_light_label,
.area_tile_light_value,
.area_tile_light_swatch {
  pointer-events: none;
}
.area_tile_light_label {
  flex: 1;
  color: #dbe1e5;
  font-size: 11dp;
  text-align: left;
}
.area_tile_light_value {
  width: 104dp;
  color: #9eabb4;
  font-size: 10dp;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.area_tile_light_swatch {
  display: block;
  width: 25dp;
  height: 18dp;
  margin-left: 7dp;
  border: 1dp #65717a;
  background: #0a0d10;
  color: #aab4bb;
  font-size: 10dp;
  line-height: 16dp;
  text-align: center;
  box-sizing: border-box;
}
.area_tile_light_palette {
  margin-top: 8dp;
}
.area_tile_light_palette_title {
  margin-bottom: 5dp;
  color: #c7d0d6;
  font-size: 10dp;
  font-weight: 600;
  line-height: 14dp;
}
.area_tile_light_choices {
  display: block;
  width: 100%;
  border-width: 1dp 0dp 0dp 1dp;
  border-color: #4b5861;
  box-sizing: border-box;
}
.area_tile_light_choice_row {
  display: flex;
  width: 100%;
}
.area_tile_light_choice {
  display: block;
  flex: 1;
  min-width: 0dp;
  height: 30dp;
  padding: 3dp;
  border-width: 0dp 1dp 1dp 0dp;
  border-color: #4b5861;
  background: #1b242a;
  box-sizing: border-box;
  cursor: pointer;
}
.area_tile_light_choice:hover {
  border-color: #93a3ad;
  background: #25313a;
}
.area_tile_light_choice.selected {
  background: #d4b46f;
}
.area_tile_light_choice span {
  display: block;
  width: 100%;
  height: 100%;
  pointer-events: none;
}
.area_tile_light_choice.selected span {
  border: 1dp #f0d28d;
  box-sizing: border-box;
}
.area_tile_palette_rows {
  display: block;
  flex: 1;
  min-height: 0dp;
  overflow-x: hidden;
  overflow-y: auto;
  background: #13191e;
}
.area_tile_palette_row {
  display: flex;
  align-items: center;
  width: 100%;
  height: 58dp;
  padding: 4dp 8dp;
  border-bottom: 1dp #29333c;
  background: #151b21;
  box-sizing: border-box;
  cursor: pointer;
}
.area_tile_palette_row:hover,
.area_tile_palette_row.hovered {
  background: #202930;
}
.area_tile_palette_row.selected {
  padding-left: 6dp;
  border-left: 2dp #a78d62;
  background: #25313b;
}
.area_tile_palette_row * {
  pointer-events: none;
}
.area_tile_palette_thumbnail {
  display: flex;
  flex: 0 0 48dp;
  width: 48dp;
  height: 48dp;
  margin-right: 8dp;
  align-items: center;
  justify-content: center;
  background: #0f1318;
}
.area_tile_palette_thumbnail img {
  width: 48dp;
  height: 48dp;
}
.area_tile_palette_folder_indicator {
  flex-basis: 24dp;
  width: 24dp;
  height: 24dp;
  margin-right: 6dp;
  background: transparent;
}
.area_tile_palette_action_glyph {
  color: #c8d0d8;
  font-size: 22dp;
  font-weight: 700;
  line-height: 24dp;
}
.area_tile_palette_folder_glyph {
  color: #c8d0d8;
  font-size: 14dp;
  line-height: 14dp;
}
.area_tile_palette_text {
  display: flex;
  flex: 1;
  min-width: 0dp;
  align-items: center;
}
.area_tile_palette_action_name {
  color: #e4e9ed;
  font-size: 12dp;
  line-height: 18dp;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.object_workbench_header {
  flex: 0 0 auto;
  padding: 12dp 14dp 10dp 14dp;
  border-bottom: 1dp #2b3540;
}
.panel_back_button {
  display: flex;
  flex: 0 0 32dp;
  width: 32dp;
  height: 32dp;
  align-items: center;
  justify-content: center;
  padding: 0dp;
  border: 0dp transparent;
  border-radius: 0dp;
  background: transparent;
  color: #aeb8c3;
  cursor: pointer;
}
.panel_back_button:hover,
.panel_back_button:focus {
  color: #ffffff;
  background: #28333d;
}
.panel_back_icon {
  display: block;
  position: relative;
  width: 18dp;
  height: 12dp;
}
.panel_back_head {
  position: absolute;
  left: 1dp;
  top: 1dp;
  width: 0dp;
  height: 0dp;
  border-top: 5dp transparent;
  border-right: 7dp #aeb8c3;
  border-bottom: 5dp transparent;
}
.panel_back_shaft {
  position: absolute;
  left: 7dp;
  top: 5dp;
  width: 10dp;
  height: 2dp;
  background: #aeb8c3;
}
.panel_back_button:hover .panel_back_head,
.panel_back_button:focus .panel_back_head {
  border-right-color: #ffffff;
}
.panel_back_button:hover .panel_back_shaft,
.panel_back_button:focus .panel_back_shaft {
  background: #ffffff;
}
.area_object_header,
.area_object_list_header {
  display: flex;
  align-items: center;
  gap: 9dp;
}
.object_workbench_title {
  flex: 1;
  min-width: 0dp;
  color: #f4f6f8;
  font-size: 16dp;
  font-weight: 700;
  line-height: 20dp;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.area_object_list_count {
  flex: 0 0 auto;
  color: #8f9ba7;
  font-size: 12dp;
  font-weight: 700;
}
.area_object_list {
  display: block;
  flex: 1;
  min-width: 0dp;
  min-height: 0dp;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 6dp;
  background: #13191e;
  box-sizing: border-box;
}
.area_object_row {
  display: flex;
  width: 100%;
  min-width: 0dp;
  min-height: 34dp;
  margin-bottom: 4dp;
  padding: 6dp 8dp;
  border: 1dp #2d3742;
  background: #192027;
  color: #e8ecef;
  text-align: left;
  cursor: pointer;
  box-sizing: border-box;
}
.area_object_row:last-child { margin-bottom: 0dp; }
.area_object_row:hover {
  background: #222b34;
  border-color: #667989;
}
.area_object_row * { pointer-events: none; }
.area_object_row_name {
  flex: 1;
  min-width: 0dp;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.area_object_row_type {
  flex: 0 0 auto;
  margin-left: 8dp;
  color: #a99573;
  font-size: 12dp;
}
.object_workbench_tab_bar {
  display: flex;
  flex: 0 0 31dp;
  height: 31dp;
  min-width: 0dp;
  border-bottom: 1dp #303943;
  background: #171d23;
  box-sizing: border-box;
}
.object_workbench_tabs {
  display: block;
  flex: 1;
  min-width: 0dp;
  height: 30dp;
  overflow-x: auto;
  overflow-y: hidden;
}
.object_workbench_tabs scrollbarhorizontal {
  height: 1dp;
}
.object_workbench_tabs scrollbarhorizontal slidertrack,
.object_workbench_tabs scrollbarhorizontal sliderbar {
  background: transparent;
  border: 0dp transparent;
}
.object_workbench_tab_track {
  display: flex;
  height: 30dp;
  padding: 0dp 10dp;
}
.object_workbench_tab {
  flex-shrink: 0;
  padding: 7dp 7dp 5dp 7dp;
  color: #9faab5;
  font-size: 12dp;
  font-weight: 700;
  line-height: 18dp;
  border-bottom: 2dp transparent;
  cursor: pointer;
}
.object_workbench_tab.active {
  color: #eef2f5;
  border-bottom-color: #a78d62;
}
.object_workbench_tab_scroll_button {
  flex-shrink: 0;
  width: 23dp;
  min-width: 23dp;
  height: 30dp;
  min-height: 30dp;
  margin: 0dp;
  padding: 0dp;
  border: 0dp transparent;
  border-left: 1dp #303943;
  border-radius: 0dp;
  background: #171d23;
  color: #c4ced7;
  font-size: 19dp;
  line-height: 28dp;
  text-align: center;
  cursor: pointer;
}
.object_workbench_tab_scroll_button:hover {
  background: #28323b;
  color: #ffffff;
}
.object_workbench_tab_scroll_button.disabled,
.object_workbench_tab_scroll_button.disabled:hover {
  background: #171d23;
  color: #46515c;
  cursor: default;
}
.data_object_collection {
  display: flex;
  flex: 1;
  min-width: 0dp;
  min-height: 0dp;
  flex-direction: column;
  overflow: hidden;
  background: #13191e;
}
.data_object_collection.drop_valid {
  border: 2dp #36d875;
}
.data_object_collection.drop_invalid {
  border: 2dp #dc5c64;
}
.data_collection_header,
.data_collection_rows .managed_list_row {
  display: flex;
  min-width: 0dp;
  box-sizing: border-box;
}
.data_collection_header {
  flex: 0 0 31dp;
  min-height: 31dp;
  align-items: center;
  padding: 0dp 10dp;
  border-bottom: 1dp #303943;
  background: #171d23;
  color: #9faab5;
  font-size: 11dp;
  font-weight: 700;
  text-transform: uppercase;
}
.data_collection_summary {
  flex: 0 0 25dp;
  min-height: 25dp;
  padding: 0dp 10dp;
  border-bottom: 1dp #2a343e;
  background: #13191e;
  color: #7f8b96;
  font-size: 11dp;
  line-height: 25dp;
}
.data_collection_rows {
  display: block;
  flex: 1;
  min-width: 0dp;
  min-height: 0dp;
  overflow-y: auto;
  overflow-x: hidden;
}
.data_collection_action_bar {
  display: flex;
  flex: 0 0 38dp;
  align-items: center;
  justify-content: flex-end;
  min-height: 38dp;
  padding: 0dp 7dp;
  border-top: 1dp #36414c;
  background: #171e24;
  box-sizing: border-box;
}
.data_collection_action {
  position: relative;
  flex: 0 0 28dp;
  width: 28dp;
  min-width: 28dp;
  max-width: 28dp;
  height: 28dp;
  padding: 0dp;
  border: 1dp #43505c;
  border-radius: 0dp;
  background: #202a32;
  cursor: pointer;
}
.data_collection_action:hover,
.data_collection_action:focus {
  border-color: #bca36a;
  background: #2b3741;
}
.data_collection_action:active {
  background: #34434f;
}
.data_collection_action_mark {
  position: absolute;
  display: block;
  background: #79c98e;
  pointer-events: none;
}
.data_collection_action.remove {
  margin-right: 6dp;
}
.data_collection_action.remove .data_collection_action_mark {
  background: #d58484;
}
.data_collection_action_mark.horizontal {
  left: 7dp;
  top: 13dp;
  width: 12dp;
  height: 2dp;
}
.data_collection_action_mark.vertical {
  left: 12dp;
  top: 8dp;
  width: 2dp;
  height: 12dp;
}
.data_collection_rows .managed_list_row {
  min-height: 34dp;
  align-items: center;
  padding: 6dp 10dp;
  border-bottom: 1dp #2a343e;
  background: #151b21;
  color: #dce3ea;
  cursor: pointer;
}
.data_collection_rows .managed_list_row:hover {
  background: #202930;
}
.data_collection_rows .managed_list_row.selected {
  padding-left: 8dp;
  border-left: 2dp #a78d62;
  background: #25313b;
}
.managed_list_rows .managed_list_row.reorder_source {
  color: #7f8b96;
  background: #11171c;
}
.managed_list_rows .managed_list_row.reorder_before {
  border-top: 2dp #bca36a;
}
.managed_list_rows .managed_list_row.reorder_after {
  border-bottom: 2dp #bca36a;
}
.data_collection_header span,
.data_collection_rows .managed_list_cell {
  min-width: 0dp;
  padding-right: 10dp;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.encounter_spawn_header span:nth-child(1),
.encounter_spawn_rows .cell_0 { flex: 3; }
.encounter_spawn_header span:nth-child(2),
.encounter_spawn_rows .cell_1 { flex: 1; }
.encounter_spawn_header span:nth-child(3),
.encounter_spawn_rows .cell_2 { flex: 1; }
.encounter_spawn_header span:nth-child(4),
.encounter_spawn_rows .cell_3 { flex: 1; }
.sound_resource_header span,
.sound_resource_rows .cell_0 {
  flex: 1;
}
.managed_list_rows.reorderable .managed_list_row {
  cursor: grab;
}
.managed_list_rows.reorderable .managed_list_row.reorder_source {
  cursor: grabbing;
}
.sound_catalog_row {
  display: flex;
