  display: flex;
  flex: 0 0 340dp;
  flex-direction: row;
  justify-content: center;
  width: 100%;
  height: 340dp;
  min-width: 0dp;
  padding: 10dp 8dp;
  background: #13191e;
  box-sizing: border-box;
}
.creature_inventory_board {
  display: flex;
  position: relative;
  flex: 0 0 320dp;
  flex-wrap: wrap;
  width: 320dp;
  height: 320dp;
  background: #10161b;
  box-sizing: border-box;
  overflow: hidden;
}
.creature_inventory_cell {
  flex: 0 0 32dp;
  width: 32dp;
  height: 32dp;
  border-right: 1dp #46525e;
  border-bottom: 1dp #46525e;
  background: #12191f;
  box-sizing: border-box;
  pointer-events: none;
}
.creature_inventory_drop_target {
  display: none;
  position: absolute;
  z-index: 4;
  box-sizing: border-box;
  pointer-events: none;
}
.creature_inventory_drop_target.valid {
  border: 2dp #36d875;
  background: rgba(54, 216, 117, 61);
}
.creature_inventory_drop_target.invalid {
  border: 2dp #dc5c64;
  background: rgba(220, 92, 100, 61);
}
.creature_inventory_item {
  display: flex;
  position: absolute;
  align-items: center;
  justify-content: center;
  padding: 3dp;
  border: 2dp #7d6948;
  background: #26333d;
  color: #e4e9ed;
  box-sizing: border-box;
  cursor: pointer;
}
.creature_inventory_item:hover {
  background: #32434f;
  border-color: #a78d62;
}
.creature_inventory_item.selected {
  border-color: #36d875;
  background: #2d443d;
}
.creature_inventory_item * {
  pointer-events: none;
}
.creature_inventory_item_label {
  max-width: 100%;
  max-height: 100%;
  font-size: 10dp;
  line-height: 12dp;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
}
.creature_inventory_item_icon {
  max-width: 100%;
  max-height: 100%;
}
.creature_inventory_stack {
  position: absolute;
  right: 2dp;
  bottom: 1dp;
  color: #ffffff;
  font-family: RollnwMono;
  font-size: 9dp;
  line-height: 11dp;
  text-align: right;
}
.creature_inventory_pages {
  display: flex;
  flex: 0 0 28dp;
  flex-direction: column;
  width: 28dp;
  height: 320dp;
  margin-left: 6dp;
}
.creature_inventory_page {
  flex: 0 0 30dp;
  width: 28dp;
  height: 30dp;
  margin-bottom: 4dp;
  padding: 0dp;
  border: 1dp #46525e;
  border-radius: 0dp;
  background: #182027;
  color: #87949f;
  font-family: RollnwMono;
  font-size: 10dp;
  line-height: 28dp;
  text-align: center;
  cursor: pointer;
}
.creature_inventory_page:hover {
  background: #25313a;
  color: #dce3e9;
}
.creature_inventory_page.active {
  border-color: #a78d62;
  background: #2b3339;
  color: #e8d8bc;
}
.property_tree_empty {
  padding: 16dp 14dp;
  color: #8f9daa;
  font-size: 12dp;
  line-height: 16dp;
}
.workspace_area_placeholder {
  color: #8f9daa;
  font-size: 13dp;
  line-height: 17dp;
}
.workspace_resource_surface {
  display: flex;
  width: 100%;
  height: 100%;
  min-width: 0dp;
  min-height: 0dp;
  background: #171a1f;
}
.resource_inspector {
  flex: 1;
  min-width: 0dp;
  min-height: 0dp;
  padding: 18dp;
  overflow-y: auto;
  background: #171a1f;
  color: #dce3ea;
}
.resource_inspector.compact {
  flex: 0 0 330dp;
  width: 330dp;
  padding: 12dp;
  border-left: 1dp #2b3540;
  background: #151b21;
}
.resource_inspector_header {
  padding-bottom: 12dp;
  margin-bottom: 10dp;
  border-bottom: 1dp #2b3540;
}
.resource_inspector_title {
  color: #f4f6f8;
  font-size: 16dp;
  font-weight: 700;
  line-height: 20dp;
}
.resource_inspector_detail {
  margin-top: 4dp;
  color: #9faab5;
  font-size: 12dp;
  line-height: 15dp;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.resource_inspector_badges {
  display: flex;
  flex-wrap: wrap;
  gap: 5dp;
  margin-top: 9dp;
}
.resource_inspector_badge {
  padding: 2dp 6dp;
  border: 1dp #3a4652;
  border-radius: 3dp;
  background: #1d252c;
  color: #c4ced8;
  font-size: 11dp;
  font-weight: 700;
  line-height: 14dp;
}
.resource_inspector_empty {
  padding: 10dp 0dp;
  color: #aab4bf;
  font-size: 13dp;
  line-height: 17dp;
}
.resource_inspector_diagnostics {
  margin-bottom: 12dp;
}
.resource_inspector_diagnostic {
  display: flex;
  gap: 8dp;
  padding: 7dp 0dp;
  border-bottom: 1dp #2b3540;
  color: #cbd5df;
  font-size: 12dp;
  line-height: 16dp;
}
.resource_inspector_diagnostic_level {
  flex: 0 0 54dp;
  color: #e4c08a;
  font-weight: 700;
}
.resource_inspector_diagnostic_Error .resource_inspector_diagnostic_level {
  color: #f0a09a;
}
.resource_inspector_diagnostic_Info .resource_inspector_diagnostic_level {
  color: #9ab6d8;
}
.resource_inspector_diagnostic_message {
  flex: 1;
  min-width: 0dp;
}
.resource_property_group {
  margin-top: 12dp;
}
.resource_property_group_title {
  margin-bottom: 5dp;
  color: #f0f3f6;
  font-size: 12dp;
  font-weight: 700;
  line-height: 15dp;
  text-transform: uppercase;
}
.resource_property_row {
  display: flex;
  min-height: 26dp;
  border-bottom: 1dp #2b3540;
}
.resource_property_name {
  flex: 0 0 130dp;
  padding: 6dp 10dp 6dp 0dp;
  color: #9faab5;
  font-size: 12dp;
  font-weight: 600;
  line-height: 16dp;
}
.resource_property_value {
  flex: 1;
  min-width: 0dp;
  padding: 6dp 0dp;
  color: #e5ebf0;
  font-size: 12dp;
  line-height: 16dp;
  word-break: break-word;
}
.resource_inspector.compact .resource_property_name {
  flex-basis: 112dp;
}
/* === Bottom dock (output / terminal) === */
#bottom_dock {
  position: absolute; left: 0dp; bottom: 0dp; width: 100%; height: 240dp;
  min-height: 160dp; max-height: 720dp; background: #101418;
  border-top: 1dp #3d4650; z-index: 40; display: none;
  padding: 0dp 10dp 8dp 10dp; box-sizing: border-box;
}
#bottom_dock, #bottom_dock * { box-sizing: border-box; }
#bottom_dock.visible { display: flex; flex-direction: column; }
#bottom_dock_resize_grabber {
  display: block; height: 6dp; margin: 0dp 0dp 6dp 0dp; box-sizing: border-box;
  background: #151b21; border-bottom: 1dp #2f3843; cursor: resize;
}
#bottom_dock_resize_grabber:hover { background: #23313a; border-color: #657884; }
#bottom_dock_tabs {
  display: flex; gap: 4dp; margin-top: 6dp; margin-bottom: 0dp;
}
.dock_tab, .output_toggle {
  border: 1dp #35414d; border-radius: 3dp; background: #151b21;
  font-size: 13dp; line-height: 16dp;
}
.dock_tab.active, .output_toggle.active {
  color: #eadcc3; background: #222a32;
}
.dock_tab {
  min-height: 24dp; padding: 4dp 12dp; color: #aeb8c3;
}
.dock_tab.active { border-color: #9b835d; }
.dock_widget {
  display: none; flex: 1; min-height: 0; min-width: 0;
}
.dock_widget.visible {
  display: flex; flex-direction: column;
}
#terminal_output {
  width: 100%; height: auto; flex: 1; min-height: 0; min-width: 0;
  overflow-y: auto; overflow-x: hidden;
  background: #0e1318; border: 1dp #303943; padding: 6dp;
  box-sizing: border-box; margin-bottom: 6dp; font-family: RollnwMono;
  font-size: 14dp; font-weight: normal; line-height: 17dp;
}
#terminal_input {
  display: block; width: 100%; box-sizing: border-box; padding: 6dp 8dp;
  font-family: RollnwMono; font-size: 14dp; font-weight: normal; line-height: 17dp;
}
#output_panel {
  min-height: 0; min-width: 0;
}
#output_header { display: flex; gap: 4dp; margin-bottom: 6dp; }
.output_toggle {
  min-height: 22dp; min-width: 48dp; padding: 3dp 8dp; color: #aab4bf;
}
.output_toggle.active { border-color: #8b7657; }
#output_filter {
  flex: 1; min-width: 160dp; padding: 3dp 8dp; font-size: 14dp;
  line-height: 17dp;
}
#output_list {
  height: auto; flex: 1; min-height: 0; min-width: 0; display: block;
  overflow-y: auto; overflow-x: auto; border: 1dp #303943;
  background: #0e1318; padding: 6dp; box-sizing: border-box;
  cursor: text; tab-index: auto;
  font-family: RollnwMono; font-size: 14dp; font-weight: normal; line-height: 17dp;
}
.output_line {
  min-height: 17dp; margin-bottom: 1dp; line-height: 17dp; white-space: pre;
}
.output_line.info { color: #e1e6eb; }
.output_line.warn { color: #e8c993; }
.output_line.error { color: #ee9f9f; }
.output_line.script { color: #abd0f0; }
.output_text_selection { color: #f0f3f6; background: #8b7657; }
.terminal_line {
  margin-bottom: 1dp; line-height: 17dp; white-space: pre-wrap;
}
.terminal_line.cmd { color: #d5be91; }
.terminal_line.info { color: #d4d9df; }
.terminal_line.error { color: #e29898; }
#command_form_overlay {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #0009;
    z-index: 130;
    align-items: center;
    justify-content: center;
    pointer-events: auto;
}

#command_form_overlay.active { display: flex; }
.command_form button.command_form_action,
.command_form button.command_form_browse {
  height: 32dp; padding: 5dp 12dp;
  border: 1dp #536371; border-radius: 2dp;
  background-color: #202930; color: #e4e9ed;
  font-family: RollnwSans; font-size: 14dp; line-height: 20dp;
  cursor: pointer; tab-index: auto; box-sizing: border-box;
  flex-shrink: 0;
}
.command_form button.command_form_action:hover,
.command_form button.command_form_action:focus,
.command_form button.command_form_browse:hover,
.command_form button.command_form_browse:focus {
  border-color: #a78d62; background-color: #28333d;
}
.command_form button.command_form_action { min-width: 96dp; }
.command_form button.command_form_action_primary {
  border-color: #8b7657; background-color: #1d252d; color: #f0f3f6; font-weight: 600;
}
.command_form button.command_form_action_primary:hover, .command_form button.command_form_action_primary:focus {
  border-color: #a78d62; background-color: #28333d;
}
.command_form button.command_form_action_secondary { border-color: #536371; background-color: #202930; }
.command_form button.command_form_action:disabled,
.command_form button.command_form_action.disabled,
.command_form button.command_form_browse:disabled,
.command_form button.command_form_browse.disabled {
  color: #596570; background-color: #171d23; border-color: #303943; cursor: arrow;
}
.command_form {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 650dp;
    max-width: 90%;
    max-height: 90%;
    overflow-y: auto;
    padding: 22dp;
    background-color: #24282f;
    border: 1dp #555b66;
    box-sizing: border-box;
}
.command_form_title {
  display: block; flex: none; width: 100%; margin-bottom: 10dp;
  color: #f4f6f8; font-size: 18dp; font-weight: 600; line-height: 22dp;
}
.command_form_title_row {
  display: flex; flex: none; width: 100%; align-items: flex-start; margin-bottom: 10dp;
}
.command_form_title_row .command_form_title { flex: 1; width: auto; margin-bottom: 0dp; }
.command_form button.command_form_close {
  display: flex; flex: 0 0 24dp; align-items: center; justify-content: center;
  width: 24dp; min-width: 24dp; max-width: 24dp;
  height: 24dp; min-height: 24dp; max-height: 24dp;
  margin: -2dp -2dp 0dp 8dp; padding: 0dp;
  border: 1dp transparent; border-radius: 2dp;
  background: transparent; color: #a7b0ba; cursor: pointer;
}
.command_form button.command_form_close:hover,
.command_form button.command_form_close:focus {
  border-color: #536170; background: #303a44; color: #f0f3f6;
}
.command_form_close_glyph {
  display: block; font-size: 17dp; font-weight: 700; line-height: 20dp; pointer-events: none;
}
.command_form_message { display: block; flex: none; width: 100%; margin-bottom: 4dp; color: #a7b0ba; line-height: 19dp; }
.command_form_row { display: flex; flex: none; width: 100%; align-items: center; margin-top: 12dp; box-sizing: border-box; }
.command_form_row label { flex: 0 0 100dp; }
.command_form_row input {
  flex: 1; min-width: 0dp; height: 32dp; box-sizing: border-box;
  padding: 5dp 8dp; border: 1dp #3a4652; border-radius: 2dp;
  background: #0f1318; color: #e7ebef;
  font-family: RollnwSans; font-weight: 500; font-size: 14dp; line-height: 20dp;
  tab-index: auto;
}
.command_form_row input:focus { border-color: #a78d62; }
.command_form_row .combobox_field {
  flex: 1;
  height: 32dp;
  font-family: RollnwSans;
  font-size: 14dp;
  font-weight: 500;
}
.command_form_row .combobox_value,
.command_form_row .combobox_arrow {
  height: 30dp;
  line-height: 30dp;
}
.command_form_combobox_popup { display: none; z-index: 120; }
.command_form_combobox_popup.active { display: block; }
.command_form button.command_form_browse { margin-left: 8dp; background-color: #202930; }
.command_form_feedback { display: flex; flex: none; width: 100%; flex-direction: column; margin-top: 14dp; }
.command_form_actions { display: flex; flex: none; width: 100%; justify-content: flex-end; margin-top: 18dp; }
.command_form_actions button { margin-left: 8dp; }
.command_form_action_picker { width: 420dp; }
.command_form_action_list {
  flex-direction: column; align-items: stretch; justify-content: flex-start;
  margin-top: 10dp; padding: 4dp 0dp;
  border-top: 1dp #303943; border-bottom: 1dp #303943;
}
.command_form .command_form_action_list button.command_form_action {
  display: block; width: 100%; height: 32dp; margin: 0dp; padding: 5dp 10dp;
  border: 0dp transparent; border-left: 2dp transparent; border-radius: 0dp;
  background: transparent; color: #e8ecef; text-align: left; font-weight: 500;
}
.command_form .command_form_action_list button.command_form_action_primary {
  color: #d5be91; font-weight: 600;
}
.command_form .command_form_action_list button.command_form_action:hover,
.command_form .command_form_action_list button.command_form_action:focus {
  border-left-color: #a78d62; background: #222b34; color: #f0f3f6;
}
#command_form_filename { display: block; flex: none; width: 100%; color: #a7b0ba; word-break: break-all; }
#command_form_detail { display: block; flex: none; width: 100%; margin-top: 6dp; color: #a7b0ba; white-space: pre-wrap; word-break: break-all; }
#command_form_error { display: block; flex: none; width: 100%; margin-top: 6dp; color: #e29898; white-space: pre-wrap; word-break: break-all; }

#blueprint_operation_overlay {
  display: none;
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 110;
  background: #000a;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
}
#blueprint_operation_overlay.active { display: flex; tab-index: auto; }

#project_load_overlay {
  display: none;
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 120;
  background: #000a;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
}
#project_load_overlay.active { display: flex; tab-index: auto; }
.project_load_panel { width: 520dp; }
.project_load_path {
  display: block; flex: none; width: 100%; margin-top: 10dp;
  color: #a7b0ba; line-height: 19dp; white-space: pre-wrap;
  word-break: break-all;
}
.project_load_panel .home_import_progress { width: 100%; margin-top: 14dp; }

.blueprint_operation_stage {
  display: block; flex: none; width: 100%; margin-bottom: 10dp;
  color: #d5be91; font-weight: 600; line-height: 19dp;
}
.blueprint_operation_progress_text,
.blueprint_operation_detail,
.blueprint_operation_summary {
  display: block; flex: none; width: 100%; margin-top: 8dp; line-height: 19dp;
  white-space: pre-wrap; word-break: break-word;
}
.blueprint_operation_detail { color: #a7b0ba; }
.blueprint_operation_page_actions {
  display: flex; width: 100%; align-items: center; justify-content: center; margin-bottom: 10dp;
}
.blueprint_operation_page_actions span { margin: 0dp 10dp; }
.blueprint_progress_fill { display: block; height: 100%; background: #d5b06f; }
.blueprint_review_documents { display: block; width: 100%; max-height: 330dp; overflow-y: auto; margin: 10dp 0dp 12dp 0dp; }
.blueprint_review_documents > div { display: block; }
.blueprint_operation_error { display: block; width: 100%; color: #e29898; white-space: pre-wrap; word-break: break-all; margin: 8dp 0dp; }
