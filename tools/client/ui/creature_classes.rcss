.creature_classes_editor {
  display: block;
  flex: 1;
  min-width: 0dp;
  min-height: 0dp;
  overflow-y: auto;
  overflow-x: hidden;
  background: #13191e;
}

.creature_classes_header {
  display: flex;
  height: 29dp;
  padding: 0dp 10dp;
  border-bottom: 1dp #303a43;
  background: #1c252c;
  color: #aeb8c3;
  font-size: 12dp;
  font-weight: 700;
  line-height: 29dp;
  box-sizing: border-box;
}

.creature_classes_header span:first-child {
  flex: 1;
  min-width: 0dp;
}

.creature_classes_header span:last-child {
  flex: 0 0 104dp;
  text-align: center;
}

.creature_class_row {
  display: flex;
  height: 31dp;
  border-bottom: 1dp #29333c;
  background: #151b21;
  color: #eef2f5;
  font-size: 12dp;
  line-height: 30dp;
  box-sizing: border-box;
}

.creature_class_row.alternate {
  background: #192127;
}

.creature_class_name {
  flex: 1;
  min-width: 0dp;
  padding: 0dp 10dp 0dp 14dp;
  border-right: 1dp #29333c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}

.creature_class_level_controls {
  flex: 0 0 104dp;
}
