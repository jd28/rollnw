.creature_classes_editor {
  display: block;
  flex: 1;
  min-width: 0dp;
  min-height: 0dp;
  overflow-y: auto;
  overflow-x: hidden;
  background: #13191e;
}

.creature_classes_header {
  display: flex;
  height: 29dp;
  padding: 0dp 0dp 0dp 14dp;
  border-bottom: 1dp #303a43;
  background: #1c252c;
  color: #aeb8c3;
  font-size: 12dp;
  font-weight: 700;
  line-height: 29dp;
  box-sizing: border-box;
}

.creature_classes_header span:first-child {
  flex: 1;
  min-width: 0dp;
}

.creature_classes_header span:nth-child(2) {
  flex: 0 0 104dp;
  text-align: center;
}

.creature_class_row {
  display: flex;
  height: 31dp;
  border-bottom: 1dp #29333c;
  background: #151b21;
  color: #eef2f5;
  font-size: 12dp;
  line-height: 30dp;
  box-sizing: border-box;
}

.creature_class_row.alternate {
  background: #192127;
}

.creature_class_name {
  flex: 1;
  width: auto;
  min-width: 0dp;
  height: 27dp;
  margin: 1dp 4dp;
  padding: 0dp 6dp;
  text-align: left;
}

.creature_class_name .combobox_value,
.creature_class_name .combobox_arrow {
  height: 25dp;
  line-height: 25dp;
}

.creature_class_level_controls {
  flex: 0 0 104dp;
}

.creature_class_name:hover {
  background: #26333e;
}

.creature_class_actions {
  flex: 0 0 30dp;
  text-align: center;
}

.creature_class_remove { margin: 2dp 0dp; }
