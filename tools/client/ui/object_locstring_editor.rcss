.object_locstring_surface {
  display: none;
  flex: 1;
  min-width: 0px;
  min-height: 0px;
  flex-direction: column;
  background: #13191e;
}
.object_locstring_surface.active {
  display: flex;
}
.object_locstring_header {
  display: flex;
  align-items: center;
  gap: 10px;
  height: 38px;
  padding: 0 10px;
  border-bottom: 1px #36414c;
  color: #d8e2e9;
}
.object_locstring_rows {
  flex: 1;
  min-height: 0px;
  overflow-y: auto;
  padding: 10px;
}
.object_locstring_mode {
  display: none;
}
.object_locstring_mode.active {
  display: block;
}
.object_locstring_language_controls.hidden {
  display: none;
}
.object_locstring_section {
  margin: 14px 0 7px 0;
  color: #d8e2e9;
  font-size: 13px;
}
.object_locstring_resolved {
  display: block;
  width: 100%;
  height: 190px;
  padding: 8px;
  box-sizing: border-box;
  background: #1d2730;
  border: 1px #40505e;
  color: #e7eff5;
  overflow-x: hidden;
  overflow-y: auto;
  white-space: pre-wrap;
  word-break: break-word;
}
.object_locstring_language_controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 34px;
}
.object_locstring_language_controls .object_locstring_section {
  margin: 0px;
}
.object_locstring_strref_input {
  display: block;
  width: 100%;
  min-width: 0px;
  height: 30px;
  box-sizing: border-box;
  padding: 5px 7px;
  background: #1d2730;
  border: 1px #40505e;
  color: #e7eff5;
}
.object_locstring_text_input {
  display: block;
  width: 100%;
  height: 190px;
  box-sizing: border-box;
  padding: 9px;
  background: #1d2730;
  border: 1px #40505e;
  color: #e7eff5;
  white-space: pre-wrap;
}
.object_locstring_source_field {
  height: 30px;
  background: #1d2730;
  border-color: #40505e;
}
.object_locstring_gender_toggle {
  display: block;
  width: 100px;
  height: 30px;
  padding: 0px 10px;
  background: #2e3d48;
  border: 1px #49616e;
  color: #d8e2e9;
  font-size: 13px;
  line-height: 19px;
  text-align: center;
  box-sizing: border-box;
  cursor: pointer;
}
.object_locstring_gender_toggle.active {
  background: #3a342b;
  border-color: #7a6745;
  color: #f0d6a5;
}
