.object_locstring_surface {
  display: none;
  flex: 1;
  min-width: 0dp;
  min-height: 0dp;
  flex-direction: column;
  background: #13191e;
}
.object_locstring_surface.active {
  display: flex;
}
.object_locstring_header {
  display: flex;
  align-items: center;
  gap: 10dp;
  height: 38dp;
  padding: 0 10dp;
  border-bottom: 1dp #36414c;
  color: #d8e2e9;
}
.object_locstring_rows {
  flex: 1;
  min-height: 0dp;
  overflow-y: auto;
  padding: 10dp;
}
.object_locstring_mode {
  display: none;
}
.object_locstring_mode.active {
  display: block;
}
.object_locstring_language_controls.hidden {
  display: none;
}
.object_locstring_section {
  margin: 14dp 0 7dp 0;
  color: #d8e2e9;
  font-size: 13dp;
}
.object_locstring_resolved {
  display: block;
  width: 100%;
  height: 190dp;
  padding: 8dp;
  box-sizing: border-box;
  background: #1d2730;
  border: 1dp #40505e;
  color: #e7eff5;
  overflow-x: hidden;
  overflow-y: auto;
  white-space: pre-wrap;
  word-break: break-word;
}
.object_locstring_language_controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 34dp;
}
.object_locstring_language_controls .object_locstring_section {
  margin: 0dp;
}
.object_locstring_strref_input {
  display: block;
  width: 100%;
  min-width: 0dp;
  height: 30dp;
  box-sizing: border-box;
  padding: 5dp 7dp;
  background: #1d2730;
  border: 1dp #40505e;
  color: #e7eff5;
}
.object_locstring_text_input {
  display: block;
  width: 100%;
  height: 190dp;
  box-sizing: border-box;
  padding: 9dp;
  background: #1d2730;
  border: 1dp #40505e;
  color: #e7eff5;
  white-space: pre-wrap;
}
.object_locstring_source_field {
  height: 30dp;
  background: #1d2730;
  border-color: #40505e;
}
.object_locstring_gender_toggle {
  display: block;
  width: 100dp;
  height: 30dp;
  padding: 0dp 10dp;
  background: #2e3d48;
  border: 1dp #49616e;
  color: #d8e2e9;
  font-size: 13dp;
  line-height: 19dp;
  text-align: center;
  box-sizing: border-box;
  cursor: pointer;
}
.object_locstring_gender_toggle.active {
  background: #3a342b;
  border-color: #7a6745;
  color: #f0d6a5;
}
