.object_workbench.item_workbench {
  flex-basis: 560dp;
  width: 560dp;
}

#item_object_header {
  display: none;
}
#item_object_header.visible {
  display: flex;
}

.item_workbench_surface {
  display: none;
  flex: 1;
  min-width: 0dp;
  min-height: 0dp;
}
.item_workbench_surface.active {
  display: flex;
  flex-direction: column;
}

.object_workbench_tab.not_applicable {
  display: none;
}

.item_data_header {
  border-top: 1dp #36414c;
}

#item_appearance_dynamic {
  display: flex;
  position: relative;
  flex: 1;
  flex-direction: column;
  min-width: 0dp;
  min-height: 0dp;
}

.item_appearance_editor {
  display: none;
  flex: 1;
  flex-direction: column;
  min-height: 0dp;
  overflow-y: auto;
  background: #13191e;
}
.item_appearance_editor.active {
  display: flex;
}
#item_appearance_status {
  display: none;
}
#item_appearance_status.visible {
  display: block;
}
.item_property_header,
.item_applied_property_columns {
  display: flex;
  flex: 0 0 28dp;
  align-items: center;
  min-height: 28dp;
  padding: 0 10dp;
  border-bottom: 1dp #36414c;
  background: #1c242b;
  color: #aeb8c3;
  font-size: 11dp;
  font-weight: 700;
  text-transform: uppercase;
}

.item_model_row {
  display: none;
  flex: 0 0 34dp;
  align-items: center;
  min-width: 0dp;
  border-bottom: 1dp #2b3540;
}
.item_model_row.visible {
  display: flex;
}
.item_model_label {
  flex: 0 0 126dp;
  padding-left: 10dp;
  overflow: hidden;
  color: #cbd4dd;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item_composite_model_row {
  flex-basis: 58dp;
  min-height: 58dp;
}
.item_composite_model_fields {
  display: flex;
  flex: 1 1 auto;
  align-items: center;
  gap: 8dp;
  min-width: 0dp;
  padding: 4dp 8dp 5dp 0dp;
}
.item_composite_model_field {
  display: flex;
  flex: 1 1 0dp;
  flex-direction: column;
  min-width: 0dp;
}
.item_composite_model_label {
  flex: 0 0 18dp;
  height: 18dp;
  color: #8996a2;
  font-size: 10dp;
  line-height: 17dp;
  text-transform: uppercase;
}
.item_composite_model_field .item_model_field {
  flex: 0 0 30dp;
  width: 100%;
}
.item_model_field {
  flex: 1 1 auto;
  min-width: 80dp;
}
.item_model_actions {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 4dp;
  padding: 0dp 8dp;
}
.appearance_selector_header .item_model_actions {
  padding: 0dp;
}
.item_color_field {
  display: none;
  position: relative;
  overflow: hidden;
}
.item_color_field.visible {
  display: block;
}
.item_color_palette_icon {
  position: absolute;
  display: block;
  left: 4dp;
  top: 5dp;
  width: 18dp;
  height: 16dp;
  border-radius: 8dp;
  background: #dce3ea;
}
.item_color_palette_icon, .item_color_palette_icon * {
  pointer-events: none;
}
.palette_dot, .palette_thumb {
  position: absolute;
  display: block;
  width: 4dp;
  height: 4dp;
  border-radius: 2dp;
}
.palette_dot.red { left: 2dp; top: 5dp; background: #bd5353; }
.palette_dot.yellow { left: 6dp; top: 2dp; background: #b18b2b; }
.palette_dot.green { left: 11dp; top: 3dp; background: #438956; }
.palette_dot.blue { left: 4dp; top: 10dp; background: #477fc0; }
.palette_thumb {
  left: 11dp;
  top: 10dp;
  width: 8dp;
  height: 8dp;
  border-radius: 4dp;
  background: #202a32;
}

.item_selector {
  display: none;
  flex: 1;
  flex-direction: column;
  min-width: 0dp;
  min-height: 0dp;
  background: #13191e;
}
.item_selector.active {
  display: flex;
}
.item_option_rows {
  position: relative;
  flex: 1;
  min-height: 0dp;
  overflow-y: auto;
}
#item_property_option_rows .managed_list_row {
  cursor: pointer;
}
#item_property_option_rows .managed_list_row:hover {
  background: #202a32;
}
.item_model_dropdown {
  display: none;
  z-index: 32;
}
.item_model_dropdown.active {
  display: block;
}
.item_model_dropdown .item_option_rows {
  width: 100%;
  height: 100%;
}
.item_option_rows .managed_list_icon {
  display: none;
}
.item_color_channels {
  display: flex;
  flex: 0 0 48dp;
  align-items: center;
  gap: 4dp;
  padding: 0 8dp;
  border-bottom: 1dp #2b3540;
}
.item_color_channel {
  display: none;
  flex: 1;
  align-items: center;
  min-width: 0dp;
  height: 36dp;
  padding: 4dp;
  border: 1dp #36414c;
  border-radius: 0dp;
  background: #10161b;
  color: #b9c3cc;
}
.item_color_channel_entry {
  display: flex;
  flex: 1;
  min-width: 0dp;
}
.item_color_channel.visible {
  display: flex;
}
.item_color_channel.active {
  border-color: #bca36a;
  background: #26313a;
}
.item_color_channel img {
  flex: 0 0 24dp;
  width: 24dp;
  height: 24dp;
  margin-right: 5dp;
}
.item_color_channel span {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item_color_palette_body {
  display: flex;
  flex: 1;
  align-items: flex-start;
  justify-content: center;
  min-height: 0dp;
  padding: 12dp;
  overflow-y: auto;
}
.item_color_palette {
  position: relative;
  flex: 0 0 384dp;
  width: 384dp;
  height: 264dp;
}
.item_color_palette > img {
  width: 384dp;
  height: 264dp;
}
.item_color_palette_hits {
  display: flex;
  position: absolute;
  left: 0dp;
  top: 0dp;
  width: 384dp;
  height: 264dp;
  flex-wrap: wrap;
}
.item_color_palette_cell {
  flex: 0 0 24dp;
  width: 24dp;
  height: 24dp;
  padding: 0dp;
  border: 0dp;
  border-radius: 0dp;
  background: transparent;
}
.item_color_palette_cell:hover,
.item_color_palette_cell:focus {
  border: 1dp #ffffff;
}
.item_color_selection {
  position: absolute;
  width: 24dp;
  height: 24dp;
  border: 2dp #49ff73;
  pointer-events: none;
}

.item_properties_editor {
  display: none;
  flex: 1;
  min-width: 0dp;
  min-height: 0dp;
  overflow-x: auto;
  background: #13191e;
}
.item_properties_editor.active {
  display: flex;
}
.item_property_catalog {
  position: relative;
  display: flex;
  flex: 0 0 340dp;
  width: 340dp;
  min-width: 300dp;
  min-height: 0dp;
  border-right: 1dp #36414c;
  box-sizing: border-box;
}
.item_property_pane {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0dp;
  min-height: 0dp;
  border-right: 1dp #36414c;
}
.item_property_catalog .item_property_pane.available {
  border-right: 0dp;
}
.item_property_pane.applied {
  flex: 1 0 620dp;
  min-width: 620dp;
  border-right: 0dp;
}
#item_property_option_selector {
  position: absolute;
  left: 0dp;
  top: 0dp;
  width: 100%;
  height: 100%;
  z-index: 4;
  border-right: 1dp #36414c;
  box-sizing: border-box;
}
.item_property_header {
  justify-content: space-between;
}
.item_property_header_summary {
  display: flex;
  align-items: center;
  gap: 12dp;
  min-width: 0dp;
}
.item_property_edit_hint {
  color: #8794a0;
  font-size: 10dp;
  font-weight: 600;
  text-transform: none;
}
.item_applied_property_columns {
  padding: 0dp;
}
.item_applied_property_columns .item_property_column {
  min-width: 0dp;
  padding-left: 8dp;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item_applied_property_columns .item_property_column.primary,
.item_property_pane.applied .managed_list_cell.cell_0 {
  flex: 42 1 0dp;
}
.item_applied_property_columns .item_property_column.subtype,
.item_property_pane.applied .managed_list_cell.cell_1 {
  flex: 24 1 0dp;
}
.item_applied_property_columns .item_property_column.parameter,
.item_property_pane.applied .managed_list_cell.cell_2 {
  flex: 15 1 0dp;
}
.item_applied_property_columns .item_property_column.cost,
.item_property_pane.applied .managed_list_cell.cell_3 {
  flex: 19 1 0dp;
}
.item_property_rows {
  position: relative;
  flex: 1;
  min-height: 0dp;
  overflow-y: auto;
}
.item_property_rows .managed_list_row,
#item_property_option_rows .managed_list_row {
  display: flex;
  align-items: stretch;
  width: 100%;
  height: 34dp;
  min-height: 34dp;
  border-bottom: 1dp #2b3540;
  box-sizing: border-box;
}
.managed_list_icon {
  width: 48dp;
  height: 48dp;
  flex: 0 0 48dp;
}
.item_property_rows .managed_list_cell,
#item_property_option_rows .managed_list_cell {
  display: block;
  min-width: 0dp;
  height: 33dp;
  padding: 0 8dp;
  line-height: 33dp;
  color: #dce3ea;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}
.item_property_pane.available .managed_list_cell.cell_0 {
  flex: 1 1 auto;
}
#item_property_option_rows .managed_list_cell.cell_0 {
  flex: 1 1 auto;
}
.item_property_pane.applied .managed_list_cell {
  border-left: 1dp #2b3540;
}
.item_property_pane.applied .managed_list_cell.cell_0 {
  border-left: 0dp;
}
.item_property_pane.applied .managed_list_cell.cell_1:not(.disabled),
.item_property_pane.applied .managed_list_cell.cell_2:not(.disabled),
.item_property_pane.applied .managed_list_cell.cell_3:not(.disabled) {
  color: #d8c39b;
  background: #19232a;
  cursor: pointer;
}
.item_property_pane.applied .managed_list_cell:not(.disabled):hover {
  color: #ffffff;
  background: #2b3741;
  cursor: pointer;
}
.item_property_rows .managed_list_cell.disabled {
  color: #66727d;
}
.item_property_rows .managed_list_row.selected,
#item_property_option_rows .managed_list_row.selected {
  background: #26313a;
}
.item_property_rows .managed_list_cell.selected,
#item_property_option_rows .managed_list_cell.selected {
  color: #ffffff;
  background: #34434f;
}
.managed_list_spacer {
  display: block;
}
.managed_list_empty {
  padding: 12dp;
  color: #84909b;
}
.item_property_action_bar {
  display: flex;
  flex: 0 0 38dp;
  align-items: center;
  justify-content: flex-end;
  min-height: 38dp;
  padding: 0 7dp;
  border-top: 1dp #36414c;
  background: #171e24;
}
.item_property_action {
  position: relative;
  flex: 0 0 28dp;
  width: 28dp;
  min-width: 28dp;
  max-width: 28dp;
  height: 28dp;
  padding: 0dp;
  border: 1dp #43505c;
  border-radius: 0dp;
  background: #202a32;
}
.item_property_action:hover,
.item_property_action:focus {
  border-color: #bca36a;
  background: #2b3741;
}
.item_property_action:active {
  background: #34434f;
}
.item_property_action:disabled {
  opacity: 0.42;
}
.item_property_action_mark {
  position: absolute;
  display: block;
  background: #dce3ea;
  pointer-events: none;
}
.item_property_action_mark.horizontal {
  left: 7dp;
  top: 13dp;
  width: 12dp;
  height: 2dp;
}
.item_property_action_mark.vertical {
  left: 12dp;
  top: 8dp;
  width: 2dp;
  height: 12dp;
}
.item_property_action.add .item_property_action_mark {
  background: #79c98e;
}
.item_property_action.remove .item_property_action_mark {
  background: #d78a8a;
}

.item_inventory_editor {
  justify-content: flex-start;
}
.item_inventory_editor .creature_inventory_page_surface {
  flex: 0 0 340dp;
}
.item_inventory_editor .creature_inventory_pages {
  display: none;
}

.item_workbench_body {
  display: flex;
  flex: 1;
  min-width: 0dp;
  min-height: 0dp;
}
.item_workbench_fields {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 300dp;
  min-height: 0dp;
}
.item_preview {
  display: flex;
  flex-direction: column;
  flex: 0 0 180dp;
  min-width: 160dp;
  max-width: 180dp;
  min-height: 0dp;
  border-right: 1dp #36414c;
  background: #111820;
}
.item_preview.preview_3d {
  flex: 0 1 32%;
  min-width: 180dp;
  max-width: 380dp;
}
.item_preview_controls {
  display: none;
  align-items: center;
  padding: 8dp;
  border-bottom: 1dp #36414c;
}
.item_preview_controls span { flex: 1; color: #aeb8c3; }
.item_preview_gender {
  padding: 5dp 10dp;
  border: 1dp #43505c;
  background: #202a32;
}
.item_preview_gender.active { border-color: #bca36a; background: #34434f; }
.item_preview_gender:hover { background: #2b3741; }
#item_preview_viewport {
  display: none;
  flex: 1;
  min-height: 100dp;
  margin: 8dp;
  background: #3d4d6b;
  cursor: grab;
}
.item_preview.armor .item_preview_controls { display: flex; }
.item_preview.preview_3d #item_preview_viewport { display: block; }
.item_preview_icon_panel {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12dp;
}
.item_preview.preview_3d .item_preview_icon_panel { flex: 0 0 auto; }
.item_preview_label { color: #aeb8c3; margin-bottom: 10dp; }
#item_preview_icon {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 64dp;
  min-height: 64dp;
  padding: 8dp;
  border: 1dp #36414c;
  background: #080d12;
}
#item_preview_icon img { max-width: 128dp; max-height: 192dp; }
.item_preview.preview_3d #item_preview_icon img { max-height: 96dp; }
#item_preview_status { padding: 8dp; color: #d0b184; }
#item_preview_status.empty { display: none; }
