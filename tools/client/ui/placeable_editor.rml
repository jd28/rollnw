<template name="placeable-workbench">
<head></head>
<body>
  <div id="object_workbench" class="object_workbench placeable_workbench"
       data-smalls-source="placeable_editor.rml">
    <div id="placeable_object_header" class="object_workbench_header area_object_header">
      <button type="button" class="area_object_list_back panel_back_button"
              title="Back to placed objects">
        <span class="panel_back_icon">
          <span class="panel_back_head"></span>
          <span class="panel_back_shaft"></span>
        </span>
      </button>
      <div id="placeable_object_title" class="object_workbench_title"></div>
    </div>

    <div id="object_workbench_tab_bar" class="object_workbench_tab_bar">
      <div id="object_workbench_tabs" class="object_workbench_tabs">
        <div id="object_workbench_tab_track" class="object_workbench_tab_track">
          <button id="placeable_tab_details" class="object_workbench_tab" type="button" data-surface="details">Details</button>
          <button id="placeable_tab_variables" class="object_workbench_tab" type="button" data-surface="variables">Variables</button>
          <button id="placeable_tab_appearance" class="object_workbench_tab" type="button" data-surface="appearance">Appearance</button>
          <button id="placeable_tab_inventory" class="object_workbench_tab" type="button" data-surface="inventory">Inventory</button>
        </div>
      </div>
      <button id="object_workbench_tabs_previous" class="object_workbench_tab_scroll_button disabled" type="button" title="Scroll editor tabs left">&#x2039;</button>
      <button id="object_workbench_tabs_next" class="object_workbench_tab_scroll_button disabled" type="button" title="Scroll editor tabs right">&#x203a;</button>
    </div>

    <div id="placeable_surface_details" class="placeable_workbench_surface">
      <div class="property_tree_header placeable_data_header">
        <span class="property_tree_header_name">Field</span>
        <span class="property_tree_header_value">Value</span>
        <span id="property_tree_count" class="property_tree_count">0</span>
      </div>
      <div id="property_tree_rows" class="property_tree_rows">
        <div class="property_tree_empty">Select a Placeable to inspect.</div>
      </div>
    </div>

    <div id="placeable_surface_variables" class="placeable_workbench_surface">
      <div class="object_variable_toolbar">
        <button id="object_variable_add" type="button" title="Add integer variable">Add Variable</button>
      </div>
      <div class="object_variable_header">
        <span class="object_variable_header_name">Name</span>
        <span class="object_variable_header_type">Type</span>
        <span class="object_variable_header_value">Value</span>
        <span id="object_variable_count" class="property_tree_count">0</span>
      </div>
      <div id="object_variable_rows" class="object_variable_rows">
        <div class="property_tree_empty">Waiting for a live Placeable.</div>
      </div>
    </div>

    <div id="placeable_surface_appearance" class="placeable_workbench_surface">
      <div id="placeable_appearance_dynamic" class="smalls_refresh"
           onrefresh="placeable_appearance_refresh()">
        <div class="property_tree_empty">Waiting for a live Placeable.</div>
      </div>
    </div>

    <div id="placeable_surface_inventory" class="placeable_workbench_surface">
      <div id="placeable_inventory_dynamic"></div>
    </div>
  </div>
</body>
</template>
