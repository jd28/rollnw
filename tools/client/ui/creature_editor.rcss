.object_workbench.creature_workbench {
  flex-basis: 440dp;
  width: 440dp;
}

#creature_object_header {
  display: none;
}
#creature_object_header.visible {
  display: flex;
}

.creature_workbench_surface {
  display: none;
  flex: 1;
  min-width: 0dp;
  min-height: 0dp;
}
.creature_workbench_surface.active {
  display: flex;
  flex-direction: column;
}

.creature_data_header {
  border-top: 1dp #36414c;
}

#creature_sheet_rows .property_tree_name {
  padding-left: 22dp;
}
#creature_sheet_rows .property_tree_cells.section .property_tree_name {
  padding-left: 8dp;
}

.creature_surface_dynamic {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0dp;
  min-height: 0dp;
}

.creature_appearance_main, .creature_appearance_modal {
  display: none;
}
.creature_appearance_main.active, .creature_appearance_modal.active {
  display: flex;
}

#creature_workbench_overlays {
  position: absolute;
  left: 0dp;
  top: 0dp;
  width: 0dp;
  height: 0dp;
}

#creature_workbench_dynamic_overlays {
  position: absolute;
  left: 0dp;
  top: 0dp;
  width: 0dp;
  height: 0dp;
}
