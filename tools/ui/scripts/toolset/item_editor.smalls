from core.commands.v1 import { command_execute };
from core.rmlui import {
    Command,
    command_set_class,
};
from core.ui import { ListSelection, UiListBinding };

fn _succeeded(status: int): bool {
    return status == 0 || status == 4;
}

fn _selection_args(selection: ListSelection): array!(string) {
    return {
        selection.list_id,
        selection.key,
        f"{selection.index}",
        f"{selection.cell}",
    };
}

// Native code owns copied presentation rows and selector state. Profile SmallS
// supplies the policy batch and remains the only writer of live Item state.
fn initialize(): bool {
    return _succeeded(command_execute("toolset.item.initialize", {}).status);
}

fn refresh(): bool {
    return _succeeded(command_execute("toolset.item.refresh", {}).status);
}

fn details_refresh(): array!(Command) {
    var result = command_execute("toolset.item.details", {});
    if (!_succeeded(result.status)) { return {}; }
    return {{
        operation = command_set_class,
        element_id = "item_tab_inventory",
        value = "not_applicable",
        state = result.message != "1",
    }};
}

fn on_model_activate(selection: ListSelection) {
    command_execute("toolset.item.appearance.model.activate",
        _selection_args(selection));
}

fn add_selected_property() {
    command_execute("toolset.item.properties.add", {});
}

fn remove_selected_property() {
    command_execute("toolset.item.properties.remove", {});
}

fn close_property_options() {
    command_execute("toolset.item.properties.close", {});
}

fn on_applied_activate(selection: ListSelection) {
    command_execute("toolset.item.properties.applied.activate",
        _selection_args(selection));
}

fn on_option_activate(selection: ListSelection) {
    command_execute("toolset.item.properties.option.activate",
        _selection_args(selection));
}

fn __toolset_ui_bindings(): array!(UiListBinding) {
    return {
        {
            list_id = "item.properties.applied",
            event = "activate",
            fn_name = "on_applied_activate",
        },
        {
            list_id = "item.properties.options",
            event = "activate",
            fn_name = "on_option_activate",
        },
        {
            list_id = "item.appearance.models",
            event = "activate",
            fn_name = "on_model_activate",
        },
    };
}
