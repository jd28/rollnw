    var state = get_propset!(EncounterState)(obj);
    _append_boolean_details_row(rows, "Basic", "Active",
        "nwn1.propsets.EncounterState", "active", state.active);
    _append_details_row(rows, "Basic", "Difficulty", f"{state.difficulty}");
    _append_details_row(rows, "Basic", "Faction", f"{state.faction}");
    _append_boolean_details_row(rows, "Basic", "Player Only",
        "nwn1.propsets.EncounterState", "player_only", state.player_only);
    _append_details_row(rows, "Spawns", "Creature Types", f"{Array.len(state.creatures)}");
    _append_details_row(rows, "Spawns", "Maximum Creatures", f"{state.creatures_max}");
    _append_details_row(rows, "Spawns", "Recommended Creatures", f"{state.creatures_recommended}");
    _append_details_row(rows, "Spawns", "Respawns", f"{state.respawns}");
    _append_boolean_details_row(rows, "Spawns", "Reset",
        "nwn1.propsets.EncounterState", "reset", state.reset);
    _append_details_row(rows, "Spawns", "Reset Time", f"{state.reset_time}");
    _append_details_row(rows, "Scripts", "On Entered", Types.resref_to_string(state.on_entered));
    _append_details_row(rows, "Scripts", "On Exhausted", Types.resref_to_string(state.on_exhausted));
    _append_details_row(rows, "Scripts", "On Exit", Types.resref_to_string(state.on_exit));
    _append_details_row(rows, "Scripts", "On Heartbeat", Types.resref_to_string(state.on_heartbeat));
    _append_details_row(rows, "Scripts", "On User Defined", Types.resref_to_string(state.on_user_defined));
}

