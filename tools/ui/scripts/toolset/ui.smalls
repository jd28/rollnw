from core.ui import { UiListBinding };
import core.array as Array;
import core.module as ModulePolicy;
import core.object as Object;
import core.types as Types;
import nwn1.creature as CreaturePolicy;
from nwn1.propsets import { DoorState, EncounterState, ItemDescriptor, ItemStats,
    PlaceableState, SoundState, StoreState, TriggerState, WaypointState };

type ObjectDetailsRow {
    group: string;
    label: string;
    value: string;
    editor: int;
    propset: string;
    field: string;
    element: int;
    edit_value: int;
    edit_min: int;
    edit_max: int;
};

const details_editor_read_only = 0;
const details_editor_boolean = 1;
const details_editor_integer = 2;

fn _details_row(group: string, label: string, value: string): ObjectDetailsRow {
    return {
        group = group,
        label = label,
        value = value,
        editor = details_editor_read_only,
        propset = "",
        field = "",
        element = -1,
        edit_value = 0,
        edit_min = 0,
        edit_max = 0,
    };
}

fn _boolean_details_row(group: string, label: string,
    propset: string, field: string, value: int): ObjectDetailsRow {
    return {
        group = group,
        label = label,
        value = _bool_details_value(value),
        editor = details_editor_boolean,
        propset = propset,
        field = field,
        element = -1,
        edit_value = value,
        edit_min = 0,
        edit_max = 1,
    };
}

fn _integer_details_row(group: string, label: string,
    propset: string, field: string, value: int,
    minimum: int, maximum: int, element: int = -1): ObjectDetailsRow {
    return {
        group = group,
        label = label,
        value = f"{value}",
        editor = details_editor_integer,
        propset = propset,
        field = field,
        element = element,
        edit_value = value,
        edit_min = minimum,
        edit_max = maximum,
    };
}

fn _append_details_row(rows: array!(ObjectDetailsRow),
    group: string, label: string, value: string) {
    Array.push(rows, _details_row(group, label, value));
}

fn _append_boolean_details_row(rows: array!(ObjectDetailsRow),
    group: string, label: string,
    propset: string, field: string, value: int) {
    Array.push(rows, _boolean_details_row(
        group, label, propset, field, value));
}

fn _append_integer_details_row(rows: array!(ObjectDetailsRow),
    group: string, label: string,
    propset: string, field: string, value: int,
    minimum: int, maximum: int, element: int = -1) {
    Array.push(rows, _integer_details_row(
        group, label, propset, field, value, minimum, maximum, element));
}

fn _append_identity(rows: array!(ObjectDetailsRow), obj: object) {
    _append_details_row(rows, "Identity", "Name", Object.get_name(obj));
    _append_details_row(rows, "Identity", "Tag", Object.get_tag(obj));
    _append_details_row(rows, "Identity", "Resref",
        Types.resref_to_string(Object.get_resref(obj)));
}

fn _bool_details_value(value: int): string {
    return value != 0 ? "Yes" : "No";
}

fn _vec3_details_value(value: vec3): string {
    return f"{value.x}, {value.y}, {value.z}";
}

fn _append_module_details(rows: array!(ObjectDetailsRow), obj: Module) {
    _append_details_row(rows, "Identity", "Name", ModulePolicy.get_name(obj));
    _append_details_row(rows, "Identity", "Tag", Object.get_tag(obj));
    _append_details_row(rows, "Basic", "Areas", f"{ModulePolicy.get_area_count(obj)}");
    _append_details_row(rows, "Basic", "Save Game", ModulePolicy.is_save_game(obj) ? "Yes" : "No");
    _append_details_row(rows, "Basic", "Creator ID", f"{ModulePolicy.get_creator_id(obj)}");
    _append_details_row(rows, "Basic", "Module Version", f"{ModulePolicy.get_version(obj)}");
    _append_details_row(rows, "Rules", "Expansion Pack", f"{ModulePolicy.get_expansion_pack(obj)}");
    _append_details_row(rows, "Rules", "Minimum Game Version", ModulePolicy.get_minimum_game_version(obj));
    _append_details_row(rows, "Rules", "XP Scale", f"{ModulePolicy.get_xp_scale(obj)}");
    _append_details_row(rows, "Resources", "Custom TLK", ModulePolicy.get_custom_tlk(obj));
    _append_details_row(rows, "Entry", "Area", Types.resref_to_string(ModulePolicy.get_entry_area(obj)));
    _append_details_row(rows, "Entry", "Position", _vec3_details_value(ModulePolicy.get_entry_position(obj)));
    _append_details_row(rows, "Entry", "Orientation", _vec3_details_value(ModulePolicy.get_entry_orientation(obj)));
    _append_details_row(rows, "Entry", "Start Movie", Types.resref_to_string(ModulePolicy.get_start_movie(obj)));
    _append_details_row(rows, "Time", "Dawn Hour", f"{ModulePolicy.get_dawn_hour(obj)}");
    _append_details_row(rows, "Time", "Dusk Hour", f"{ModulePolicy.get_dusk_hour(obj)}");
    _append_details_row(rows, "Time", "Minutes Per Hour", f"{ModulePolicy.get_minutes_per_hour(obj)}");
    _append_details_row(rows, "Time", "Start Year", f"{ModulePolicy.get_start_year(obj)}");
    _append_details_row(rows, "Time", "Start Month", f"{ModulePolicy.get_start_month(obj)}");
    _append_details_row(rows, "Time", "Start Day", f"{ModulePolicy.get_start_day(obj)}");
    _append_details_row(rows, "Time", "Start Hour", f"{ModulePolicy.get_start_hour(obj)}");
    _append_details_row(rows, "Scripts", "On Client Enter", Types.resref_to_string(ModulePolicy.get_on_client_enter(obj)));
    _append_details_row(rows, "Scripts", "On Client Leave", Types.resref_to_string(ModulePolicy.get_on_client_leave(obj)));
    _append_details_row(rows, "Scripts", "On Cutscene Abort", Types.resref_to_string(ModulePolicy.get_on_cutscene_abort(obj)));
    _append_details_row(rows, "Scripts", "On Heartbeat", Types.resref_to_string(ModulePolicy.get_on_heartbeat(obj)));
    _append_details_row(rows, "Scripts", "On Item Acquired", Types.resref_to_string(ModulePolicy.get_on_item_acquired(obj)));
    _append_details_row(rows, "Scripts", "On Item Activated", Types.resref_to_string(ModulePolicy.get_on_item_activated(obj)));
    _append_details_row(rows, "Scripts", "On Item Unacquired", Types.resref_to_string(ModulePolicy.get_on_item_unacquired(obj)));
    _append_details_row(rows, "Scripts", "On Load", Types.resref_to_string(ModulePolicy.get_on_load(obj)));
    _append_details_row(rows, "Scripts", "On Player Chat", Types.resref_to_string(ModulePolicy.get_on_player_chat(obj)));
    _append_details_row(rows, "Scripts", "On Player Death", Types.resref_to_string(ModulePolicy.get_on_player_death(obj)));
    _append_details_row(rows, "Scripts", "On Player Dying", Types.resref_to_string(ModulePolicy.get_on_player_dying(obj)));
    _append_details_row(rows, "Scripts", "On Player Equip", Types.resref_to_string(ModulePolicy.get_on_player_equip(obj)));
    _append_details_row(rows, "Scripts", "On Player Level Up", Types.resref_to_string(ModulePolicy.get_on_player_level_up(obj)));
    _append_details_row(rows, "Scripts", "On Player Rest", Types.resref_to_string(ModulePolicy.get_on_player_rest(obj)));
    _append_details_row(rows, "Scripts", "On Player Unequip", Types.resref_to_string(ModulePolicy.get_on_player_unequip(obj)));
    _append_details_row(rows, "Scripts", "On Spawn Button Down", Types.resref_to_string(ModulePolicy.get_on_spawn_button_down(obj)));
    _append_details_row(rows, "Scripts", "On Start", Types.resref_to_string(ModulePolicy.get_on_start(obj)));
    _append_details_row(rows, "Scripts", "On User Defined", Types.resref_to_string(ModulePolicy.get_on_user_defined(obj)));
    _append_details_row(rows, "Description", "Description", ModulePolicy.get_description(obj));
    _append_details_row(rows, "Comments", "Comments", Object.get_comment(obj));
}

fn _append_door_details(rows: array!(ObjectDetailsRow), obj: Door) {
    var state = get_propset!(DoorState)(obj);
    _append_details_row(rows, "Basic", "Appearance", f"{state.appearance}");
    _append_details_row(rows, "Basic", "Faction", f"{state.faction}");
    _append_boolean_details_row(rows, "Basic", "Plot",
        "nwn1.propsets.DoorState", "plot", state.plot);
    _append_details_row(rows, "Basic", "Current Hit Points", f"{state.hp_current}");
    _append_details_row(rows, "Basic", "Maximum Hit Points", f"{state.hp}");
    _append_integer_details_row(rows, "Save Bonus", "Fortitude",
        "nwn1.propsets.DoorState", "save_fort", state.save_fort, 0, 250);
    _append_integer_details_row(rows, "Save Bonus", "Reflex",
        "nwn1.propsets.DoorState", "save_reflex", state.save_reflex, 0, 250);
    _append_integer_details_row(rows, "Save Bonus", "Will",
        "nwn1.propsets.DoorState", "save_will", state.save_will, 0, 250);
    _append_boolean_details_row(rows, "Lock", "Lockable",
        "nwn1.propsets.DoorState", "lockable", state.lockable);
    _append_boolean_details_row(rows, "Lock", "Locked",
        "nwn1.propsets.DoorState", "locked", state.locked);
    _append_details_row(rows, "Lock", "Key Name", state.key_name);
    _append_boolean_details_row(rows, "Lock", "Key Required",
        "nwn1.propsets.DoorState", "key_required", state.key_required);
    _append_integer_details_row(rows, "Lock", "Lock DC",
        "nwn1.propsets.DoorState", "lock_dc", state.lock_dc, 0, 250);
    _append_integer_details_row(rows, "Lock", "Unlock DC",
        "nwn1.propsets.DoorState", "unlock_dc", state.unlock_dc, 0, 250);
    _append_boolean_details_row(rows, "Trap", "Trapped",
        "nwn1.propsets.DoorState", "is_trapped", state.is_trapped);
    _append_details_row(rows, "Trap", "Trap Type", f"{state.trap_type}");
    _append_integer_details_row(rows, "Trap", "Detect DC",
        "nwn1.propsets.DoorState", "trap_detect_dc", state.trap_detect_dc, 0, 250);
    _append_integer_details_row(rows, "Trap", "Disarm DC",
        "nwn1.propsets.DoorState", "trap_disarm_dc", state.trap_disarm_dc, 0, 250);
    _append_details_row(rows, "Scripts", "On Click", Types.resref_to_string(state.on_click));
    _append_details_row(rows, "Scripts", "On Closed", Types.resref_to_string(state.on_closed));
    _append_details_row(rows, "Scripts", "On Damaged", Types.resref_to_string(state.on_damaged));
    _append_details_row(rows, "Scripts", "On Death", Types.resref_to_string(state.on_death));
    _append_details_row(rows, "Scripts", "On Disarm", Types.resref_to_string(state.on_disarm));
    _append_details_row(rows, "Scripts", "On Heartbeat", Types.resref_to_string(state.on_heartbeat));
    _append_details_row(rows, "Scripts", "On Lock", Types.resref_to_string(state.on_lock));
    _append_details_row(rows, "Scripts", "On Melee Attacked", Types.resref_to_string(state.on_melee_attacked));
    _append_details_row(rows, "Scripts", "On Open", Types.resref_to_string(state.on_open));
    _append_details_row(rows, "Scripts", "On Open Failure", Types.resref_to_string(state.on_open_failure));
    _append_details_row(rows, "Scripts", "On Spell Cast At", Types.resref_to_string(state.on_spell_cast_at));
    _append_details_row(rows, "Scripts", "On Trap Triggered", Types.resref_to_string(state.on_trap_triggered));
    _append_details_row(rows, "Scripts", "On Unlock", Types.resref_to_string(state.on_unlock));
    _append_details_row(rows, "Scripts", "On User Defined", Types.resref_to_string(state.on_user_defined));
    _append_details_row(rows, "Description", "Description", Types.resolve_text(state.description, 0));
}

fn _append_item_details(rows: array!(ObjectDetailsRow), obj: Item) {
    var descriptor = get_propset!(ItemDescriptor)(obj);
    var stats = get_propset!(ItemStats)(obj);
    _append_identity(rows, obj);
    _append_details_row(rows, "Basic", "Base Item Type", f"{stats.base_item}");
    _append_details_row(rows, "Basic", "Additional Cost", f"{stats.cost_additional}");
    _append_boolean_details_row(rows, "Basic", "Plot",
        "nwn1.propsets.ItemStats", "plot", stats.plot);
    _append_details_row(rows, "Basic", "Stack Size", f"{stats.stack_size}");
    _append_details_row(rows, "Description", "Description",
        Types.resolve_text(descriptor.description, 0));
    _append_details_row(rows, "Comments", "Comments", Object.get_comment(obj));
}

