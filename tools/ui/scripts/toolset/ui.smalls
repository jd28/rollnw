    _append_details_row(rows, "Scripts", "On User Defined", Types.resref_to_string(state.on_user_defined));
    _append_details_row(rows, "Description", "Description", Types.resolve_text(state.description, 0));
}

fn _append_sound_details(rows: array!(ObjectDetailsRow), obj: Sound) {
    var state = get_propset!(SoundState)(obj);
    _append_boolean_details_row(rows, "Basic", "Active",
        "nwn1.propsets.SoundState", "active", state.active);
    _append_details_row(rows, "Basic", "Sounds", f"{Array.len(state.sounds)}");
    _append_integer_details_row(rows, "Playback", "Volume",
        "nwn1.propsets.SoundState", "volume", state.volume, 0, 127);
    _append_details_row(rows, "Playback", "Priority", f"{state.priority}");
    _append_boolean_details_row(rows, "Playback", "Continuous",
        "nwn1.propsets.SoundState", "continuous", state.continuous);
    _append_boolean_details_row(rows, "Playback", "Looping",
        "nwn1.propsets.SoundState", "looping", state.looping);
    _append_boolean_details_row(rows, "Playback", "Positional",
        "nwn1.propsets.SoundState", "positional", state.positional);
    _append_boolean_details_row(rows, "Playback", "Random",
        "nwn1.propsets.SoundState", "random", state.random);
    _append_details_row(rows, "Range", "Minimum Distance", f"{state.distance_min}");
    _append_details_row(rows, "Range", "Maximum Distance", f"{state.distance_max}");
    _append_details_row(rows, "Timing", "Interval", f"{state.interval}");
    _append_details_row(rows, "Timing", "Interval Variation", f"{state.interval_variation}");
}

