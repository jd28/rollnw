fn _append_waypoint_details(rows: array!(ObjectDetailsRow), obj: Waypoint) {
    var state = get_propset!(WaypointState)(obj);
    _append_details_row(rows, "Basic", "Appearance", f"{state.appearance}");
    _append_details_row(rows, "Map Note", "Enabled", _bool_details_value(state.map_note_enabled));
    _append_details_row(rows, "Map Note", "Has Map Note", _bool_details_value(state.has_map_note));
    _append_details_row(rows, "Map Note", "Text", Types.resolve_text(state.map_note, 0));
    _append_details_row(rows, "Transition", "Linked To", state.linked_to);
    _append_details_row(rows, "Description", "Description", Types.resolve_text(state.description, 0));
}

fn get_object_details_rows(obj: object): array!(ObjectDetailsRow) {
    var rows: array!(ObjectDetailsRow) = {};
    if (!Object.is_valid(obj)) {
        return rows;
    }

    if (obj is Creature) {
        for (var source in CreaturePolicy.get_property_editor_rows(obj)) {
            if (source.surface == CreaturePolicy.property_editor_surface_properties) {
                _append_details_row(rows, source.group, source.label, source.value);
            }
        }
        _append_details_row(rows, "Comments", "Comments", Object.get_comment(obj));
        return rows;
    }
    if (obj is Item) {
        _append_item_details(rows, obj);
        return rows;
    }
    if (obj is Module) {
        _append_module_details(rows, obj);
        return rows;
    }

    _append_identity(rows, obj);
    if (obj is Door) { _append_door_details(rows, obj); }
    elif (obj is Encounter) { _append_encounter_details(rows, obj); }
    elif (obj is Placeable) { _append_placeable_details(rows, obj); }
    elif (obj is Sound) { _append_sound_details(rows, obj); }
    elif (obj is Store) { _append_store_details(rows, obj); }
    elif (obj is Trigger) { _append_trigger_details(rows, obj); }
    elif (obj is Waypoint) { _append_waypoint_details(rows, obj); }
    _append_details_row(rows, "Comments", "Comments", Object.get_comment(obj));
    return rows;
}

fn __toolset_ui_bindings(): array!(UiListBinding) {
    return {};
}

fn on_apply(input: string): string {
    return "Smalls apply: " + input;
}

fn on_enter(input: string): string {
    return "Smalls enter: " + input;
}

fn on_ui_event(event_key: string, input: string): string {
    return "Smalls event [" + event_key + "]: " + input;
}
