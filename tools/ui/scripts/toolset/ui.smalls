    _append_details_row(rows, "Trap", "Detect DC", f"{state.trap_detect_dc}");
    _append_details_row(rows, "Trap", "Disarm DC", f"{state.trap_disarm_dc}");
    _append_details_row(rows, "Scripts", "On Click", Types.resref_to_string(state.on_click));
