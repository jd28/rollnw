    _append_details_row(rows, "Scripts", "On Lock", Types.resref_to_string(state.on_lock));
    _append_details_row(rows, "Scripts", "On Melee Attacked", Types.resref_to_string(state.on_melee_attacked));
    _append_details_row(rows, "Scripts", "On Open", Types.resref_to_string(state.on_open));
    _append_details_row(rows, "Scripts", "On Spell Cast At", Types.resref_to_string(state.on_spell_cast_at));
