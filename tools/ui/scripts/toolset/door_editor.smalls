import core.array as Array;
import core.object as O;
import core.string as String;
import core.types as T;
import nwn1.constants as Const;
import nwn1.doors as DoorPolicy;
from nwn1.propsets import { DoorState };

from core.commands.v1 import { command_execute };
from core.rmlui import {
    Command,
    Event,
    active_object,
    active_object_type,
    command_focus,
    command_set_rml,
};
from core.ui import { ListConfig, ListItem, ListSelection };
from core.ui.v1 import {
    list_create,
    list_on_activate,
    list_set_items,
    list_set_selected,
    list_set_title,
    list_set_visible,
};

const genericdoor_list = "door.appearance.genericdoors";
const appearance_main = 0;
const appearance_selector = 1;

var _initialized = false;
var _appearance_door = O.invalid as Door;
var _appearance_mode = appearance_main;
var _genericdoor_options: array!(DoorPolicy.DoorAppearanceOption) = {};
var _appearance_query = "";

fn _active_door(): Door {
    if (active_object_type() != (Const.object_type_door as int)) {
        return O.invalid as Door;
    }
    return active_object() as Door;
}

fn _escape_rml(value: string): string {
    var result = String.replace(value, "&", "&amp;");
    result = String.replace(result, "<", "&lt;");
    result = String.replace(result, ">", "&gt;");
    return result;
}

fn _escape_rml_attribute(value: string): string {
    return String.replace(_escape_rml(value), "'", "&#39;");
}

fn _option_key(id: int): string {
    return f"{id}";
}

fn _sort_options(options: array!(DoorPolicy.DoorAppearanceOption)) {
    Array.sort(options, fn(
        a: DoorPolicy.DoorAppearanceOption,
        b: DoorPolicy.DoorAppearanceOption): bool {
        var a_label = String.to_lower(a.label);
        var b_label = String.to_lower(b.label);
        if (a_label == b_label) { return a.id < b.id; }
        return a_label < b_label;
    });
}

fn _sorted_genericdoor_options(): array!(DoorPolicy.DoorAppearanceOption) {
    var options = DoorPolicy.get_genericdoor_options();
    _sort_options(options);
    return options;
}

fn _filter_options(
    options: array!(DoorPolicy.DoorAppearanceOption)):
    array!(DoorPolicy.DoorAppearanceOption) {
    var query = String.to_lower(String.trim(_appearance_query));
    if (query == "") { return options; }

    var filtered: array!(DoorPolicy.DoorAppearanceOption) = {};
    Array.reserve(filtered, Array.len(options));
    for (var option in options) {
        if (String.contains(String.to_lower(option.label), query)) {
            Array.push(filtered, option);
        }
    }
    return filtered;
}

fn _ensure_initialized(): bool {
    if (_initialized) { return true; }
    var config: ListConfig = { row_height = 34, overscan = 6, columns = 1 };
    if (!list_create(genericdoor_list, config)
        || !list_set_title(genericdoor_list, "Door Appearances")
        || !list_set_visible(genericdoor_list, false)
        || !list_on_activate(
            genericdoor_list, "toolset.door_editor.on_genericdoor_activate")) {
        return false;
    }
    _initialized = true;
    return true;
}

fn _reset_selector(): bool {
    _appearance_mode = appearance_main;
    _genericdoor_options = {};
    _appearance_query = "";
    return !_initialized || (list_set_items(genericdoor_list, {})
        && list_set_visible(genericdoor_list, false));
}

fn _refresh_genericdoors(door: Door): bool {
    if ((door as object) == O.invalid || !_ensure_initialized()) {
        return false;
    }
    _genericdoor_options = _filter_options(_sorted_genericdoor_options());
    var items: array!(ListItem) = {};
    Array.reserve(items, Array.len(_genericdoor_options));
    var state = get_propset!(DoorState)(door);
    var selected_index = -1;
    var selected_key = "";
    for (var index = 0; index < Array.len(_genericdoor_options); index += 1) {
        var option = _genericdoor_options[index];
        var key = _option_key(option.id);
        var row: ListItem = {
            key = key,
            icon_source = "",
            cell0 = option.label,
            cell1 = "",
            cell2 = "",
            cell3 = "",
            cell_count = 1,
            enabled_mask = 1,
        };
        Array.push(items, row);
        if (state.appearance == 0 && state.generic_type == option.id) {
            selected_index = index;
            selected_key = key;
        }
    }
    if (!list_set_items(genericdoor_list, items)
        || !list_set_visible(genericdoor_list, true)) {
        return false;
    }
    return selected_index < 0 || list_set_selected(genericdoor_list, {
        list_id = genericdoor_list,
        key = selected_key,
        index = selected_index,
        cell = -1,
    });
}

fn _refresh_selector(door: Door): bool {
    if (_appearance_mode == appearance_selector) {
        return _refresh_genericdoors(door);
    }
    return false;
}

fn _main_markup(door: Door): string {
    if ((door as object) == O.invalid) {
        return "<div class='property_tree_empty'>Waiting for a live Door.</div>";
    }
    var state = get_propset!(DoorState)(door);
    var resolved = DoorPolicy.resolve_door_model_by_state(
        state.appearance, state.generic_type);
    var model = T.resref_to_string(resolved.model);
    if (model == "") {
        return f"<div class='door_appearance_editor active'><div class='property_tree_empty error'>{_escape_rml(resolved.error)}</div></div>";
    }
    var source = resolved.generic ? "Generic Door" : "Tileset Door";
    var availability = resolved.valid
        ? ""
        : f"<div class='property_tree_empty error'>{_escape_rml(resolved.error)}</div>";
    return f"<div class='door_appearance_editor active'><div class='door_appearance_summary'><div class='door_appearance_row'><span class='door_appearance_label'>Source</span><span class='door_appearance_value'>{source}</span></div><div class='door_appearance_row'><span class='door_appearance_label'>Name</span><span class='door_appearance_value'>{_escape_rml(resolved.label)}</span></div><div class='door_appearance_row'><span class='door_appearance_label'>Model</span><span class='door_appearance_value'>{_escape_rml(model)}</span></div></div>{availability}<div class='door_appearance_actions'><button id='door_appearance_previous' class='door_appearance_cycle_button' type='button' title='Previous appearance' onclick='previous_door_appearance()'>&#x2039;</button><button id='door_appearance_open' class='door_appearance_open' type='button' onclick='open_door_appearance_selector()'>Choose Appearance</button><button id='door_appearance_next' class='door_appearance_cycle_button' type='button' title='Next appearance' onclick='next_door_appearance()'>&#x203a;</button></div></div>";
}

fn _selector_markup(): string {
    var query = _escape_rml_attribute(_appearance_query);
    return f"<div id='door_appearance_selector' class='door_appearance_selector smalls_selector active'><div class='door_appearance_selector_header'><button id='door_appearance_selector_close' class='panel_back_button smalls_selector_close' type='button' title='Back' onclick='close_door_appearance_selector()'><span class='panel_back_icon'><span class='panel_back_head'></span><span class='panel_back_shaft'></span></span></button><div class='door_appearance_selector_title managed_list_title' data-list-id='{genericdoor_list}'></div></div><div class='door_appearance_search_row'><input id='door_appearance_search' class='door_appearance_search' type='text' value='{query}' placeholder='Search appearances...' onchange='filter_door_appearances(event)' /></div><div class='door_appearance_columns'><span>Name</span></div><div id='door_appearance_rows' class='door_appearance_rows managed_list_rows managed_list_cycle' tabindex='0' data-list-id='{genericdoor_list}' data-empty-text='No appearances match this search.'></div></div>";
}

fn _commands(focus_id: string): array!(Command) {
    var commands: array!(Command) = {{
        operation = command_set_rml,
        element_id = "door_appearance_dynamic",
        value = _appearance_mode == appearance_main
            ? _main_markup(_active_door()) : _selector_markup(),
        state = false,
    }};
    if (focus_id != "") {
        var focus: Command = {
            operation = command_focus,
            element_id = focus_id,
            value = "",
            state = true,
        };
        Array.push(commands, focus);
    }
    return commands;
}

fn door_appearance_refresh(): array!(Command) {
    var door = _active_door();
    if ((door as object) != (_appearance_door as object)) {
        _appearance_door = door;
        _reset_selector();
    }
    if (_appearance_mode != appearance_main && !_refresh_selector(door)) {
        _reset_selector();
    }
    return _commands("");
}

fn open_door_appearance_selector(): array!(Command) {
    var door = _active_door();
    if ((door as object) == O.invalid) { return {}; }
    _appearance_query = "";
    _appearance_mode = appearance_selector;
    if (!_refresh_selector(door)) {
        _reset_selector();
        return {};
    }
    return _commands("door_appearance_rows");
}

fn filter_door_appearances(event: Event): array!(Command) {
    if (_appearance_mode == appearance_main) { return {}; }
    _appearance_query = event.value;
    if (!_refresh_selector(_active_door())) {
        _reset_selector();
    }
    return {};
}

fn close_door_appearance_selector(): array!(Command) {
    _reset_selector();
    return _commands("");
}

fn _command_succeeded(status: int): bool {
    return status == 0 || status == 4;
}

fn _cycled_option_index(
    options: array!(DoorPolicy.DoorAppearanceOption),
    current_id: int,
    delta: int): int {
    var count = Array.len(options);
    if (count == 0 || delta == 0) { return -1; }
    var current = -1;
    for (var index = 0; index < count; index += 1) {
        if (options[index].id == current_id) {
            current = index;
            break;
        }
    }
    if (current < 0) { return delta < 0 ? count - 1 : 0; }
    var next = current + (delta < 0 ? -1 : 1);
    if (next < 0) { return count - 1; }
    if (next >= count) { return 0; }
    return next;
}

fn _cycle_door_appearance(delta: int): array!(Command) {
    var door = _active_door();
    if ((door as object) == O.invalid || delta == 0) { return {}; }
    var state = get_propset!(DoorState)(door);
    var options = _sorted_genericdoor_options();
    var current_id = state.appearance == 0 ? state.generic_type : -1;
    var index = _cycled_option_index(options, current_id, delta);
    if (index < 0) { return {}; }
    var result = command_execute("object.door.set_appearance",
        { "0", f"{options[index].id}" });
    if (_command_succeeded(result.status)) { return _commands(""); }
    return {};
}

fn previous_door_appearance(): array!(Command) {
    return _cycle_door_appearance(-1);
}

fn next_door_appearance(): array!(Command) {
    return _cycle_door_appearance(1);
}

fn on_genericdoor_activate(selection: ListSelection) {
    var door = _active_door();
    if ((door as object) == O.invalid || _appearance_mode != appearance_selector) {
        return;
    }
    if (selection.index < 0 || selection.index >= Array.len(_genericdoor_options)) { return; }
    var option = _genericdoor_options[selection.index];
    if (selection.key != _option_key(option.id)) { return; }

    var result = command_execute("object.door.set_appearance",
        { "0", f"{option.id}" });
    if (_command_succeeded(result.status)) {
        _refresh_genericdoors(door);
    }
}
