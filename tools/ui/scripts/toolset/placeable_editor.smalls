import core.array as Array;
import core.object as O;
import core.placeable as NativePlaceable;
import core.string as String;
import core.types as T;
import nwn1.constants as Const;
import nwn1.placeables as PlaceablePolicy;
from nwn1.propsets import { PlaceableState };

from core.commands.v1 import { command_execute };
from core.rmlui import {
    Command,
    Event,
    active_object,
    active_object_type,
    command_focus,
    command_set_rml,
};
from core.ui import { ListConfig, ListItem, ListSelection };
from core.ui.v1 import {
    list_create,
    list_on_activate,
    list_set_items,
    list_set_selected,
    list_set_title,
    list_set_visible,
};

const appearance_list = "placeable.appearance";
const appearance_main = 0;
const appearance_selector = 1;

var _initialized = false;
var _appearance_placeable = O.invalid as Placeable;
var _appearance_mode = appearance_main;
var _appearance_catalog_loaded = false;
var _all_appearance_options: array!(NativePlaceable.PlaceableAppearanceOption) = {};
var _appearance_options: array!(NativePlaceable.PlaceableAppearanceOption) = {};
var _appearance_query = "";

fn _active_placeable(): Placeable {
    if (active_object_type() != (Const.object_type_placeable as int)) {
        return O.invalid as Placeable;
    }
    return active_object() as Placeable;
}

fn _escape_rml(value: string): string {
    var result = String.replace(value, "&", "&amp;");
    result = String.replace(result, "<", "&lt;");
    result = String.replace(result, ">", "&gt;");
    return result;
}

fn _escape_rml_attribute(value: string): string {
    return String.replace(_escape_rml(value), "'", "&#39;");
}

fn _option_key(id: int): string {
    return f"{id}";
}

fn _ensure_appearance_catalog() {
    if (_appearance_catalog_loaded) { return; }
    _all_appearance_options = PlaceablePolicy.get_appearance_options();
    _appearance_catalog_loaded = true;
}

fn _filter_options(
    options: array!(NativePlaceable.PlaceableAppearanceOption)):
    array!(NativePlaceable.PlaceableAppearanceOption) {
    var query = String.to_lower(String.trim(_appearance_query));
    if (query == "") { return options; }

    var filtered: array!(NativePlaceable.PlaceableAppearanceOption) = {};
    Array.reserve(filtered, Array.len(options));
    for (var option in options) {
        if (String.contains(option.sort_key, query)
            || String.contains(String.to_lower(option.model), query)) {
            Array.push(filtered, option);
        }
    }
    return filtered;
}

fn _ensure_initialized(): bool {
    if (_initialized) { return true; }
    var config: ListConfig = { row_height = 34, overscan = 6, columns = 1 };
    if (!list_create(appearance_list, config)
        || !list_set_title(appearance_list, "Placeable Appearances")
        || !list_set_visible(appearance_list, false)
        || !list_on_activate(
            appearance_list, "toolset.placeable_editor.on_appearance_activate")) {
        return false;
    }
    _initialized = true;
    return true;
}

fn _reset_selector(): bool {
    _appearance_mode = appearance_main;
    _appearance_options = {};
    _appearance_query = "";
    return !_initialized || (list_set_items(appearance_list, {})
        && list_set_visible(appearance_list, false));
}

fn _refresh_options(placeable: Placeable): bool {
    if ((placeable as object) == O.invalid || !_ensure_initialized()) {
        return false;
    }
    _ensure_appearance_catalog();
    _appearance_options = _filter_options(_all_appearance_options);
    var items: array!(ListItem) = {};
    Array.reserve(items, Array.len(_appearance_options));
    var state = get_propset!(PlaceableState)(placeable);
    var selected_index = -1;
    var selected_key = "";
    for (var index = 0; index < Array.len(_appearance_options); index += 1) {
        var option = _appearance_options[index];
        var key = _option_key(option.id);
        Array.push(items, ListItem {
            key = key,
            icon_source = "",
            cell0 = option.label,
            cell1 = option.model,
            cell2 = "",
            cell3 = "",
            cell_count = 2,
            enabled_mask = 3,
        });
        if (state.appearance == option.id) {
            selected_index = index;
            selected_key = key;
        }
    }
    if (!list_set_items(appearance_list, items)
        || !list_set_visible(appearance_list, true)) {
        return false;
    }
    return selected_index < 0 || list_set_selected(appearance_list, {
        list_id = appearance_list,
        key = selected_key,
        index = selected_index,
        cell = -1,
    });
}

fn _main_markup(placeable: Placeable): string {
    if ((placeable as object) == O.invalid) {
        return "<div class='property_tree_empty'>Waiting for a live Placeable.</div>";
    }
    var state = get_propset!(PlaceableState)(placeable);
    var option = PlaceablePolicy.get_appearance_option(state.appearance);
    var availability = option.id >= 0
        ? ""
        : f"<div class='property_tree_empty error'>Appearance {state.appearance} is unavailable.</div>";
    return f"<div class='placeable_appearance_editor active'><div class='placeable_appearance_summary'><div class='placeable_appearance_row'><span class='placeable_appearance_label'>Name</span><span class='placeable_appearance_value'>{_escape_rml(option.label)}</span></div><div class='placeable_appearance_row'><span class='placeable_appearance_label'>Model</span><span class='placeable_appearance_value'>{_escape_rml(option.model)}</span></div></div>{availability}<div class='placeable_appearance_actions'><button id='placeable_appearance_previous' class='placeable_appearance_cycle_button' type='button' title='Previous appearance' onclick='previous_placeable_appearance()'>&#x2039;</button><button id='placeable_appearance_open' class='placeable_appearance_open' type='button' onclick='open_placeable_appearance_selector()'>Choose Appearance</button><button id='placeable_appearance_next' class='placeable_appearance_cycle_button' type='button' title='Next appearance' onclick='next_placeable_appearance()'>&#x203a;</button></div></div>";
}

fn _selector_markup(): string {
    var query = _escape_rml_attribute(_appearance_query);
    return f"<div id='placeable_appearance_selector' class='placeable_appearance_selector smalls_selector active'><div class='placeable_appearance_selector_header'><button id='placeable_appearance_selector_close' class='panel_back_button smalls_selector_close' type='button' title='Back' onclick='close_placeable_appearance_selector()'><span class='panel_back_icon'><span class='panel_back_head'></span><span class='panel_back_shaft'></span></span></button><div class='placeable_appearance_selector_title managed_list_title' data-list-id='{appearance_list}'></div></div><div class='placeable_appearance_search_row'><input id='placeable_appearance_search' class='placeable_appearance_search' type='text' value='{query}' placeholder='Search appearances...' onchange='filter_placeable_appearances(event)' /></div><div class='placeable_appearance_columns'><span>Name</span><span>Model</span></div><div id='placeable_appearance_rows' class='placeable_appearance_rows managed_list_rows managed_list_cycle' tabindex='0' data-list-id='{appearance_list}' data-empty-text='No appearances match this search.'></div></div>";
}

fn _commands(focus_id: string): array!(Command) {
    var commands: array!(Command) = {{
        operation = command_set_rml,
        element_id = "placeable_appearance_dynamic",
        value = _appearance_mode == appearance_main
            ? _main_markup(_active_placeable()) : _selector_markup(),
        state = false,
    }};
    if (focus_id != "") {
        Array.push(commands, Command {
            operation = command_focus,
            element_id = focus_id,
            value = "",
            state = true,
        });
    }
    return commands;
}

fn placeable_appearance_refresh(): array!(Command) {
    var placeable = _active_placeable();
    if ((placeable as object) != (_appearance_placeable as object)) {
        _appearance_placeable = placeable;
        _reset_selector();
    }
    if (_appearance_mode == appearance_selector) {
        if (_refresh_options(placeable)) { return {}; }
        _reset_selector();
    }
    return _commands("");
}

fn open_placeable_appearance_selector(): array!(Command) {
    var placeable = _active_placeable();
    if ((placeable as object) == O.invalid) { return {}; }
    _appearance_query = "";
    _appearance_mode = appearance_selector;
    if (!_refresh_options(placeable)) {
        _reset_selector();
        return {};
    }
    return _commands("placeable_appearance_rows");
}

fn filter_placeable_appearances(event: Event): array!(Command) {
    if (_appearance_mode != appearance_selector) { return {}; }
    _appearance_query = event.value;
    if (!_refresh_options(_active_placeable())) { _reset_selector(); }
    return {};
}

fn close_placeable_appearance_selector(): array!(Command) {
    _reset_selector();
    return _commands("");
}

fn _command_succeeded(status: int): bool {
    return status == 0 || status == 4;
}

fn _cycled_option_index(
    options: array!(NativePlaceable.PlaceableAppearanceOption),
    current_id: int,
    delta: int): int {
    var count = Array.len(options);
    if (count == 0 || delta == 0) { return -1; }
    var current = -1;
    for (var index = 0; index < count; index += 1) {
        if (options[index].id == current_id) {
            current = index;
            break;
        }
    }
    if (current < 0) { return delta < 0 ? count - 1 : 0; }
    var next = current + (delta < 0 ? -1 : 1);
    if (next < 0) { return count - 1; }
    if (next >= count) { return 0; }
    return next;
}

fn _cycle_placeable_appearance(delta: int): array!(Command) {
    var placeable = _active_placeable();
    if ((placeable as object) == O.invalid || delta == 0) { return {}; }
    var state = get_propset!(PlaceableState)(placeable);
    _ensure_appearance_catalog();
    var index = _cycled_option_index(_all_appearance_options, state.appearance, delta);
    if (index < 0) { return {}; }
    var result = command_execute(
        "object.set_appearance", { f"{_all_appearance_options[index].id}" });
    if (_command_succeeded(result.status)) { return _commands(""); }
    return {};
}

fn previous_placeable_appearance(): array!(Command) {
    return _cycle_placeable_appearance(-1);
}

fn next_placeable_appearance(): array!(Command) {
    return _cycle_placeable_appearance(1);
}

fn on_appearance_activate(selection: ListSelection) {
    var placeable = _active_placeable();
    if ((placeable as object) == O.invalid || _appearance_mode != appearance_selector) {
        return;
    }
    if (selection.index < 0 || selection.index >= Array.len(_appearance_options)) {
        return;
    }
    var option = _appearance_options[selection.index];
    if (selection.key != _option_key(option.id)) { return; }
    command_execute("object.set_appearance", { f"{option.id}" });
}
