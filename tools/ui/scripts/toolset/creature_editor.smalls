from core.commands.v1 import { command_execute };
from core.rmlui import { Command };
from core.ui import { ListSelection };

fn _succeeded(status: int): bool {
    return status == 0 || status == 4;
}

fn _activate(command: string, selection: ListSelection) {
    command_execute(command, {
        selection.list_id,
        selection.key,
        f"{selection.index}",
    });
}

// Thin RML event adapters. Native code owns the catalog join, copied list
// rows, selection, and popup lifetime; SmallS owns no editor state here.
fn refresh(): bool {
    return _succeeded(command_execute(
        "toolset.creature.body_parts.refresh", {}).status);
}

fn body_parts_refresh(): array!(Command) {
    refresh();
    return {};
}

fn close_body_part_options(): array!(Command) {
    command_execute("toolset.creature.body_parts.close", {});
    return {};
}

fn on_body_part_activate(selection: ListSelection) {
    _activate("toolset.creature.body_parts.activate", selection);
}

fn on_body_part_option_activate(selection: ListSelection) {
    _activate("toolset.creature.body_parts.option.activate", selection);
}
