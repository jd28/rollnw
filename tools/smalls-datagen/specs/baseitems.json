{
  "source_2da": "baseitems",
  "smalls_type": "BaseItemDefinition",
  "output_subdir": "nwn1/data/baseitems",
  "valid_column": "label",
  "filename_source": "@label:label",
  "valid_strref_column": "Name",
  "fields": [
    {"name": "id", "type": "int", "source": "@row_index"}
  ],
  "field_groups": [
    {
      "name": "info",
      "type": "BaseItemInfo",
      "fields": [
        {"name": "label",                "type": "string",   "source": "label"},
        {"name": "name",                 "type": "int",      "source": "Name",           "default": "-1"},
        {"name": "model_type",           "type": "int",      "source": "ModelType",      "default": "0"},
        {"name": "item_class",           "type": "ResRef",   "source": "ItemClass"},
        {"name": "default_model",        "type": "ResRef",   "source": "DefaultModel"},
        {"name": "default_icon",         "type": "ResRef",   "source": "DefaultIcon"},
        {"name": "item_property_column", "type": "int",      "source": "PropColumn",      "default": "-1"},
        {"name": "inventory_width",      "type": "int",      "source": "InvSlotWidth",    "default": "0"},
        {"name": "inventory_height",     "type": "int",      "source": "InvSlotHeight",   "default": "0"},
        {"name": "equipable_slots",      "type": "int",      "source": "EquipableSlots",  "default": "0"},
        {"name": "stack_size",           "type": "int",      "source": "Stacking",        "default": "1"},
        {"name": "is_container",         "type": "bool",     "source": "Container"}
      ]
    },
    {
      "name": "rules",
      "type": "BaseItemRules",
      "fields": [
        {"name": "base_cost",                              "type": "int",   "source": "BaseCost",                         "default": "0"},
        {"name": "cost_multiplier",                        "type": "float", "source": "ItemMultiplier",                   "default": "1.0"},
        {"name": "requirements",                           "type": "array!(RequirementQualifier)", "source": "@feat_requirements:ReqFeat0,ReqFeat1,ReqFeat2,ReqFeat3,ReqFeat4"},
        {"name": "base_ac",                                "type": "int",   "source": "BaseAC",                          "default": "0"},
        {"name": "damage_num",                             "type": "int",   "source": "NumDice",                         "default": "0"},
        {"name": "damage_die",                             "type": "int",   "source": "DieToRoll",                       "default": "0"},
        {"name": "crit_threat",                            "type": "int",   "source": "CritThreat",                      "default": "0"},
        {"name": "crit_multiplier",                        "type": "int",   "source": "CritHitMult",                     "default": "0"},
        {"name": "weapon_type",                            "type": "int",   "source": "WeaponType",                      "default": "0"},
        {"name": "ranged",                                 "type": "bool",  "source": "RangedWeapon"},
        {"name": "weapon_size",                            "type": "int",   "source": "WeaponSize",                      "default": "0"},
        {"name": "weapon_focus_feat",                      "type": "int",   "source": "WeaponFocusFeat",                 "default": "-1"},
        {"name": "epic_weapon_focus_feat",                 "type": "int",   "source": "EpicWeaponFocusFeat",             "default": "-1"},
        {"name": "weapon_specialization_feat",             "type": "int",   "source": "WeaponSpecializationFeat",        "default": "-1"},
        {"name": "epic_weapon_specialization_feat",        "type": "int",   "source": "EpicWeaponSpecializationFeat",    "default": "-1"},
        {"name": "weapon_improved_critical_feat",          "type": "int",   "source": "WeaponImprovedCriticalFeat",      "default": "-1"},
        {"name": "epic_weapon_overwhelming_critical_feat", "type": "int",   "source": "EpicWeaponOverwhelmingCriticalFeat", "default": "-1"},
        {"name": "epic_weapon_devastating_critical_feat",  "type": "int",   "source": "EpicWeaponDevastatingCriticalFeat",  "default": "-1"},
        {"name": "weapon_of_choice_feat",                  "type": "int",   "source": "WeaponOfChoiceFeat",              "default": "-1"}
      ]
    }
  ]
}
