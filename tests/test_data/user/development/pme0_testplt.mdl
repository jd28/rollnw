#MAXMODEL ASCII
newmodel pme0_testplt
setsupermodel pme0_testplt NULL
setanimationscale 1
#MAXGEOM ASCII
beginmodelgeom pme0_testplt
    node dummy pme0_testplt
        parent NULL
    endnode
    node trimesh mesh01
        parent pme0_testplt
        diffuse 1 1 1
        ambient 0 0 0
        specular 0 0 0
        shininess 4
        shadow 0
        beaming 0
        render 1
        transparencyhint 0
        alpha 1
        scale 1
        selfillumcolor 0 0 0
        verts 3
            0 0 0
            1 0 0
            0 1 0
        faces 1
            0 1 2 1 0 1 2 1
        tverts 3
            0 0 0
            1 0 0
            0 1 0
    endnode
endmodelgeom pme0_testplt
donemodel pme0_testplt
