// Generated from VERSION, source identity, and explicit release approval.
1 VERSIONINFO
FILEVERSION @version_major@,@version_minor@,@version_patch@,0
PRODUCTVERSION @version_major@,@version_minor@,@version_patch@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS @version_flags@
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "rollnw\0"
            VALUE "FileDescription", "@tool_name@\0"
            VALUE "FileVersion", "@tool_version@\0"
            VALUE "InternalName", "@tool_name@\0"
            VALUE "OriginalFilename", "@tool_name@.exe\0"
            VALUE "ProductName", "@tool_name@\0"
            VALUE "ProductVersion", "@tool_version@\0"
            VALUE "Comments", "revision=@revision@; state=@source_state@; release=@ROLLNW_RELEASE_TAG@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
